@@ -0,0 +1,185 @@
+//! OpenTelemetry GenAI vocabulary for model calls (docs/PLAN.md B1).
+//!
+//! Names are copied, not invented: the span-name rule
+//! `{gen_ai.operation.name} {target}` and the `gen_ai.*` attribute keys come
+//! from the OTel GenAI semantic conventions as vendored in
+//! `op6-refs/otel-semconv` @ 3e25804
+//! (`model/gen-ai/deprecated/registry-deprecated.yaml` +
+//! `spans-deprecated.yaml` — the conventions moved to the
+//! `semantic-conventions-genai` repo with the names unchanged).
+//!
+//! A model call is two journal events — span start and span end — sharing a
+//! `span_id` in the envelope, so the UI can draw the call's lifetime and the
+//! end event carries the token usage.
+
+use alloc::collections::BTreeMap;
+use alloc::string::String;
+use alloc::vec::Vec;
+use serde::{Deserialize, Serialize};
+
+/// `gen_ai.*` attribute keys, exactly as the spec spells them.
+pub mod keys {
+    pub const OPERATION: &str = "gen_ai.operation.name";
+    pub const PROVIDER: &str = "gen_ai.provider.name";
+    pub const REQUEST_MODEL: &str = "gen_ai.request.model";
+    pub const REQUEST_MAX_TOKENS: &str = "gen_ai.request.max_tokens";
+    pub const REQUEST_TEMPERATURE: &str = "gen_ai.request.temperature";
+    pub const REQUEST_STREAM: &str = "gen_ai.request.stream";
+    pub const RESPONSE_MODEL: &str = "gen_ai.response.model";
+    pub const RESPONSE_FINISH_REASONS: &str = "gen_ai.response.finish_reasons";
+    pub const RESPONSE_TIME_TO_FIRST_CHUNK: &str = "gen_ai.response.time_to_first_chunk";
+    pub const CONVERSATION_ID: &str = "gen_ai.conversation.id";
+    pub const AGENT_ID: &str = "gen_ai.agent.id";
+    pub const AGENT_NAME: &str = "gen_ai.agent.name";
+    pub const AGENT_DESCRIPTION: &str = "gen_ai.agent.description";
+    pub const TOOL_NAME: &str = "gen_ai.tool.name";
+    pub const TOOL_DESCRIPTION: &str = "gen_ai.tool.description";
+    pub const TOOL_CALL_ID: &str = "gen_ai.tool.call.id";
+    pub const TOOL_CALL_ARGUMENTS: &str = "gen_ai.tool.call.arguments";
+    pub const TOOL_CALL_RESULT: &str = "gen_ai.tool.call.result";
+    pub const TOOL_DEFINITIONS: &str = "gen_ai.tool.definitions";
+    pub const USAGE_INPUT_TOKENS: &str = "gen_ai.usage.input_tokens";
+    pub const USAGE_OUTPUT_TOKENS: &str = "gen_ai.usage.output_tokens";
+    pub const DATA_SOURCE_ID: &str = "gen_ai.data_source.id";
+    pub const INPUT_MESSAGES: &str = "gen_ai.input.messages";
+    pub const OUTPUT_MESSAGES: &str = "gen_ai.output.messages";
+    pub const SYSTEM_INSTRUCTIONS: &str = "gen_ai.system_instructions";
+    pub const OUTPUT_TYPE: &str = "gen_ai.output.type";
+}
+
+/// The `gen_ai.operation.name` enum (all nine spec values).
+#[derive(Clone, Copy, Debug, PartialEq, Eq, Serialize, Deserialize)]
+#[serde(rename_all = "snake_case")]
+pub enum GenAiOperation {
+    Chat,
+    GenerateContent,
+    TextCompletion,
+    Embeddings,
+    Retrieval,
+    CreateAgent,
+    InvokeAgent,
+    ExecuteTool,
+    InvokeWorkflow,
+}
+
+impl GenAiOperation {
+    pub fn as_str(self) -> &'static str {
+        match self {
+            GenAiOperation::Chat => "chat",
+            GenAiOperation::GenerateContent => "generate_content",
+            GenAiOperation::TextCompletion => "text_completion",
+            GenAiOperation::Embeddings => "embeddings",
+            GenAiOperation::Retrieval => "retrieval",
+            GenAiOperation::CreateAgent => "create_agent",
+            GenAiOperation::InvokeAgent => "invoke_agent",
+            GenAiOperation::ExecuteTool => "execute_tool",
+            GenAiOperation::InvokeWorkflow => "invoke_workflow",
+        }
+    }
+
+    /// Spec span name: `{gen_ai.operation.name} {target}`. The target is the
+    /// request model (chat / text_completion / generate_content / embeddings),
+    /// the tool name (execute_tool), the agent name (create_agent /
+    /// invoke_agent / invoke_workflow) or the data-source id (retrieval).
+    pub fn span_name(self, target: &str) -> String {
+        alloc::format!("{} {}", self.as_str(), target)
+    }
+
+    pub fn parse(s: &str) -> Option<GenAiOperation> {
+        match s {
+            "chat" => Some(GenAiOperation::Chat),
+            "generate_content" => Some(GenAiOperation::GenerateContent),
+            "text_completion" => Some(GenAiOperation::TextCompletion),
+            "embeddings" => Some(GenAiOperation::Embeddings),
+            "retrieval" => Some(GenAiOperation::Retrieval),
+            "create_agent" => Some(GenAiOperation::CreateAgent),
+            "invoke_agent" => Some(GenAiOperation::InvokeAgent),
+            "execute_tool" => Some(GenAiOperation::ExecuteTool),
+            "invoke_workflow" => Some(GenAiOperation::InvokeWorkflow),
+            _ => None,
+        }
+    }
+}
+
+/// Span attributes. `BTreeMap` so the JSON is deterministic (workbench
+/// evidence and tests must be byte-stable).
+pub type AttrMap = BTreeMap<String, AttrValue>;
+
+/// OTel attribute value, untagged in JSON (string/number/bool/array of
+/// strings — the types the GenAI conventions actually use).
+#[derive(Clone, Debug, PartialEq, Serialize, Deserialize)]
+#[serde(untagged)]
+pub enum AttrValue {
+    Str(String),
+    I64(i64),
+    F64(f64),
+    Bool(bool),
+    Strs(Vec<String>),
+}
+
+impl From<&str> for AttrValue {
+    fn from(v: &str) -> Self {
+        AttrValue::Str(v.into())
+    }
+}
+impl From<String> for AttrValue {
+    fn from(v: String) -> Self {
+        AttrValue::Str(v)
+    }
+}
+impl From<i64> for AttrValue {
+    fn from(v: i64) -> Self {
+        AttrValue::I64(v)
+    }
+}
+impl From<f64> for AttrValue {
+    fn from(v: f64) -> Self {
+        AttrValue::F64(v)
+    }
+}
+impl From<bool> for AttrValue {
+    fn from(v: bool) -> Self {
+        AttrValue::Bool(v)
+    }
+}
+impl From<Vec<String>> for AttrValue {
+    fn from(v: Vec<String>) -> Self {
+        AttrValue::Strs(v)
+    }
+}
+
+#[derive(Clone, Copy, Debug, PartialEq, Eq, Serialize, Deserialize)]
+#[serde(rename_all = "snake_case")]
+pub enum SpanStatus {
+    Ok,
+    Error,
+}
+
+/// A model/tool/agent span as two journal events.
+#[derive(Clone, Debug, PartialEq, Serialize, Deserialize)]
+#[serde(tag = "event", rename_all = "snake_case")]
+pub enum GenAiEvent {
+    SpanStart {
+        name: String,
+        #[serde(default)]
+        attributes: AttrMap,
+    },
+    SpanEnd {
+        name: String,
+        status: SpanStatus,
+        #[serde(default)]
+        attributes: AttrMap,
+    },
+}
+
+impl GenAiEvent {
+    /// Span start with the spec-shaped name `{operation} {target}`.
+    pub fn span_start(op: GenAiOperation, target: &str, attributes: AttrMap) -> GenAiEvent {
+        GenAiEvent::SpanStart { name: op.span_name(target), attributes }
+    }
+
+    /// Span end; pair it with the start via the envelope's `span_id`.
+    pub fn span_end(op: GenAiOperation, target: &str, status: SpanStatus, attributes: AttrMap) -> GenAiEvent {
+        GenAiEvent::SpanEnd { name: op.span_name(target), status, attributes }
+    }
+}
diff --git a/traced/vendor/trace-events/src/jsonl.rs b/traced/vendor/trace-events/src/jsonl.rs
new file mode 100644
index 00000000..0a39dd5c
--- /dev/null
+++ b/traced/vendor/trace-events/src/jsonl.rs
@@ -0,0 +1,42 @@
+//! JSONL transport: one JSON object per journal line.
+//!
+//! Same line shape as the `mmio-replay` traces (one flat object per line), so
+//! the same tailing tools work on both. This is what the `trace:` scheme
+//! serves and what `docs/workbench/` evidence files store.
+
+use alloc::string::String;
+use alloc::vec::Vec;
+
+use crate::envelope::Event;
+
+/// Serialize one event to a single JSON line (no trailing newline).
+pub fn to_json_line(event: &Event) -> Result<String, serde_json::Error> {
+    serde_json::to_string(event)
+}
+
+/// Parse one JSON line back into an event.
+pub fn from_json_line(line: &str) -> Result<Event, serde_json::Error> {
+    serde_json::from_str(line)
+}
+
+/// Serialize events to JSONL: each line newline-terminated.
+pub fn to_jsonl(events: &[Event]) -> Result<String, serde_json::Error> {
+    let mut out = String::new();
+    for ev in events {
+        out.push_str(&to_json_line(ev)?);
+        out.push('\n');
+    }
+    Ok(out)
+}
+
+/// Parse JSONL text (blank lines skipped) back into events.
+pub fn from_jsonl(text: &str) -> Result<Vec<Event>, serde_json::Error> {
+    let mut out = Vec::new();
+    for line in text.lines() {
+        if line.trim().is_empty() {
+            continue;
+        }
+        out.push(from_json_line(line)?);
+    }
+    Ok(out)
+}
diff --git a/traced/vendor/trace-events/src/lib.rs b/traced/vendor/trace-events/src/lib.rs
new file mode 100644
index 00000000..b66292d2
--- /dev/null
+++ b/traced/vendor/trace-events/src/lib.rs
@@ -0,0 +1,53 @@
+//! `trace-events` — the open-kimono event journal schema for
+//! Redox-on-OnePlus-6 (task C2, docs/PLAN.md B1).
+//!
+//! Every interesting thing the phone does is one journal record: mic frame
+//! levels, live transcripts, cleaned text, model spans, tool calls, grants,
+//! service starts/stops, power changes. The schema is copied, not invented
+//! (PLAN Part B rule):
+//!
+//! - **`gen_ai`** payloads follow the OpenTelemetry GenAI semantic
+//!   conventions: span names `{gen_ai.operation.name} {target}` and the
+//!   `gen_ai.*` attribute keys (`op6-refs/otel-semconv`, Apache-2.0).
+//! - **`ag_ui`** payloads follow the AG-UI protocol event vocabulary:
+//!   `{"type":"TEXT_MESSAGE_START",...}` with camelCase fields
+//!   (`op6-refs/ag-ui` spec/1.0, MIT).
+//! - **`op6`** payloads are our own mic/STT/power/service/grant/hand-off
+//!   events, each carrying its reason (VISION §3–§5).
+//!
+//! The journal itself is an [`EventRing`]: fixed capacity, monotonic `seq`,
+//! explicit `dropped` counter, tailable with `since`. Transport is JSONL —
+//! one [`Event`] per line — the shape the `trace:` scheme serves to the UI.
+//!
+//! ```
+//! use trace_events::{EventRing, Op6Event, Payload, to_jsonl, from_jsonl};
+//!
+//! let mut journal = EventRing::new(1024);
+//! journal.push(1_730_000_000_000_000, Payload::Op6(Op6Event::MicStarted { device: None }));
+//! journal.push(1_730_000_000_100_000, Payload::Op6(Op6Event::MicFrame { level: 0.25 }));
+//! let text = to_jsonl(&journal.snapshot()).unwrap();
+//! let back = from_jsonl(&text).unwrap();
+//! assert_eq!(back.len(), 2);
+//! ```
+
+#![no_std]
+#![forbid(unsafe_code)]
+
+extern crate alloc;
+
+mod agui;
+mod envelope;
+mod genai;
+mod jsonl;
+mod op6;
+mod ring;
+
+pub use agui::{
+    AgUiEvent, EncryptedValueSubtype, EventType, Interrupt, RunFinishedOutcome, SubagentFinishedOutcome,
+    TextMessageRole, TokenUsage,
+};
+pub use envelope::{Event, Payload, SpanId, TraceId, SCHEMA_VERSION};
+pub use genai::{keys as genai_keys, AttrMap, AttrValue, GenAiEvent, GenAiOperation, SpanStatus};
+pub use jsonl::{from_json_line, from_jsonl, to_json_line, to_jsonl};
+pub use op6::{HandoffStatus, Op6Event, PowerState};
+pub use ring::EventRing;
diff --git a/traced/vendor/trace-events/src/op6.rs b/traced/vendor/trace-events/src/op6.rs
new file mode 100644
index 00000000..3db1890a
--- /dev/null
+++ b/traced/vendor/trace-events/src/op6.rs
@@ -0,0 +1,120 @@
+//! Our own event vocabulary: what the phone itself does — mic, STT, power,
+//! services, grants, hand-offs. Every event carries the *reason* where a
+//! reason exists: the open kimono (VISION §3–§5) means the UI can show not
+//! just that something happened but why it happened.
+
+use alloc::string::String;
+use serde::{Deserialize, Serialize};
+
+/// Mic / STT / power / service / grant / hand-off events. Tagged by `type`
+/// (snake_case) inside the journal envelope's `"kind":"op6"` payload.
+#[derive(Clone, Debug, PartialEq, Serialize, Deserialize)]
+#[serde(tag = "type", rename_all = "snake_case")]
+pub enum Op6Event {
+    /// Journal retention or a slow reader skipped records.
+    JournalDropped { count: u64, reason: String },
+    // — Mic: the user always sees whether the mic is live (VISION §3, B10) —
+    /// Capture opened on a device.
+    MicStarted {
+        #[serde(default, skip_serializing_if = "Option::is_none")]
+        device: Option<String>,
+    },
+    /// Capture closed — `reason` is mandatory: closing is never silent.
+    MicStopped {
+        reason: String,
+    },
+    /// One capture frame's level meter (drives the waveform UI).
+    MicFrame {
+        level: f32,
+    },
+
+    // — STT: live transcript, then final, then the cleaned text (B1/B2) —
+    SttPartial {
+        engine: String,
+        text: String,
+        #[serde(default, skip_serializing_if = "Option::is_none")]
+        confidence: Option<f32>,
+    },
+    SttFinal {
+        engine: String,
+        text: String,
+        #[serde(default, skip_serializing_if = "Option::is_none")]
+        confidence: Option<f32>,
+        #[serde(default, skip_serializing_if = "Option::is_none")]
+        latency_us: Option<u64>,
+    },
+    /// Raw transcript → post-cleaned text (disambiguation, filler removal).
+    TextCleaned {
+        raw: String,
+        cleaned: String,
+    },
+
+    // — Power: the system says what it switched and why (VISION §4, B10) —
+    PowerChange {
+        component: String,
+        state: PowerState,
+        reason: String,
+    },
+    /// A wake lock with an expiry the UI can show (expiring wake locks).
+    WakeLockAcquired {
+        holder: String,
+        #[serde(default, skip_serializing_if = "Option::is_none")]
+        deadline_us: Option<u64>,
+        #[serde(default, skip_serializing_if = "Option::is_none")]
+        max_us: Option<u64>,
+    },
+    WakeLockReleased {
+        holder: String,
+        #[serde(default, skip_serializing_if = "Option::is_none")]
+        reason: Option<String>,
+    },
+
+    // — Services: Lego blocks starting/stopping, with generations (B8) —
+    ServiceStarted {
+        service: String,
+        generation: u64,
+        reason: String,
+    },
+    ServiceStopped {
+        service: String,
+        generation: u64,
+        reason: String,
+    },
+
+    // — Capability grants: grants are journal events too (B1, B6) —
+    GrantGranted {
+        service: String,
+        capability: String,
+        #[serde(default, skip_serializing_if = "Option::is_none")]
+        scope: Option<String>,
+        #[serde(default, skip_serializing_if = "Option::is_none")]
+        expires_us: Option<u64>,
+    },
+    GrantRevoked {
+        service: String,
+        capability: String,
+        reason: String,
+    },
+
+    // — Hand-offs: homelab/cloud work is announced and visible (VISION §5) —
+    Handoff {
+        destination: String,
+        reason: String,
+        status: HandoffStatus,
+    },
+}
+
+#[derive(Clone, Copy, Debug, PartialEq, Eq, Serialize, Deserialize)]
+#[serde(rename_all = "snake_case")]
+pub enum PowerState {
+    On,
+    Off,
+}
+
+#[derive(Clone, Copy, Debug, PartialEq, Eq, Serialize, Deserialize)]
+#[serde(rename_all = "snake_case")]
+pub enum HandoffStatus {
+    Started,
+    Completed,
+    Failed,
+}
