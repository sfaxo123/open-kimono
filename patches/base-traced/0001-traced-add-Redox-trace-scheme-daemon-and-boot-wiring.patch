new file mode 100644
index 00000000..4463b4e7
--- /dev/null
+++ b/traced/src/main.rs
@@ -0,0 +1,16 @@
+use redox_scheme::Socket;
+use scheme_utils::Blocking;
+use crate::scheme::TraceScheme;
+
+mod scheme;
+
+fn main() { daemon::SchemeDaemon::new(daemon); }
+
+fn daemon(daemon: daemon::SchemeDaemon) -> ! {
+    let socket = Socket::create().expect("traced: failed to create trace scheme");
+    let mut scheme = TraceScheme::new();
+    let handler = Blocking::new(Box::new(socket), 16);
+    let _ = daemon.ready_sync_scheme(handler.socket(), &mut scheme);
+    libredox::call::setrens(0, 0).expect("traced: failed to enter null namespace");
+    handler.process_requests_blocking(scheme).expect("traced: request loop failed");
+}
diff --git a/traced/src/scheme.rs b/traced/src/scheme.rs
new file mode 100644
index 00000000..75bc1fe8
--- /dev/null
+++ b/traced/src/scheme.rs
@@ -0,0 +1,102 @@
+use std::collections::HashMap;
+use std::time::{SystemTime, UNIX_EPOCH};
+use redox_scheme::scheme::SchemeSync;
+use redox_scheme::{CallerCtx, OpenResult};
+use scheme_utils::FpathWriter;
+use syscall::error::*;
+use syscall::schemev2::NewFdFlags;
+use syscall::MODE_CHR;
+use tracejournal::{Filter, Journal, Subscription, MAX_LINE_BYTES};
+
+enum Handle {
+    Producer(Vec<u8>),
+    Subscriber { sub: Subscription, pending: Vec<u8> },
+}
+
+pub struct TraceScheme {
+    journal: Journal,
+    handles: HashMap<usize, Handle>,
+    next_handle: usize,
+}
+
+impl TraceScheme {
+    pub fn new() -> Self {
+        Self { journal: Journal::new(256, 100), handles: HashMap::new(), next_handle: 2 }
+    }
+}
+
+fn now_us() -> u64 {
+    SystemTime::now().duration_since(UNIX_EPOCH).unwrap_or_default().as_micros() as u64
+}
+
+const ROOT: usize = 1;
+
+impl SchemeSync for TraceScheme {
+    fn scheme_root(&mut self) -> Result<usize> { Ok(ROOT) }
+
+    fn openat(&mut self, dirfd: usize, path: &str, _flags: usize,
+              _fcntl_flags: u32, _ctx: &CallerCtx) -> Result<OpenResult> {
+        if dirfd != ROOT { return Err(Error::new(EACCES)); }
+        let handle = if path == "publish" {
+            Handle::Producer(Vec::new())
+        } else if path == "subscribe" {
+            Handle::Subscriber { sub: self.journal.subscribe(0, Filter::default()), pending: Vec::new() }
+        } else if let Some(query) = path.strip_prefix("subscribe/") {
+            let filter: Filter = serde_json::from_str(query).map_err(|_| Error::new(EINVAL))?;
+            Handle::Subscriber { sub: self.journal.subscribe(256, filter), pending: Vec::new() }
+        } else { return Err(Error::new(ENOENT)); };
+        if self.handles.len() >= 32 { return Err(Error::new(EMFILE)); }
+        let id = self.next_handle;
+        self.next_handle += 1;
+        self.handles.insert(id, handle);
+        Ok(OpenResult::ThisScheme { number: id, flags: NewFdFlags::empty() })
+    }
+
+    fn write(&mut self, id: usize, buf: &[u8], _offset: u64, _flags: u32, _ctx: &CallerCtx) -> Result<usize> {
+        let Handle::Producer(partial) = self.handles.get_mut(&id).ok_or(Error::new(EBADF))? else {
+            return Err(Error::new(EBADF));
+        };
+        if partial.len() + buf.len() > MAX_LINE_BYTES + 1 { return Err(Error::new(E2BIG)); }
+        partial.extend_from_slice(buf);
+        while let Some(end) = partial.iter().position(|byte| *byte == b'\n') {
+            let line: Vec<_> = partial.drain(..=end).collect();
+            let line = std::str::from_utf8(&line).map_err(|_| Error::new(EINVAL))?;
+            let event = trace_events::from_json_line(line).map_err(|_| Error::new(EINVAL))?;
+            self.journal.publish(event, now_us()).map_err(|_| Error::new(EAGAIN))?;
+        }
+        Ok(buf.len())
+    }
+
+    fn read(&mut self, id: usize, buf: &mut [u8], _offset: u64, _flags: u32, _ctx: &CallerCtx) -> Result<usize> {
+        if buf.is_empty() { return Ok(0); }
+        let Handle::Subscriber { sub, pending } = self.handles.get_mut(&id).ok_or(Error::new(EBADF))? else {
+            return Err(Error::new(EBADF));
+        };
+        if pending.is_empty() {
+            for event in self.journal.poll(sub, 1) {
+                let line = trace_events::to_json_line(&event).map_err(|_| Error::new(EIO))?;
+                pending.extend_from_slice(line.as_bytes());
+                pending.push(b'\n');
+            }
+        }
+        if pending.is_empty() { return Err(Error::new(EAGAIN)); }
+        let n = buf.len().min(pending.len());
+        buf[..n].copy_from_slice(&pending[..n]);
+        pending.drain(..n);
+        Ok(n)
+    }
+
+    fn fpath(&mut self, _id: usize, buf: &mut [u8], _ctx: &CallerCtx) -> Result<usize> {
+        FpathWriter::with(buf, "trace", |_| Ok(()))
+    }
+
+    fn fstat(&mut self, _id: usize, stat: &mut syscall::Stat, _ctx: &CallerCtx) -> Result<()> {
+        stat.st_mode = 0o666 | MODE_CHR;
+        stat.st_size = 0;
+        stat.st_blksize = 4096;
+        stat.st_nlink = 1;
+        Ok(())
+    }
+
+    fn on_close(&mut self, id: usize) { self.handles.remove(&id); }
+}
