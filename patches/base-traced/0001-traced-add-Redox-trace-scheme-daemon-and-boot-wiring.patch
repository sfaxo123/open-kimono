diff --git a/traced/vendor/trace-events/src/agui.rs b/traced/vendor/trace-events/src/agui.rs
new file mode 100644
index 00000000..7bfe95e7
--- /dev/null
+++ b/traced/vendor/trace-events/src/agui.rs
@@ -0,0 +1,398 @@
+//! AG-UI (Agent User Interaction Protocol) event vocabulary — the agent↔UI
+//! half of the journal (docs/PLAN.md B1).
+//!
+//! The vocabulary is copied from the AG-UI 1.0 spec vendored at
+//! `op6-refs/ag-ui` @ 73b04fd (`spec/1.0/schema.json`, MIT): every event
+//! carries `"type"` with a SCREAMING_SNAKE discriminator and camelCase
+//! fields, so an AG-UI consumer can read our journal lines unmodified.
+//! Required-vs-optional fields follow the spec's `required` lists.
+
+use alloc::string::String;
+use alloc::vec::Vec;
+use serde::{Deserialize, Serialize};
+use serde_json::Value;
+
+/// The discriminator vocabulary — all 31 `EventType` values from
+/// `spec/1.0/schema.json`.
+#[derive(Clone, Copy, Debug, PartialEq, Eq, Serialize, Deserialize)]
+#[serde(rename_all = "SCREAMING_SNAKE_CASE")]
+pub enum EventType {
+    TextMessageStart,
+    TextMessageContent,
+    TextMessageEnd,
+    TextMessageChunk,
+    ToolCallStart,
+    ToolCallArgs,
+    ToolCallEnd,
+    ToolCallChunk,
+    ToolCallResult,
+    StateSnapshot,
+    StateDelta,
+    MessagesSnapshot,
+    ActivitySnapshot,
+    ActivityDelta,
+    Raw,
+    Custom,
+    RunStarted,
+    RunFinished,
+    RunError,
+    StepStarted,
+    StepFinished,
+    ReasoningStart,
+    ReasoningMessageStart,
+    ReasoningMessageContent,
+    ReasoningMessageEnd,
+    ReasoningMessageChunk,
+    ReasoningEnd,
+    ReasoningEncryptedValue,
+    SubagentStarted,
+    SubagentFinished,
+    SubagentError,
+}
+
+/// `TextMessageRole` from the spec.
+#[derive(Clone, Copy, Debug, PartialEq, Eq, Serialize, Deserialize)]
+#[serde(rename_all = "lowercase")]
+pub enum TextMessageRole {
+    Developer,
+    System,
+    Assistant,
+    User,
+}
+
+/// `ReasoningEncryptedValueSubtype` from the spec (note the hyphen).
+#[derive(Clone, Copy, Debug, PartialEq, Eq, Serialize, Deserialize)]
+#[serde(rename_all = "kebab-case")]
+pub enum EncryptedValueSubtype {
+    ToolCall,
+    Message,
+}
+
+/// `RunFinishedOutcome` (oneOf success / interrupt / cancelled).
+#[derive(Clone, Debug, PartialEq, Serialize, Deserialize)]
+#[serde(tag = "type", rename_all = "lowercase")]
+pub enum RunFinishedOutcome {
+    Success {
+        #[serde(default, rename = "pendingToolCallIds")]
+        pending_tool_call_ids: Vec<String>,
+    },
+    Interrupt {
+        interrupts: Vec<Interrupt>,
+    },
+    Cancelled,
+}
+
+/// `Interrupt` — only `id` and `reason` are required by the spec.
+#[derive(Clone, Debug, PartialEq, Serialize, Deserialize)]
+#[serde(rename_all = "camelCase")]
+pub struct Interrupt {
+    pub id: String,
+    pub reason: String,
+    #[serde(default, skip_serializing_if = "Option::is_none")]
+    pub message: Option<String>,
+    #[serde(default, skip_serializing_if = "Option::is_none")]
+    pub tool_call_id: Option<String>,
+    #[serde(default, skip_serializing_if = "Option::is_none")]
+    pub response_schema: Option<Value>,
+    #[serde(default, skip_serializing_if = "Option::is_none")]
+    pub expires_at: Option<String>,
+    #[serde(default, skip_serializing_if = "Option::is_none")]
+    pub metadata: Option<Value>,
+}
+
+/// `SubagentFinishedOutcome` (success / suspended).
+#[derive(Clone, Debug, PartialEq, Serialize, Deserialize)]
+#[serde(tag = "type", rename_all = "lowercase")]
+pub enum SubagentFinishedOutcome {
+    Success,
+    Suspended {
+        #[serde(default, rename = "interruptIds")]
+        interrupt_ids: Vec<String>,
+    },
+}
+
+/// `TokenUsage` — every field optional in the spec.
+#[derive(Clone, Debug, Default, PartialEq, Eq, Serialize, Deserialize)]
+#[serde(rename_all = "camelCase")]
+pub struct TokenUsage {
+    #[serde(default, skip_serializing_if = "Option::is_none")]
+    pub provider: Option<String>,
+    #[serde(default, skip_serializing_if = "Option::is_none")]
+    pub model: Option<String>,
+    #[serde(default, skip_serializing_if = "Option::is_none")]
+    pub input_tokens: Option<u64>,
+    #[serde(default, skip_serializing_if = "Option::is_none")]
+    pub output_tokens: Option<u64>,
+    #[serde(default, skip_serializing_if = "Option::is_none")]
+    pub total_tokens: Option<u64>,
+    #[serde(default, skip_serializing_if = "Option::is_none")]
+    pub reasoning_tokens: Option<u64>,
+    #[serde(default, skip_serializing_if = "Option::is_none")]
+    pub cached_input_tokens: Option<u64>,
+    #[serde(default, skip_serializing_if = "Option::is_none")]
+    pub cache_write_input_tokens: Option<u64>,
+}
+
+/// One AG-UI protocol event, exactly as the spec serializes it: internally
+/// tagged by `"type"`, camelCase fields. Arbitrary JSON (state snapshots,
+/// JSON-Patch deltas, tool results, raw events) passes through as
+/// [`serde_json::Value`] so nothing protocol-shaped is invented here.
+///
+/// Note: an explicit JSON `null` in an optional field reads back as `None`
+/// (serde's `Option` semantics) — absent and null are equivalent here.
+#[derive(Clone, Debug, PartialEq, Serialize, Deserialize)]
+#[serde(tag = "type", rename_all = "SCREAMING_SNAKE_CASE")]
+pub enum AgUiEvent {
+    // — text messages —
+    TextMessageStart {
+        #[serde(rename = "messageId")]
+        message_id: String,
+        #[serde(default, skip_serializing_if = "Option::is_none")]
+        role: Option<TextMessageRole>,
+        #[serde(default, skip_serializing_if = "Option::is_none")]
+        name: Option<String>,
+    },
+    TextMessageContent {
+        #[serde(rename = "messageId")]
+        message_id: String,
+        delta: String,
+    },
+    TextMessageEnd {
+        #[serde(rename = "messageId")]
+        message_id: String,
+    },
+    TextMessageChunk {
+        #[serde(rename = "messageId")]
+        message_id: String,
+        #[serde(default, skip_serializing_if = "Option::is_none")]
+        role: Option<TextMessageRole>,
+        #[serde(default, skip_serializing_if = "Option::is_none")]
+        name: Option<String>,
+        #[serde(default, skip_serializing_if = "Option::is_none")]
+        delta: Option<String>,
+    },
+
+    // — tool calls —
+    ToolCallStart {
+        #[serde(rename = "toolCallId")]
+        tool_call_id: String,
+        #[serde(rename = "toolCallName")]
+        tool_call_name: String,
+        #[serde(default, rename = "parentMessageId", skip_serializing_if = "Option::is_none")]
+        parent_message_id: Option<String>,
+    },
+    ToolCallArgs {
+        #[serde(rename = "toolCallId")]
+        tool_call_id: String,
+        delta: String,
+    },
+    ToolCallEnd {
+        #[serde(rename = "toolCallId")]
+        tool_call_id: String,
+    },
+    ToolCallChunk {
+        #[serde(default, rename = "toolCallId", skip_serializing_if = "Option::is_none")]
+        tool_call_id: Option<String>,
+        #[serde(default, rename = "toolCallName", skip_serializing_if = "Option::is_none")]
+        tool_call_name: Option<String>,
+        #[serde(default, rename = "parentMessageId", skip_serializing_if = "Option::is_none")]
+        parent_message_id: Option<String>,
+        #[serde(default, skip_serializing_if = "Option::is_none")]
+        delta: Option<String>,
+    },
+    ToolCallResult {
+        #[serde(rename = "messageId")]
+        message_id: String,
+        #[serde(rename = "toolCallId")]
+        tool_call_id: String,
+        content: Value,
+        #[serde(default, skip_serializing_if = "Option::is_none")]
+        role: Option<String>,
+    },
+
+    // — shared state —
+    StateSnapshot {
+        snapshot: Value,
+    },
+    StateDelta {
+        /// JSON Patch (RFC 6902) array.
+        delta: Value,
+    },
+    MessagesSnapshot {
+        messages: Value,
+    },
+    ActivitySnapshot {
+        #[serde(rename = "messageId")]
+        message_id: String,
+        #[serde(rename = "activityType")]
+        activity_type: String,
+        content: Value,
+        #[serde(default, skip_serializing_if = "Option::is_none")]
+        replace: Option<bool>,
+    },
+    ActivityDelta {
+        #[serde(rename = "messageId")]
+        message_id: String,
+        #[serde(rename = "activityType")]
+        activity_type: String,
+        patch: Value,
+    },
+
+    // — escape hatches —
+    Raw {
+        event: Value,
+        #[serde(default, skip_serializing_if = "Option::is_none")]
+        source: Option<String>,
+    },
+    Custom {
+        name: String,
+        value: Value,
+    },
+
+    // — runs and steps —
+    RunStarted {
+        #[serde(rename = "threadId")]
+        thread_id: String,
+        #[serde(rename = "runId")]
+        run_id: String,
+        #[serde(default, rename = "protocolVersion", skip_serializing_if = "Option::is_none")]
+        protocol_version: Option<String>,
+        #[serde(default, rename = "parentRunId", skip_serializing_if = "Option::is_none")]
+        parent_run_id: Option<String>,
+        #[serde(default, skip_serializing_if = "Option::is_none")]
+        input: Option<Value>,
+    },
+    RunFinished {
+        #[serde(rename = "threadId")]
+        thread_id: String,
+        #[serde(rename = "runId")]
+        run_id: String,
+        #[serde(default, skip_serializing_if = "Option::is_none")]
+        result: Option<Value>,
+        #[serde(default, skip_serializing_if = "Option::is_none")]
+        outcome: Option<RunFinishedOutcome>,
+        #[serde(default, skip_serializing_if = "Vec::is_empty")]
+        usage: Vec<TokenUsage>,
+    },
+    RunError {
+        message: String,
+        #[serde(default, skip_serializing_if = "Option::is_none")]
+        code: Option<String>,
+        #[serde(default, skip_serializing_if = "Vec::is_empty")]
+        usage: Vec<TokenUsage>,
+    },
+    StepStarted {
+        #[serde(rename = "stepName")]
+        step_name: String,
+    },
+    StepFinished {
+        #[serde(rename = "stepName")]
+        step_name: String,
+    },
+
+    // — reasoning (the open kimono's favourite events) —
+    ReasoningStart {
+        #[serde(rename = "messageId")]
+        message_id: String,
+    },
+    ReasoningMessageStart {
+        #[serde(rename = "messageId")]
+        message_id: String,
+        role: String,
+    },
+    ReasoningMessageContent {
+        #[serde(rename = "messageId")]
+        message_id: String,
+        delta: String,
+    },
+    ReasoningMessageEnd {
+        #[serde(rename = "messageId")]
+        message_id: String,
+    },
+    ReasoningMessageChunk {
+        #[serde(rename = "messageId")]
+        message_id: String,
+        #[serde(default, skip_serializing_if = "Option::is_none")]
+        delta: Option<String>,
+    },
+    ReasoningEnd {
+        #[serde(rename = "messageId")]
+        message_id: String,
+    },
+    ReasoningEncryptedValue {
+        subtype: EncryptedValueSubtype,
+        #[serde(rename = "entityId")]
+        entity_id: String,
+        #[serde(rename = "encryptedValue")]
+        encrypted_value: String,
+    },
+
+    // — subagents —
+    SubagentStarted {
+        #[serde(rename = "subagentRunId")]
+        subagent_run_id: String,
+        name: String,
+        #[serde(default, skip_serializing_if = "Option::is_none")]
+        description: Option<String>,
+        #[serde(default, rename = "parentSubagentRunId", skip_serializing_if = "Option::is_none")]
+        parent_subagent_run_id: Option<String>,
+        #[serde(default, rename = "parentToolCallId", skip_serializing_if = "Option::is_none")]
+        parent_tool_call_id: Option<String>,
+        #[serde(default, rename = "parentMessageId", skip_serializing_if = "Option::is_none")]
+        parent_message_id: Option<String>,
+    },
+    SubagentFinished {
+        #[serde(rename = "subagentRunId")]
+        subagent_run_id: String,
+        #[serde(default, skip_serializing_if = "Option::is_none")]
+        result: Option<Value>,
+        #[serde(default, skip_serializing_if = "Option::is_none")]
+        outcome: Option<SubagentFinishedOutcome>,
+    },
+    SubagentError {
+        #[serde(rename = "subagentRunId")]
+        subagent_run_id: String,
+        message: String,
+        #[serde(default, skip_serializing_if = "Option::is_none")]
+        code: Option<String>,
+    },
+}
+
+impl AgUiEvent {
+    /// The spec `EventType` discriminator for this event.
+    pub fn event_type(&self) -> EventType {
+        match self {
+            AgUiEvent::TextMessageStart { .. } => EventType::TextMessageStart,
+            AgUiEvent::TextMessageContent { .. } => EventType::TextMessageContent,
+            AgUiEvent::TextMessageEnd { .. } => EventType::TextMessageEnd,
+            AgUiEvent::TextMessageChunk { .. } => EventType::TextMessageChunk,
+            AgUiEvent::ToolCallStart { .. } => EventType::ToolCallStart,
+            AgUiEvent::ToolCallArgs { .. } => EventType::ToolCallArgs,
+            AgUiEvent::ToolCallEnd { .. } => EventType::ToolCallEnd,
+            AgUiEvent::ToolCallChunk { .. } => EventType::ToolCallChunk,
+            AgUiEvent::ToolCallResult { .. } => EventType::ToolCallResult,
+            AgUiEvent::StateSnapshot { .. } => EventType::StateSnapshot,
+            AgUiEvent::StateDelta { .. } => EventType::StateDelta,
+            AgUiEvent::MessagesSnapshot { .. } => EventType::MessagesSnapshot,
+            AgUiEvent::ActivitySnapshot { .. } => EventType::ActivitySnapshot,
+            AgUiEvent::ActivityDelta { .. } => EventType::ActivityDelta,
+            AgUiEvent::Raw { .. } => EventType::Raw,
+            AgUiEvent::Custom { .. } => EventType::Custom,
+            AgUiEvent::RunStarted { .. } => EventType::RunStarted,
+            AgUiEvent::RunFinished { .. } => EventType::RunFinished,
+            AgUiEvent::RunError { .. } => EventType::RunError,
+            AgUiEvent::StepStarted { .. } => EventType::StepStarted,
+            AgUiEvent::StepFinished { .. } => EventType::StepFinished,
+            AgUiEvent::ReasoningStart { .. } => EventType::ReasoningStart,
+            AgUiEvent::ReasoningMessageStart { .. } => EventType::ReasoningMessageStart,
+            AgUiEvent::ReasoningMessageContent { .. } => EventType::ReasoningMessageContent,
+            AgUiEvent::ReasoningMessageEnd { .. } => EventType::ReasoningMessageEnd,
+            AgUiEvent::ReasoningMessageChunk { .. } => EventType::ReasoningMessageChunk,
+            AgUiEvent::ReasoningEnd { .. } => EventType::ReasoningEnd,
+            AgUiEvent::ReasoningEncryptedValue { .. } => EventType::ReasoningEncryptedValue,
+            AgUiEvent::SubagentStarted { .. } => EventType::SubagentStarted,
+            AgUiEvent::SubagentFinished { .. } => EventType::SubagentFinished,
+            AgUiEvent::SubagentError { .. } => EventType::SubagentError,
+        }
+    }
+}
diff --git a/traced/vendor/trace-events/src/envelope.rs b/traced/vendor/trace-events/src/envelope.rs
new file mode 100644
index 00000000..049cacef
--- /dev/null
+++ b/traced/vendor/trace-events/src/envelope.rs
@@ -0,0 +1,142 @@
+//! The journal envelope every `trace:` scheme line carries.
+//!
+//! One flat record per event: a monotonic `seq` (assigned by [`crate::EventRing`]),
+//! a wall-clock `ts_us` in microseconds since the Unix epoch, optional W3C-style
+//! trace/span ids for correlation (OTel-shaped), and the [`Payload`] tag that
+//! routes to the three vocabularies: `gen_ai` (OTel GenAI spans), `ag_ui`
+//! (AG-UI protocol events) and `op6` (our mic/STT/power/service events).
+
+use alloc::string::String;
+use serde::de::{Deserializer, Visitor};
+use serde::{Deserialize, Serialize, Serializer};
+
+/// Version of this event schema. Bump on any breaking JSON change.
+pub const SCHEMA_VERSION: u32 = 1;
+
+/// W3C trace id (PLAN B1 / OTel-shaped correlation). Serialized as exactly 32
+/// lowercase hex characters, like every other W3C/OTel tooling.
+#[derive(Clone, Copy, Debug, Default, PartialEq, Eq, PartialOrd, Ord, Hash)]
+pub struct TraceId(pub u128);
+
+impl TraceId {
+    pub fn to_hex(self) -> String {
+        alloc::format!("{:032x}", self.0)
+    }
+
+    /// Parse exactly 32 hex characters (no `0x` prefix).
+    pub fn from_hex(s: &str) -> Option<Self> {
+        if s.len() != 32 || !s.bytes().all(|b| b.is_ascii_hexdigit()) {
+            return None;
+        }
+        let mut v: u128 = 0;
+        for b in s.bytes() {
+            v = (v << 4) | u128::from((b as char).to_digit(16)?);
+        }
+        Some(TraceId(v))
+    }
+}
+
+/// OTel span id. Serialized as exactly 16 lowercase hex characters.
+#[derive(Clone, Copy, Debug, Default, PartialEq, Eq, PartialOrd, Ord, Hash)]
+pub struct SpanId(pub u64);
+
+impl SpanId {
+    pub fn to_hex(self) -> String {
+        alloc::format!("{:016x}", self.0)
+    }
+
+    /// Parse exactly 16 hex characters (no `0x` prefix).
+    pub fn from_hex(s: &str) -> Option<Self> {
+        if s.len() != 16 || !s.bytes().all(|b| b.is_ascii_hexdigit()) {
+            return None;
+        }
+        let mut v: u64 = 0;
+        for b in s.bytes() {
+            v = (v << 4) | u64::from((b as char).to_digit(16)?);
+        }
+        Some(SpanId(v))
+    }
+}
+
+fn trace_id_from_hex<'de, E: serde::de::Error>(s: &str) -> Result<TraceId, E> {
+    TraceId::from_hex(s).ok_or_else(|| E::invalid_value(serde::de::Unexpected::Str(s), &"32 hex chars"))
+}
+
+fn span_id_from_hex<'de, E: serde::de::Error>(s: &str) -> Result<SpanId, E> {
+    SpanId::from_hex(s).ok_or_else(|| E::invalid_value(serde::de::Unexpected::Str(s), &"16 hex chars"))
+}
+
+impl Serialize for TraceId {
+    fn serialize<S: Serializer>(&self, serializer: S) -> Result<S::Ok, S::Error> {
+        serializer.serialize_str(&self.to_hex())
+    }
+}
+
+impl<'de> Deserialize<'de> for TraceId {
+    fn deserialize<D: Deserializer<'de>>(deserializer: D) -> Result<Self, D::Error> {
+        struct V;
+        impl Visitor<'_> for V {
+            type Value = TraceId;
+            fn expecting(&self, f: &mut alloc::fmt::Formatter) -> alloc::fmt::Result {
+                f.write_str("a 32-character hex trace id")
+            }
+            fn visit_str<E: serde::de::Error>(self, v: &str) -> Result<TraceId, E> {
+                trace_id_from_hex(v)
+            }
+        }
+        deserializer.deserialize_str(V)
+    }
+}
+
+impl Serialize for SpanId {
+    fn serialize<S: Serializer>(&self, serializer: S) -> Result<S::Ok, S::Error> {
+        serializer.serialize_str(&self.to_hex())
+    }
+}
+
+impl<'de> Deserialize<'de> for SpanId {
+    fn deserialize<D: Deserializer<'de>>(deserializer: D) -> Result<Self, D::Error> {
+        struct V;
+        impl Visitor<'_> for V {
+            type Value = SpanId;
+            fn expecting(&self, f: &mut alloc::fmt::Formatter) -> alloc::fmt::Result {
+                f.write_str("a 16-character hex span id")
+            }
+            fn visit_str<E: serde::de::Error>(self, v: &str) -> Result<SpanId, E> {
+                span_id_from_hex(v)
+            }
+        }
+        deserializer.deserialize_str(V)
+    }
+}
+
+/// One journal record. `seq` is assigned by the journal (ring buffer), not by
+/// the producer, so consumers can tail with [`crate::EventRing::since`].
+#[derive(Clone, Debug, PartialEq, Serialize, Deserialize)]
+pub struct Event {
+    /// Monotonic journal sequence number (gapless while the journal lives).
+    pub seq: u64,
+    /// Wall clock, microseconds since the Unix epoch.
+    pub ts_us: u64,
+    /// Producer identity for service filtering and per-service rate limits.
+    #[serde(default, skip_serializing_if = "Option::is_none")]
+    pub service: Option<String>,
+    #[serde(default, skip_serializing_if = "Option::is_none")]
+    pub trace_id: Option<TraceId>,
+    #[serde(default, skip_serializing_if = "Option::is_none")]
+    pub span_id: Option<SpanId>,
+    #[serde(default, skip_serializing_if = "Option::is_none")]
+    pub parent_span_id: Option<SpanId>,
+    pub payload: Payload,
+}
+
+/// The vocabularies of the open-kimono journal (docs/PLAN.md B1): everything
+/// the phone itself does (mic, STT, power, services) as op6; model calls as
+/// OTel GenAI spans and agent↔UI protocol events as AG-UI are added on top.
+#[derive(Clone, Debug, PartialEq, Serialize, Deserialize)]
+#[serde(tag = "kind", rename_all = "snake_case")]
+pub enum Payload {
+    GenAi(crate::genai::GenAiEvent),
+    AgUi(crate::agui::AgUiEvent),
+    Op6(crate::op6::Op6Event),
+}
