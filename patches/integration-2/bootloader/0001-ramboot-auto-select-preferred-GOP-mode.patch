From 41317dc651354474c9974158aa1baddc2aecdffb Mon Sep 17 00:00:00 2001
From: x <x@y.z>
Date: Sat, 24 Oct 2026 23:40:50 +0000
Subject: [PATCH] ramboot: auto-select preferred GOP mode

Co-Authored-By: Codex <noreply@openai.com>
---
 src/main.rs | 7 +++++++
 1 file changed, 7 insertions(+)

diff --git a/src/main.rs b/src/main.rs
index 0b4ee2b..3cbf332 100644
--- a/src/main.rs
+++ b/src/main.rs
@@ -160,6 +160,13 @@ fn select_mode(
     }
     println!();
 
+    // RAM rescue boots must not wait for a keyboard that the phone may not have.
+    #[cfg(feature = "ramboot")]
+    {
+        println!("Auto-selecting boot resolution");
+        return modes.iter().find(|(mode, _)| mode.id == selected).map(|x| x.0);
+    }
+
     println!("Arrow keys and enter select mode");
     #[cfg(not(feature = "ramboot"))]
     let live_mode = os.get_text_position();
