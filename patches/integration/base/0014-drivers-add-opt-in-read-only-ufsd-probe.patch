diff --git a/drivers/ufs-core/src/device.rs b/drivers/ufs-core/src/device.rs
new file mode 100644
index 00000000..54e063f1
--- /dev/null
+++ b/drivers/ufs-core/src/device.rs
@@ -0,0 +1,195 @@
+//! Device management: NOP, Query, descriptors, logical units (`specs/ufs.md` §4 steps 9–12).
+
+use crate::hc::{Completion, HostInfo, Ufshc};
+use crate::upiu;
+use crate::{Delay, Dma, Error, Result, Stage};
+use alloc::vec::Vec;
+use mmio_replay::Mmio;
+
+/// Descriptor IDN: device.
+pub const IDN_DEVICE: u8 = 0x00;
+/// Descriptor IDN: unit.
+pub const IDN_UNIT: u8 = 0x02;
+/// Descriptor IDN: geometry.
+pub const IDN_GEOMETRY: u8 = 0x07;
+/// Flag IDN: `fDeviceInit`.
+pub const FLAG_DEVICE_INIT: u8 = 0x01;
+/// Largest descriptor read (the length field is one byte).
+const DESC_MAX: u16 = 255;
+
+/// An enabled logical unit, from its unit descriptor.
+#[derive(Clone, Debug, PartialEq, Eq)]
+pub struct LogicalUnit {
+    /// LUN (0..32).
+    pub lun: u8,
+    /// Logical block size in bytes (`2^bLogicalBlockSize`).
+    pub block_size: u32,
+    /// `qLogicalBlockCount`.
+    pub block_count: u64,
+    /// `bLUWriteProtect` (0 none, 1 power-on, 2 permanent).
+    pub write_protect: u8,
+    /// `bBootLunID` (0 = not a boot LU, 1 = A, 2 = B).
+    pub boot_lun_id: u8,
+}
+
+/// What bring-up learned about the controller and device.
+#[derive(Clone, Debug, PartialEq, Eq)]
+pub struct DeviceInfo {
+    /// Controller identification.
+    pub host: HostInfo,
+    /// Device descriptor `wSpecVersion` (BCD, e.g. 0x0210).
+    pub spec_version: u16,
+    /// Device descriptor `wManufacturerID`.
+    pub manufacturer_id: u16,
+    /// Device descriptor `bNumberLU`.
+    pub number_lu: u8,
+    /// Geometry `qTotalRawDeviceCapacity` (512-byte units).
+    pub raw_capacity: u64,
+    /// LUNs scanned (8 or 32, from `bMaxNumberLU`).
+    pub max_lu: u8,
+    /// Enabled logical units in LUN order.
+    pub units: Vec<LogicalUnit>,
+}
+
+fn be16(b: &[u8], at: usize) -> u16 {
+    u16::from_be_bytes([b[at], b[at + 1]])
+}
+
+fn be64(b: &[u8], at: usize) -> u64 {
+    let mut a = [0u8; 8];
+    a.copy_from_slice(&b[at..at + 8]);
+    u64::from_be_bytes(a)
+}
+
+impl<M: Mmio, D: Dma, T: Delay> Ufshc<M, D, T> {
+    /// Full read-only bring-up: controller, link, list, NOP, `fDeviceInit`, LU table.
+    pub fn bring_up(&mut self) -> Result<DeviceInfo> {
+        self.enable()?;
+        self.link_startup()?;
+        self.start_list()?;
+        self.nop()?;
+        self.device_init()?;
+        self.enumerate()
+    }
+
+    /// NOP OUT → NOP IN; timeouts, OCS and response errors are retried `nop_attempts` times.
+    pub fn nop(&mut self) -> Result<()> {
+        let mut last = Error::Timeout(Stage::Doorbell);
+        for _ in 0..self.cfg.nop_attempts.max(1) {
+            let tag = self.next_tag();
+            match self.transfer(&upiu::nop_out(tag), 0) {
+                Ok(c) => match upiu::parse_header(&c.resp).response {
+                    0 => return Ok(()),
+                    r => last = Error::Response(r),
+                },
+                Err(e @ (Error::Ocs(_) | Error::Timeout(Stage::Doorbell))) => last = e,
+                Err(e) => return Err(e),
+            }
+        }
+        Err(last)
+    }
+
+    fn query(
+        &mut self,
+        function: u8,
+        opcode: u8,
+        idn: u8,
+        index: u8,
+        len: u16,
+    ) -> Result<Completion> {
+        let tag = self.next_tag();
+        let c = self.transfer(&upiu::query(tag, function, opcode, idn, index, len), 0)?;
+        match upiu::parse_header(&c.resp).response {
+            0 => Ok(c),
+            r => Err(Error::Response(r)),
+        }
+    }
+
+    /// READ DESCRIPTOR; returns `bLength` bytes after checking the IDN.
+    pub fn read_descriptor(&mut self, idn: u8, index: u8) -> Result<Vec<u8>> {
+        let c = self.query(
+            upiu::QUERY_FN_READ,
+            upiu::QOP_READ_DESC,
+            idn,
+            index,
+            DESC_MAX,
+        )?;
+        let mut d = c.resp[upiu::RESP_HDR_LEN..].to_vec();
+        if d.len() < 2 || d[1] != idn || (d[0] as usize) < 2 {
+            return Err(Error::Descriptor(idn));
+        }
+        d.truncate(d[0] as usize);
+        Ok(d)
+    }
+
+    /// READ FLAG.
+    pub fn read_flag(&mut self, idn: u8) -> Result<bool> {
+        let c = self.query(upiu::QUERY_FN_READ, upiu::QOP_READ_FLAG, idn, 0, 0)?;
+        Ok(upiu::query_value(&c.resp) & 1 != 0)
+    }
+
+    /// READ ATTRIBUTE (32-bit value).
+    pub fn read_attribute(&mut self, idn: u8, index: u8) -> Result<u32> {
+        let c = self.query(upiu::QUERY_FN_READ, upiu::QOP_READ_ATTR, idn, index, 0)?;
+        Ok(upiu::query_value(&c.resp))
+    }
+
+    /// SET FLAG `fDeviceInit`, then poll until the device clears it. The only Query write.
+    pub fn device_init(&mut self) -> Result<()> {
+        self.query(
+            upiu::QUERY_FN_WRITE,
+            upiu::QOP_SET_FLAG,
+            FLAG_DEVICE_INIT,
+            0,
+            0,
+        )?;
+        for _ in 0..self.cfg.polls.device_init {
+            if !self.read_flag(FLAG_DEVICE_INIT)? {
+                return Ok(());
+            }
+        }
+        Err(Error::Timeout(Stage::DeviceInit))
+    }
+
+    /// Device + geometry descriptors, then one unit descriptor per possible LUN.
+    pub fn enumerate(&mut self) -> Result<DeviceInfo> {
+        let dev = self.read_descriptor(IDN_DEVICE, 0)?;
+        if dev.len() < 0x1a {
+            return Err(Error::Descriptor(IDN_DEVICE));
+        }
+        let geo = self.read_descriptor(IDN_GEOMETRY, 0)?;
+        if geo.len() < 0x0d {
+            return Err(Error::Descriptor(IDN_GEOMETRY));
+        }
+        let max_lu = if geo[0x0c] == 1 { 32 } else { 8 };
+        let mut units = Vec::new();
+        for lun in 0..max_lu {
+            let u = self.read_descriptor(IDN_UNIT, lun)?;
+            if u.len() < 0x13 {
+                return Err(Error::Descriptor(IDN_UNIT));
+            }
+            if u[0x03] != 1 {
+                continue;
+            }
+            if !(9..=16).contains(&u[0x0a]) {
+                return Err(Error::Descriptor(IDN_UNIT));
+            }
+            units.push(LogicalUnit {
+                lun,
+                block_size: 1 << u[0x0a],
+                block_count: be64(&u, 0x0b),
+                write_protect: u[0x05],
+                boot_lun_id: u[0x04],
+            });
+        }
+        Ok(DeviceInfo {
+            host: self.info,
+            spec_version: be16(&dev, 0x10),
+            manufacturer_id: be16(&dev, 0x18),
+            number_lu: dev[0x06],
+            raw_capacity: be64(&geo, 0x04),
+            max_lu,
+            units,
+        })
+    }
+}
diff --git a/drivers/ufs-core/src/dma.rs b/drivers/ufs-core/src/dma.rs
new file mode 100644
index 00000000..cb9bd1bf
--- /dev/null
+++ b/drivers/ufs-core/src/dma.rs
@@ -0,0 +1,55 @@
+//! The DMA region the controller reads requests from and writes responses into.
+//!
+//! One physically contiguous, uncached region holds everything (`specs/ufs.md` §4–5):
+//!
+//! ```text
+//! 0x0000  UTRL         32 slots × 32 B UTRD   (1 KiB aligned)
+//! 0x0400  UCD slot 0   request UPIU @+0, response UPIU @+512, PRDT @+1024 (128 B aligned)
+//! 0x1000  data buffer  data-in target for SCSI reads (rest of the region, ≤ 256 KiB used)
+//! ```
+
+/// A physically contiguous DMA buffer. Production: an uncached `/scheme/memory` allocation;
+/// tests: a byte vector shared with the device model.
+pub trait Dma {
+    /// Bus address of byte 0 (physical — U-Boot leaves the UFS SMMU stream in S1 bypass).
+    fn phys(&self) -> u64;
+    /// Region size in bytes.
+    fn size(&self) -> usize;
+    /// Copy `buf.len()` bytes starting at `off` into `buf`.
+    fn read(&mut self, off: usize, buf: &mut [u8]);
+    /// Copy `data` into the region at `off`.
+    fn write(&mut self, off: usize, data: &[u8]);
+}
+
+/// UTRL offset within the region.
+pub const UTRL_OFF: usize = 0x0;
+/// UTRD size.
+pub const UTRD_LEN: usize = 32;
+/// UCD (slot 0) offset within the region.
+pub const UCD_OFF: usize = 0x400;
+/// Request UPIU offset inside the UCD.
+pub const UCD_REQ: usize = 0;
+/// Response UPIU offset inside the UCD.
+pub const UCD_RESP: usize = 512;
+/// Response UPIU area size.
+pub const UCD_RESP_LEN: usize = 512;
+/// PRDT offset inside the UCD.
+pub const UCD_PRDT: usize = 1024;
+/// Data buffer offset within the region.
+pub const DATA_OFF: usize = 0x1000;
+/// Smallest usable region: list + UCD + one 4 KiB block.
+pub const MIN_LEN: usize = DATA_OFF + 4096;
+/// One PRDT entry carries at most 256 KiB.
+pub const MAX_PRDT_BYTES: usize = 256 * 1024;
+
+/// Bytes usable for one data-in transfer with this region.
+pub fn data_capacity(len: usize) -> usize {
+    len.saturating_sub(DATA_OFF).min(MAX_PRDT_BYTES)
+}
+
+/// Read a little-endian u32 from the region.
+pub fn read_u32(dma: &mut impl Dma, off: usize) -> u32 {
+    let mut b = [0u8; 4];
+    dma.read(off, &mut b);
+    u32::from_le_bytes(b)
+}
diff --git a/drivers/ufs-core/src/gpt.rs b/drivers/ufs-core/src/gpt.rs
new file mode 100644
index 00000000..a6dadfde
--- /dev/null
+++ b/drivers/ufs-core/src/gpt.rs
@@ -0,0 +1,206 @@
+//! GUID Partition Table parsing (UEFI 2.x §5.3), CRC-checked, read-only.
+
+use crate::hc::Ufshc;
+use crate::{Delay, Dma, Error, Result};
+use alloc::string::String;
+use alloc::vec;
+use alloc::vec::Vec;
+use mmio_replay::Mmio;
+
+/// Why a GPT was rejected.
+#[derive(Clone, Copy, Debug, PartialEq, Eq)]
+pub enum GptError {
+    /// Block shorter than the header.
+    Truncated,
+    /// No `"EFI PART"` signature.
+    Signature,
+    /// Header size outside 92..=block size.
+    HeaderSize,
+    /// Header CRC32 mismatch.
+    HeaderCrc,
+    /// Entry size not 128 × 2^n (≤ 512) or more than 1024 entries.
+    EntryLayout,
+    /// Partition entry array CRC32 mismatch.
+    EntriesCrc,
+}
+
+/// GPT header fields.
+#[derive(Clone, Copy, Debug, PartialEq, Eq)]
+pub struct GptHeader {
+    /// LBA of this header.
+    pub current_lba: u64,
+    /// LBA of the backup header.
+    pub backup_lba: u64,
+    /// First usable LBA.
+    pub first_usable: u64,
+    /// Last usable LBA.
+    pub last_usable: u64,
+    /// Disk GUID (on-disk byte order).
+    pub disk_guid: [u8; 16],
+    /// Start of the entry array.
+    pub entries_lba: u64,
+    /// Number of entries.
+    pub num_entries: u32,
+    /// Size of one entry.
+    pub entry_size: u32,
+    /// CRC32 of the entry array.
+    pub entries_crc: u32,
+}
+
+/// One used partition entry.
+#[derive(Clone, Debug, PartialEq, Eq)]
+pub struct GptEntry {
+    /// Index in the entry array.
+    pub index: u32,
+    /// Partition type GUID (on-disk byte order).
+    pub type_guid: [u8; 16],
+    /// Unique GUID (on-disk byte order).
+    pub unique_guid: [u8; 16],
+    /// First LBA.
+    pub first_lba: u64,
+    /// Last LBA (inclusive).
+    pub last_lba: u64,
+    /// Attribute bits.
+    pub attributes: u64,
+    /// Name (UTF-16LE decoded, NUL-terminated).
+    pub name: String,
+}
+
+/// A parsed table.
+#[derive(Clone, Debug, PartialEq, Eq)]
+pub struct Gpt {
+    /// Header.
+    pub header: GptHeader,
+    /// Used entries (non-zero type GUID).
+    pub entries: Vec<GptEntry>,
+}
+
+/// CRC-32/ISO-HDLC (the GPT/zlib CRC), bitwise.
+pub fn crc32(data: &[u8]) -> u32 {
+    let mut crc = !0u32;
+    for &b in data {
+        crc ^= b as u32;
+        for _ in 0..8 {
+            crc = if crc & 1 != 0 {
+                (crc >> 1) ^ 0xedb8_8320
+            } else {
+                crc >> 1
+            };
+        }
+    }
+    !crc
+}
+
+fn le32(b: &[u8], at: usize) -> u32 {
+    u32::from_le_bytes([b[at], b[at + 1], b[at + 2], b[at + 3]])
+}
+
+fn le64(b: &[u8], at: usize) -> u64 {
+    le32(b, at) as u64 | (le32(b, at + 4) as u64) << 32
+}
+
+fn guid(b: &[u8], at: usize) -> [u8; 16] {
+    let mut g = [0u8; 16];
+    g.copy_from_slice(&b[at..at + 16]);
+    g
+}
+
+/// Parse and CRC-check the header in `block` (the LBA-1 block).
+pub fn parse_header(block: &[u8]) -> core::result::Result<GptHeader, GptError> {
+    if block.len() < 92 {
+        return Err(GptError::Truncated);
+    }
+    if &block[0..8] != b"EFI PART" {
+        return Err(GptError::Signature);
+    }
+    let size = le32(block, 12) as usize;
+    if size < 92 || size > block.len() {
+        return Err(GptError::HeaderSize);
+    }
+    let mut h = block[..size].to_vec();
+    h[16..20].fill(0);
+    if crc32(&h) != le32(block, 16) {
+        return Err(GptError::HeaderCrc);
+    }
+    let header = GptHeader {
+        current_lba: le64(block, 24),
+        backup_lba: le64(block, 32),
+        first_usable: le64(block, 40),
+        last_usable: le64(block, 48),
+        disk_guid: guid(block, 56),
+        entries_lba: le64(block, 72),
+        num_entries: le32(block, 80),
+        entry_size: le32(block, 84),
+        entries_crc: le32(block, 88),
+    };
+    let es = header.entry_size;
+    if !(128..=512).contains(&es) || !es.is_power_of_two() || header.num_entries > 1024 {
+        return Err(GptError::EntryLayout);
+    }
+    Ok(header)
+}
+
+/// CRC-check the entry array and decode the used entries.
+pub fn parse_entries(h: &GptHeader, bytes: &[u8]) -> core::result::Result<Vec<GptEntry>, GptError> {
+    let total = h.num_entries as usize * h.entry_size as usize;
+    if bytes.len() < total {
+        return Err(GptError::Truncated);
+    }
+    if crc32(&bytes[..total]) != h.entries_crc {
+        return Err(GptError::EntriesCrc);
+    }
+    let mut out = Vec::new();
+    for (i, e) in bytes[..total].chunks(h.entry_size as usize).enumerate() {
+        if e[0..16].iter().all(|&b| b == 0) {
+            continue;
+        }
+        let units = e[56..128]
+            .chunks(2)
+            .map(|c| u16::from_le_bytes([c[0], c[1]]));
+        let name = char::decode_utf16(units.take_while(|&u| u != 0))
+            .map(|c| c.unwrap_or(char::REPLACEMENT_CHARACTER))
+            .collect();
+        out.push(GptEntry {
+            index: i as u32,
+            type_guid: guid(e, 0),
+            unique_guid: guid(e, 16),
+            first_lba: le64(e, 32),
+            last_lba: le64(e, 40),
+            attributes: le64(e, 48),
+            name,
+        });
+    }
+    Ok(out)
+}
+
+impl<M: Mmio, D: Dma, T: Delay> Ufshc<M, D, T> {
+    /// Read and verify the primary GPT of a LU (header at LBA 1).
+    pub fn read_gpt(&mut self, lun: u8, block_size: u32) -> Result<Gpt> {
+        let bs = block_size as usize;
+        let mut block = vec![0u8; bs];
+        self.read(lun, 1, block_size, &mut block)?;
+        let header = parse_header(&block).map_err(Error::Gpt)?;
+        let bytes = header.num_entries as usize * header.entry_size as usize;
+        let mut array = vec![0u8; bytes.div_ceil(bs) * bs];
+        self.read(lun, header.entries_lba, block_size, &mut array)?;
+        let entries = parse_entries(&header, &array).map_err(Error::Gpt)?;
+        Ok(Gpt { header, entries })
+    }
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    #[test]
+    fn crc32_check_value() {
+        assert_eq!(crc32(b"123456789"), 0xcbf4_3926);
+        assert_eq!(crc32(b""), 0);
+    }
+
+    #[test]
+    fn header_rejects_garbage() {
+        assert_eq!(parse_header(&[0u8; 10]), Err(GptError::Truncated));
+        assert_eq!(parse_header(&[0u8; 512]), Err(GptError::Signature));
+    }
+}
diff --git a/drivers/ufs-core/src/hc.rs b/drivers/ufs-core/src/hc.rs
new file mode 100644
index 00000000..72ffe2ad
--- /dev/null
+++ b/drivers/ufs-core/src/hc.rs
@@ -0,0 +1,214 @@
+//! Host controller: HCE cycle, Qualcomm hooks, UIC commands, UTRL setup, one-slot transfers.
+
+use crate::dma::{self, Dma};
+use crate::regs::{self, qcom};
+use crate::{Config, Delay, Error, Result, Stage};
+use alloc::vec::Vec;
+use mmio_replay::Mmio;
+
+/// Identification read during bring-up.
+#[derive(Clone, Copy, Debug, Default, PartialEq, Eq)]
+pub struct HostInfo {
+    /// CAP register.
+    pub cap: u32,
+    /// VER register.
+    pub ver: u32,
+    /// Qualcomm `REG_UFS_HW_VERSION` (0 when not Qualcomm).
+    pub qcom_hw_version: u32,
+}
+
+/// A completed transfer: the response UPIU (header + data segment).
+pub(crate) struct Completion {
+    pub resp: Vec<u8>,
+}
+
+/// UFS host controller driver.
+pub struct Ufshc<M: Mmio, D: Dma, T: Delay> {
+    io: M,
+    base: u64,
+    pub(crate) dma: D,
+    pub(crate) delay: T,
+    pub(crate) cfg: Config,
+    pub(crate) info: HostInfo,
+    pub(crate) tag: u8,
+}
+
+impl<M: Mmio, D: Dma, T: Delay> Ufshc<M, D, T> {
+    /// Wrap a register window at `base` and a DMA region. No MMIO access happens here.
+    pub fn new(io: M, base: u64, dma: D, delay: T, cfg: Config) -> Result<Self> {
+        if dma.size() < dma::MIN_LEN || dma.phys() & 0xfff != 0 {
+            return Err(Error::DmaLayout);
+        }
+        Ok(Ufshc {
+            io,
+            base,
+            dma,
+            delay,
+            cfg,
+            info: HostInfo::default(),
+            tag: 0,
+        })
+    }
+
+    /// Identification registers read by [`Ufshc::enable`].
+    pub fn info(&self) -> HostInfo {
+        self.info
+    }
+
+    /// Give back the register window and DMA region.
+    pub fn into_parts(self) -> (M, D) {
+        (self.io, self.dma)
+    }
+
+    pub(crate) fn rd(&mut self, off: u64) -> u32 {
+        self.io.read_u32(self.base + off)
+    }
+
+    pub(crate) fn wr(&mut self, off: u64, v: u32) {
+        self.io.write_u32(self.base + off, v)
+    }
+
+    pub(crate) fn wait(
+        &mut self,
+        stage: Stage,
+        off: u64,
+        polls: u32,
+        ok: impl Fn(u32) -> bool,
+    ) -> Result<u32> {
+        for _ in 0..polls {
+            let v = self.rd(off);
+            if ok(v) {
+                return Ok(v);
+            }
+            self.delay.delay_us(self.cfg.poll_delay_us);
+        }
+        Err(Error::Timeout(stage))
+    }
+
+    /// Steps 1–5 of `specs/ufs.md` §4: identify, IE=0, HCE 1→0→1, Qualcomm QUniPro + PHY check.
+    pub fn enable(&mut self) -> Result<()> {
+        let cap = self.rd(regs::CAP);
+        let ver = self.rd(regs::VER);
+        let hw = if self.cfg.qcom.is_some() {
+            self.rd(qcom::HW_VERSION)
+        } else {
+            0
+        };
+        self.info = HostInfo {
+            cap,
+            ver,
+            qcom_hw_version: hw,
+        };
+        if cap & regs::CAP_LSDBS != 0 {
+            return Err(Error::Unsupported("single doorbell"));
+        }
+        let end = self.dma.phys() + self.dma.size() as u64 - 1;
+        if end > u32::MAX as u64 && cap & regs::CAP_64AS == 0 {
+            return Err(Error::Unsupported("64-bit addressing"));
+        }
+        self.wr(regs::IE, 0);
+        let hce = self.rd(regs::HCE);
+        if hce & regs::HCE_ENABLE != 0 {
+            self.wr(regs::HCE, hce & !regs::HCE_ENABLE);
+            let polls = self.cfg.polls.hce;
+            self.wait(Stage::HceDisable, regs::HCE, polls, |v| {
+                v & regs::HCE_ENABLE == 0
+            })?;
+        }
+        if self.cfg.qcom.is_some() {
+            let cfg1 = self.rd(qcom::CFG1);
+            self.wr(qcom::CFG1, cfg1 | qcom::CFG1_QUNIPRO_SEL);
+            if qcom::hw_major(hw) >= 5 {
+                let cfg0 = self.rd(qcom::CFG0);
+                self.wr(qcom::CFG0, cfg0 & !qcom::CFG0_QUNIPRO_G4_SEL);
+            }
+        }
+        self.wr(regs::HCE, regs::HCE_ENABLE);
+        self.delay.delay_us(self.cfg.hce_settle_us);
+        let polls = self.cfg.polls.hce;
+        self.wait(Stage::HceEnable, regs::HCE, polls, |v| {
+            v & regs::HCE_ENABLE != 0
+        })?;
+        if self.cfg.qcom.is_some() {
+            self.check_phy_hibern8()?;
+        }
+        Ok(())
+    }
+
+    fn check_phy_hibern8(&mut self) -> Result<()> {
+        let mut state = 0;
+        for _ in 0..self.cfg.polls.phy {
+            state = self.dme_get(qcom::MPHY_TX_FSM_STATE, 0)?;
+            if state == qcom::TX_FSM_HIBERN8 {
+                return Ok(());
+            }
+            self.delay.delay_us(self.cfg.poll_delay_us);
+        }
+        Err(Error::PhyNotReady(state))
+    }
+
+    /// Issue one UIC command; returns `UCMDARG3` (the DME_GET value).
+    pub fn uic(&mut self, opcode: u8, arg1: u32, arg2: u32, arg3: u32) -> Result<u32> {
+        let polls = self.cfg.polls.uic;
+        self.wait(Stage::UicReady, regs::HCS, polls, |v| {
+            v & regs::HCS_UCRDY != 0
+        })?;
+        self.wr(regs::UCMDARG1, arg1);
+        self.wr(regs::UCMDARG2, arg2);
+        self.wr(regs::UCMDARG3, arg3);
+        self.wr(regs::UICCMD, opcode as u32);
+        self.wait(Stage::UicComplete, regs::IS, polls, |v| {
+            v & regs::IS_UCCS != 0
+        })?;
+        self.wr(regs::IS, regs::IS_UCCS);
+        let result = (self.rd(regs::UCMDARG2) & 0xff) as u8;
+        if result != 0 {
+            return Err(Error::Uic { opcode, result });
+        }
+        Ok(self.rd(regs::UCMDARG3))
+    }
+
+    /// DME_GET of a local attribute.
+    pub fn dme_get(&mut self, attr: u16, sel: u16) -> Result<u32> {
+        self.uic(regs::DME_GET, ((attr as u32) << 16) | sel as u32, 0, 0)
+    }
+
+    /// DME_SET of a local, volatile ("normal" set type) attribute.
+    pub fn dme_set(&mut self, attr: u16, sel: u16, value: u32) -> Result<()> {
+        self.uic(regs::DME_SET, ((attr as u32) << 16) | sel as u32, 0, value)
+            .map(|_| ())
+    }
+
+    /// Steps 6–7: Qualcomm pre-link-startup DME setup, `DME_LINKSTARTUP`, HCS.DP check.
+    pub fn link_startup(&mut self) -> Result<()> {
+        if let Some(q) = self.cfg.qcom {
+            let mut v = self.dme_get(qcom::DME_VS_CORE_CLK_CTRL, 0)?;
+            v &= !(qcom::CLK_1US_CYCLES_MASK | qcom::CORE_CLK_DIV_EN);
+            v |= q.unipro_core_clk_mhz as u32;
+            self.dme_set(qcom::DME_VS_CORE_CLK_CTRL, 0, v)?;
+            let lanes = self.dme_get(regs::PA_CONNECTED_TX_DATA_LANES, 0)?;
+            for lane in 0..lanes.min(4) {
+                self.dme_set(regs::TX_LCC_ENABLE, lane as u16, 0)?;
+            }
+        }
+        self.uic(regs::DME_LINKSTARTUP, 0, 0, 0)?;
+        if self.rd(regs::HCS) & regs::HCS_DP == 0 {
+            return Err(Error::NoDevice);
+        }
+        Ok(())
+    }
+
+    /// Step 8: clear residual IS, program the UTRL base, check ready, run.
+    pub fn start_list(&mut self) -> Result<()> {
+        let is = self.rd(regs::IS);
+        self.wr(regs::IS, is);
+        let base = self.dma.phys() + dma::UTRL_OFF as u64;
+        self.wr(regs::UTRLBA, base as u32);
+        self.wr(regs::UTRLBAU, (base >> 32) as u32);
+        if self.rd(regs::HCS) & regs::HCS_UTRLRDY == 0 || self.rd(regs::UTRLDBR) != 0 {
+            return Err(Error::ListNotReady);
+        }
+        self.wr(regs::UTRLRSR, 1);
+        Ok(())
+    }
+}
diff --git a/drivers/ufs-core/src/lib.rs b/drivers/ufs-core/src/lib.rs
new file mode 100644
index 00000000..049a3a3e
--- /dev/null
+++ b/drivers/ufs-core/src/lib.rs
@@ -0,0 +1,178 @@
+//! `ufs-core` — read-only UFS host controller core for the OnePlus 6 (`qcom,sdm845-ufshc`).
+//!
+//! Spec: `specs/ufs.md`. The driver takes the register window through the `mmio-replay`
+//! [`Mmio`] trait and its descriptor/data memory through [`Dma`], so every step is host-testable
+//! against a register + UTRD/UPIU model or a replayed phone trace.
+//!
+//! Bring-up ([`Ufshc::bring_up`]): HCE cycle with the Qualcomm QUniPro/PHY checks, UIC
+//! `DME_LINKSTARTUP`, UTRL setup, NOP OUT/IN, `fDeviceInit`, device/geometry/unit descriptors →
+//! logical-unit table. Then [`Ufshc::read_capacity`], [`Ufshc::read`] and [`Ufshc::read_gpt`].
+//!
+//! **Read-only by construction:** no UTRD with host-to-device direction is ever built, the SCSI
+//! layer only accepts an opcode allowlist ([`scsi::Cmd`], [`Ufshc::scsi_raw`]) and the only Query
+//! write is the volatile `fDeviceInit` flag.
+
+#![no_std]
+#![forbid(unsafe_code)]
+#![deny(missing_docs)]
+
+extern crate alloc;
+
+mod device;
+pub mod dma;
+pub mod gpt;
+mod hc;
+pub mod regs;
+pub mod scsi;
+pub mod upiu;
+mod xfer;
+
+pub use device::{DeviceInfo, LogicalUnit};
+pub use dma::Dma;
+pub use hc::{HostInfo, Ufshc};
+pub use mmio_replay::Mmio;
+
+/// Where a bounded wait ran out.
+#[derive(Clone, Copy, Debug, PartialEq, Eq)]
+pub enum Stage {
+    /// HCE did not drop to 0.
+    HceDisable,
+    /// HCE did not come back to 1.
+    HceEnable,
+    /// The PHY TX FSM never reached HIBERN8 after HCE.
+    PhyHibern8,
+    /// HCS.UCRDY never set.
+    UicReady,
+    /// IS.UCCS never set.
+    UicComplete,
+    /// The transfer doorbell never cleared.
+    Doorbell,
+    /// The slot did not clear after UTRLCLR.
+    Clear,
+    /// `fDeviceInit` never read back 0.
+    DeviceInit,
+}
+
+/// Driver errors. Every error path leaves the controller without an outstanding slot.
+#[derive(Clone, Debug, PartialEq, Eq)]
+pub enum Error {
+    /// The controller lacks a capability this driver needs.
+    Unsupported(&'static str),
+    /// The DMA region is too small or misaligned.
+    DmaLayout,
+    /// A bounded wait expired.
+    Timeout(Stage),
+    /// `MPHY_TX_FSM_STATE` after HCE (the firmware-initialised PHY did not survive).
+    PhyNotReady(u32),
+    /// A UIC command returned a non-zero config result code.
+    Uic {
+        /// UIC opcode.
+        opcode: u8,
+        /// `UCMDARG2[7:0]`.
+        result: u8,
+    },
+    /// Link startup completed but HCS.DP is clear.
+    NoDevice,
+    /// HCS.UTRLRDY clear or a stale doorbell after list setup.
+    ListNotReady,
+    /// A fatal IS bit was raised during a transfer (raw IS value).
+    Fatal(u32),
+    /// Overall Command Status in the UTRD was not success.
+    Ocs(u8),
+    /// The response UPIU had the wrong transaction code or task tag.
+    BadUpiu,
+    /// The UPIU response field was not "target success".
+    Response(u8),
+    /// The SCSI status was CHECK CONDITION.
+    CheckCondition(scsi::Sense),
+    /// Another non-GOOD SCSI status.
+    ScsiStatus(u8),
+    /// A command outside the read-only allowlist; nothing was sent.
+    Refused(u8),
+    /// A descriptor was shorter than its fixed fields or had the wrong IDN.
+    Descriptor(u8),
+    /// Invalid caller argument (LUN, length, buffer); nothing was sent.
+    InvalidArgument,
+    /// The device returned fewer data-in bytes than requested (bytes received).
+    ShortTransfer(usize),
+    /// GPT parse failure.
+    Gpt(gpt::GptError),
+}
+
+/// Result alias.
+pub type Result<T> = core::result::Result<T, Error>;
+
+/// Busy-wait hook between polls (production: a short sleep; tests: no-op).
+pub trait Delay {
+    /// Wait about `us` microseconds.
+    fn delay_us(&mut self, us: u32);
+}
+
+/// A [`Delay`] that returns immediately.
+#[derive(Clone, Copy, Debug, Default)]
+pub struct NoDelay;
+
+impl Delay for NoDelay {
+    fn delay_us(&mut self, _us: u32) {}
+}
+
+/// Qualcomm vendor settings.
+#[derive(Clone, Copy, Debug, PartialEq, Eq)]
+pub struct Qcom {
+    /// `core_clk_unipro` in MHz for `DME_VS_CORE_CLK_CTRL` (DT top OPP: 150).
+    pub unipro_core_clk_mhz: u8,
+}
+
+/// Poll budgets (iterations, each followed by `poll_delay_us`).
+#[derive(Clone, Copy, Debug, PartialEq, Eq)]
+pub struct Polls {
+    /// HCE enable/disable.
+    pub hce: u32,
+    /// PHY HIBERN8 check (DME_GET per poll).
+    pub phy: u32,
+    /// UIC ready / completion.
+    pub uic: u32,
+    /// Transfer doorbell.
+    pub transfer: u32,
+    /// Slot clear after a timeout.
+    pub clear: u32,
+    /// `fDeviceInit` read-back queries.
+    pub device_init: u32,
+}
+
+/// Driver configuration.
+#[derive(Clone, Copy, Debug, PartialEq, Eq)]
+pub struct Config {
+    /// `Some` on `qcom,*-ufshc`.
+    pub qcom: Option<Qcom>,
+    /// Poll budgets.
+    pub polls: Polls,
+    /// Delay between polls, µs.
+    pub poll_delay_us: u32,
+    /// Delay after writing HCE = 1 before the first read-back, µs (Linux/FreeBSD: 100).
+    pub hce_settle_us: u32,
+    /// NOP OUT attempts (Linux `NOP_OUT_RETRIES` = 10).
+    pub nop_attempts: u8,
+}
+
+impl Config {
+    /// SDM845 defaults: Qualcomm hooks on, timeouts in line with FreeBSD/Linux.
+    pub const fn sdm845() -> Self {
+        Config {
+            qcom: Some(Qcom {
+                unipro_core_clk_mhz: 150,
+            }),
+            polls: Polls {
+                hce: 1_000,
+                phy: 1_000,
+                uic: 5_000,
+                transfer: 100_000,
+                clear: 1_000,
+                device_init: 2_000,
+            },
+            poll_delay_us: 100,
+            hce_settle_us: 100,
+            nop_attempts: 10,
+        }
+    }
+}
diff --git a/drivers/ufs-core/src/regs.rs b/drivers/ufs-core/src/regs.rs
new file mode 100644
index 00000000..fd0caceb
--- /dev/null
+++ b/drivers/ufs-core/src/regs.rs
@@ -0,0 +1,109 @@
+//! UFSHCI register offsets/bits and the Qualcomm vendor additions (`specs/ufs.md` §3).
+
+/// Host Controller Capabilities.
+pub const CAP: u64 = 0x00;
+/// UFS version.
+pub const VER: u64 = 0x08;
+/// Interrupt Status (write-1-to-clear).
+pub const IS: u64 = 0x20;
+/// Interrupt Enable.
+pub const IE: u64 = 0x24;
+/// Host Controller Status.
+pub const HCS: u64 = 0x30;
+/// Host Controller Enable.
+pub const HCE: u64 = 0x34;
+/// UTP Transfer Request List base, low 32 bits.
+pub const UTRLBA: u64 = 0x50;
+/// UTP Transfer Request List base, high 32 bits.
+pub const UTRLBAU: u64 = 0x54;
+/// UTRL doorbell.
+pub const UTRLDBR: u64 = 0x58;
+/// UTRL clear (a 0 bit clears that slot).
+pub const UTRLCLR: u64 = 0x5c;
+/// UTRL run/stop.
+pub const UTRLRSR: u64 = 0x60;
+/// UIC command opcode.
+pub const UICCMD: u64 = 0x90;
+/// UIC command argument 1 (`attr << 16 | selector`).
+pub const UCMDARG1: u64 = 0x94;
+/// UIC command argument 2 (`[7:0]` config result code).
+pub const UCMDARG2: u64 = 0x98;
+/// UIC command argument 3 (value).
+pub const UCMDARG3: u64 = 0x9c;
+
+/// CAP: number of transfer slots minus one.
+pub const CAP_NUTRS_MASK: u32 = 0xff;
+/// CAP: 64-bit addressing supported.
+pub const CAP_64AS: u32 = 1 << 24;
+/// CAP: legacy single doorbell *not* supported.
+pub const CAP_LSDBS: u32 = 1 << 29;
+
+/// IS: UTP transfer request completion.
+pub const IS_UTRCS: u32 = 1 << 0;
+/// IS: UIC error.
+pub const IS_UE: u32 = 1 << 2;
+/// IS: UIC command completion.
+pub const IS_UCCS: u32 = 1 << 10;
+/// IS: device fatal error.
+pub const IS_DFES: u32 = 1 << 11;
+/// IS: UTP error.
+pub const IS_UTPES: u32 = 1 << 12;
+/// IS: host controller fatal error.
+pub const IS_HCFES: u32 = 1 << 16;
+/// IS: system bus fatal error.
+pub const IS_SBFES: u32 = 1 << 17;
+/// IS bits that abort a transfer.
+pub const IS_FATAL: u32 = IS_UE | IS_DFES | IS_UTPES | IS_HCFES | IS_SBFES;
+
+/// HCS: device present.
+pub const HCS_DP: u32 = 1 << 0;
+/// HCS: transfer request list ready.
+pub const HCS_UTRLRDY: u32 = 1 << 1;
+/// HCS: UIC command ready.
+pub const HCS_UCRDY: u32 = 1 << 3;
+
+/// HCE: host controller enable.
+pub const HCE_ENABLE: u32 = 1 << 0;
+
+/// UIC opcode DME_GET.
+pub const DME_GET: u8 = 0x01;
+/// UIC opcode DME_SET.
+pub const DME_SET: u8 = 0x02;
+/// UIC opcode DME_PEER_GET.
+pub const DME_PEER_GET: u8 = 0x03;
+/// UIC opcode DME_LINKSTARTUP.
+pub const DME_LINKSTARTUP: u8 = 0x16;
+
+/// UniPro `PA_ConnectedTxDataLanes`.
+pub const PA_CONNECTED_TX_DATA_LANES: u16 = 0x1561;
+/// M-PHY TX `TX_LCC_ENABLE` (selector = lane).
+pub const TX_LCC_ENABLE: u16 = 0x002c;
+
+/// Qualcomm vendor registers and DME attributes (Linux `ufs-qcom.h`, facts only).
+pub mod qcom {
+    /// `REG_UFS_CFG0`.
+    pub const CFG0: u64 = 0xd8;
+    /// `REG_UFS_CFG1`.
+    pub const CFG1: u64 = 0xdc;
+    /// `REG_UFS_HW_VERSION`.
+    pub const HW_VERSION: u64 = 0xe4;
+    /// CFG0: `QUNIPRO_G4_SEL` (cleared on HW major >= 5 only).
+    pub const CFG0_QUNIPRO_G4_SEL: u32 = 1 << 5;
+    /// CFG1: `QUNIPRO_SEL`.
+    pub const CFG1_QUNIPRO_SEL: u32 = 1 << 0;
+    /// DME `MPHY_TX_FSM_STATE` (selector = lane).
+    pub const MPHY_TX_FSM_STATE: u16 = 0x0041;
+    /// `MPHY_TX_FSM_STATE` value once the PHY reached HIBERN8 after HCE.
+    pub const TX_FSM_HIBERN8: u32 = 1;
+    /// DME `DME_VS_CORE_CLK_CTRL`.
+    pub const DME_VS_CORE_CLK_CTRL: u16 = 0xd002;
+    /// `DME_VS_CORE_CLK_CTRL` cycles-per-µs field (HW major < 4).
+    pub const CLK_1US_CYCLES_MASK: u32 = 0xff;
+    /// `DME_VS_CORE_CLK_CTRL` `CORE_CLK_DIV_EN`.
+    pub const CORE_CLK_DIV_EN: u32 = 1 << 8;
+
+    /// Major field of `HW_VERSION`.
+    pub fn hw_major(ver: u32) -> u32 {
+        ver >> 28
+    }
+}
diff --git a/drivers/ufs-core/src/scsi.rs b/drivers/ufs-core/src/scsi.rs
new file mode 100644
index 00000000..d898f41e
--- /dev/null
+++ b/drivers/ufs-core/src/scsi.rs
@@ -0,0 +1,251 @@
+//! Read-only SCSI over COMMAND UPIUs (`specs/ufs.md` §4 "SCSI").
+
+use crate::hc::Ufshc;
+use crate::{dma, upiu};
+use crate::{Delay, Dma, Error, Result};
+use mmio_replay::Mmio;
+
+/// The only opcodes this driver will ever put in a CDB.
+pub const ALLOWED_OPCODES: [u8; 5] = [0x00, 0x03, 0x12, 0x25, 0x28];
+
+/// SCSI status CHECK CONDITION.
+const CHECK_CONDITION: u8 = 0x02;
+/// Sense key UNIT ATTENTION.
+pub const UNIT_ATTENTION: u8 = 0x06;
+
+/// Read-only command set.
+#[derive(Clone, Copy, Debug, PartialEq, Eq)]
+pub enum Cmd {
+    /// TEST UNIT READY.
+    TestUnitReady,
+    /// REQUEST SENSE (18 bytes, fixed format).
+    RequestSense,
+    /// INQUIRY (36 bytes standard data).
+    Inquiry,
+    /// READ CAPACITY(10) (8 bytes).
+    ReadCapacity10,
+    /// READ(10).
+    Read10 {
+        /// First logical block.
+        lba: u32,
+        /// Block count.
+        blocks: u16,
+    },
+}
+
+impl Cmd {
+    /// The 16-byte CDB field of the COMMAND UPIU.
+    pub fn cdb(&self) -> [u8; 16] {
+        let mut c = [0u8; 16];
+        match *self {
+            Cmd::TestUnitReady => {}
+            Cmd::RequestSense => {
+                c[0] = 0x03;
+                c[4] = 18;
+            }
+            Cmd::Inquiry => {
+                c[0] = 0x12;
+                c[4] = 36;
+            }
+            Cmd::ReadCapacity10 => c[0] = 0x25,
+            Cmd::Read10 { lba, blocks } => {
+                c[0] = 0x28;
+                c[2..6].copy_from_slice(&lba.to_be_bytes());
+                c[7..9].copy_from_slice(&blocks.to_be_bytes());
+            }
+        }
+        c
+    }
+
+    /// Expected data-in length.
+    pub fn data_len(&self, block_size: u32) -> usize {
+        match *self {
+            Cmd::TestUnitReady => 0,
+            Cmd::RequestSense => 18,
+            Cmd::Inquiry => 36,
+            Cmd::ReadCapacity10 => 8,
+            Cmd::Read10 { blocks, .. } => blocks as usize * block_size as usize,
+        }
+    }
+}
+
+/// Decoded sense data.
+#[derive(Clone, Copy, Debug, Default, PartialEq, Eq)]
+pub struct Sense {
+    /// Sense key.
+    pub key: u8,
+    /// Additional sense code.
+    pub asc: u8,
+    /// Additional sense code qualifier.
+    pub ascq: u8,
+}
+
+/// Parse fixed (0x70/0x71) or descriptor (0x72/0x73) format sense data.
+pub fn parse_sense(b: &[u8]) -> Sense {
+    let at = |i: usize| b.get(i).copied().unwrap_or(0);
+    match at(0) & 0x7f {
+        0x72 | 0x73 => Sense {
+            key: at(1) & 0xf,
+            asc: at(2),
+            ascq: at(3),
+        },
+        _ => Sense {
+            key: at(2) & 0xf,
+            asc: at(12),
+            ascq: at(13),
+        },
+    }
+}
+
+/// READ CAPACITY(10) result.
+#[derive(Clone, Copy, Debug, PartialEq, Eq)]
+pub struct Capacity {
+    /// Last addressable LBA.
+    pub last_lba: u32,
+    /// Block length in bytes.
+    pub block_size: u32,
+}
+
+impl<M: Mmio, D: Dma, T: Delay> Ufshc<M, D, T> {
+    /// Run an allowlisted command on a regular LU; data-in lands in `out`. Returns bytes received.
+    pub fn scsi(&mut self, lun: u8, cmd: Cmd, block_size: u32, out: &mut [u8]) -> Result<usize> {
+        self.scsi_raw(lun, &cmd.cdb(), cmd.data_len(block_size), out)
+    }
+
+    /// Run a raw CDB. Anything whose opcode is not in [`ALLOWED_OPCODES`] is refused before
+    /// any register or DMA access.
+    pub fn scsi_raw(
+        &mut self,
+        lun: u8,
+        cdb: &[u8],
+        data_len: usize,
+        out: &mut [u8],
+    ) -> Result<usize> {
+        let op = *cdb.first().ok_or(Error::InvalidArgument)?;
+        if !ALLOWED_OPCODES.contains(&op) {
+            return Err(Error::Refused(op));
+        }
+        if cdb.len() > 16 || lun > 0x7f || data_len > out.len() {
+            return Err(Error::InvalidArgument);
+        }
+        let mut c = [0u8; 16];
+        c[..cdb.len()].copy_from_slice(cdb);
+        for attempt in 0..2 {
+            let tag = self.next_tag();
+            let done = self.transfer(&upiu::command(tag, lun, data_len as u32, &c), data_len)?;
+            let hdr = upiu::parse_header(&done.resp);
+            if hdr.response != 0 {
+                return Err(Error::Response(hdr.response));
+            }
+            match hdr.status {
+                0 => {
+                    let r = &done.resp;
+                    let residual = u32::from_be_bytes([r[12], r[13], r[14], r[15]]) as usize;
+                    let got = data_len.saturating_sub(residual);
+                    self.copy_data(&mut out[..got]);
+                    return Ok(got);
+                }
+                CHECK_CONDITION => {
+                    let sense = parse_sense(upiu::sense(&done.resp));
+                    if sense.key == UNIT_ATTENTION && attempt == 0 {
+                        continue;
+                    }
+                    return Err(Error::CheckCondition(sense));
+                }
+                s => return Err(Error::ScsiStatus(s)),
+            }
+        }
+        unreachable!("loop returns on its second attempt")
+    }
+
+    /// READ CAPACITY(10).
+    pub fn read_capacity(&mut self, lun: u8) -> Result<Capacity> {
+        let mut b = [0u8; 8];
+        let got = self.scsi(lun, Cmd::ReadCapacity10, 0, &mut b)?;
+        if got != 8 {
+            return Err(Error::ShortTransfer(got));
+        }
+        Ok(Capacity {
+            last_lba: u32::from_be_bytes([b[0], b[1], b[2], b[3]]),
+            block_size: u32::from_be_bytes([b[4], b[5], b[6], b[7]]),
+        })
+    }
+
+    /// READ(10) whole blocks starting at `lba` into `buf`, chunked to the DMA buffer.
+    pub fn read(&mut self, lun: u8, lba: u64, block_size: u32, buf: &mut [u8]) -> Result<()> {
+        let bs = block_size as usize;
+        if bs == 0 || !buf.len().is_multiple_of(bs) {
+            return Err(Error::InvalidArgument);
+        }
+        let per = (dma::data_capacity(self.dma.size()) / bs).min(u16::MAX as usize);
+        if per == 0 || lba + (buf.len() / bs) as u64 > u32::MAX as u64 + 1 {
+            return Err(Error::InvalidArgument);
+        }
+        let mut lba = lba as u32;
+        for chunk in buf.chunks_mut(per * bs) {
+            let blocks = (chunk.len() / bs) as u16;
+            let got = self.scsi(lun, Cmd::Read10 { lba, blocks }, block_size, chunk)?;
+            if got != chunk.len() {
+                return Err(Error::ShortTransfer(got));
+            }
+            lba = lba.wrapping_add(blocks as u32);
+        }
+        Ok(())
+    }
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    #[test]
+    fn cdbs_are_read_only_and_well_formed() {
+        let r = Cmd::Read10 {
+            lba: 0x0102_0304,
+            blocks: 2,
+        }
+        .cdb();
+        assert_eq!(&r[..10], &[0x28, 0, 1, 2, 3, 4, 0, 0, 2, 0]);
+        assert_eq!(Cmd::Read10 { lba: 0, blocks: 3 }.data_len(4096), 12288);
+        for c in [
+            Cmd::TestUnitReady,
+            Cmd::RequestSense,
+            Cmd::Inquiry,
+            Cmd::ReadCapacity10,
+            Cmd::Read10 { lba: 0, blocks: 1 },
+        ] {
+            assert!(ALLOWED_OPCODES.contains(&c.cdb()[0]));
+        }
+        // No write-class opcode can sneak into the allowlist.
+        for op in [
+            0x0a, 0x2a, 0x2e, 0x35, 0x41, 0x42, 0x8a, 0x91, 0x93, 0xaa, 0x55, 0x15, 0x1b, 0x3b,
+        ] {
+            assert!(!ALLOWED_OPCODES.contains(&op), "opcode {op:#x}");
+        }
+    }
+
+    #[test]
+    fn sense_fixed_and_descriptor_formats() {
+        let mut f = [0u8; 18];
+        f[0] = 0x70;
+        f[2] = 0x06;
+        f[12] = 0x29;
+        assert_eq!(
+            parse_sense(&f),
+            Sense {
+                key: 6,
+                asc: 0x29,
+                ascq: 0
+            }
+        );
+        assert_eq!(
+            parse_sense(&[0x72, 0x05, 0x24, 0x01]),
+            Sense {
+                key: 5,
+                asc: 0x24,
+                ascq: 1
+            }
+        );
+        assert_eq!(parse_sense(&[]), Sense::default());
+    }
+}
