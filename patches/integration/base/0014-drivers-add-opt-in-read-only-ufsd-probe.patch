diff --git a/drivers/ufsd/README.md b/drivers/ufsd/README.md
new file mode 100644
index 00000000..85bb70f5
--- /dev/null
+++ b/drivers/ufsd/README.md
@@ -0,0 +1,17 @@
+# ufsd — read-only UFS bring-up probe
+
+Opt-in daemon: it starts only when the kernel device tree declares a
+`qcom,sdm845-ufshc` node, and it exits after one probe session.
+
+It drives `drivers/ufs-core` (vendored from the `redox-oneplus6` repo,
+`crates/ufs`) through the read-only bring-up of `specs/ufs.md` §4–5:
+HCE cycle, DME link startup, NOP OUT/IN, `fDeviceInit`, LU enumeration,
+READ CAPACITY, one READ(10) of LBA 0..33, then CRC-checked GPT parsing
+with the ESP entry printed. The command builder is closed over the SCSI
+allowlist `{TEST_UNIT_READY, REQUEST_SENSE, INQUIRY, READ_CAPACITY(10),
+READ(10)}`; no WRITE-class opcode can reach the bus.
+
+On the qemu-oneplus6 emulator the QCOM vendor DME attributes are not
+modelled, so `DME_GET(MPHY_TX_FSM_STATE)` never reports HIBERN8; ufsd logs
+that gap and retries the bring-up without the Qualcomm vendor register
+path. On a phone with a real PHY the first attempt succeeds.
diff --git a/drivers/ufsd/src/main.rs b/drivers/ufsd/src/main.rs
new file mode 100644
index 00000000..4730b5f6
--- /dev/null
+++ b/drivers/ufsd/src/main.rs
@@ -0,0 +1,200 @@
+//! Read-only UFS bring-up probe: HCE cycle, link startup, NOP, READ CAPACITY,
+//! LBA 0..33 read, GPT/ESP listing. Start only when the device tree declares
+//! a Qualcomm UFS host controller; every other opcode class is refused by
+//! ufs-core before any access (see drivers/ufs-core/src/scsi.rs).
+#[cfg(any(target_os = "redox", feature = "host-compile"))]
+mod redox {
+    use std::error::Error;
+    use std::time::Duration;
+    use std::{fs, thread};
+
+    use common::dma::Dma as DmaRegion;
+    use common::{MemoryType, PhysBorrowed, Prot};
+    use mmio_replay::{Mmio, Width};
+    use ufs_core::{gpt, Config, Delay, Dma, Error as UfsError, Ufshc};
+
+    /// `ufshc@1d84000` standard register window (DT `reg` first cell, 0x2500).
+    const HC_BASE: u64 = 0x1d84_0000;
+    const HC_LEN: usize = 0x2500;
+    /// UTRL + UCD + one data-in buffer; 34 x 512 B fits in a single PRDT.
+    const DMA_LEN: usize = 64 * 1024;
+    const BLOCK: usize = 512;
+
+    /// ESP partition type GUID {C12A7328-F81F-11D2-BA-7B-00-A0-C3-00-AD-3D}, on-disk order.
+    const ESP_TYPE: [u8; 16] = [
+        0x28, 0x73, 0x2a, 0xc1, 0x1f, 0xf8, 0xd2, 0x11, 0xba, 0x7b, 0x00, 0xa0, 0xc3, 0x00, 0xad,
+        0x3d,
+    ];
+
+    struct HcWindow {
+        base: u64,
+        len: usize,
+        map: PhysBorrowed,
+    }
+    impl HcWindow {
+        fn new(base: u64, len: usize) -> Result<Self, Box<dyn Error>> {
+            let map = PhysBorrowed::map(
+                base as usize,
+                len,
+                Prot {
+                    read: true,
+                    write: true,
+                },
+                MemoryType::DeviceMemory,
+            )?;
+            Ok(Self { base, len, map })
+        }
+        fn contains(&self, addr: u64) -> bool {
+            addr >= self.base
+                && addr
+                    .checked_add(4)
+                    .is_some_and(|end| end <= self.base + self.len as u64)
+        }
+        fn ptr(&self, addr: u64) -> *mut u32 {
+            assert!(self.contains(addr) && addr % 4 == 0);
+            unsafe { (self.map.as_ptr() as *mut u8).add((addr - self.base) as usize) as *mut u32 }
+        }
+    }
+    impl Mmio for HcWindow {
+        fn read(&mut self, addr: u64, width: Width) -> u64 {
+            assert_eq!(width, Width::W32);
+            unsafe { self.ptr(addr).read_volatile() as u64 }
+        }
+        fn write(&mut self, addr: u64, width: Width, value: u64) {
+            assert_eq!(width, Width::W32);
+            unsafe { self.ptr(addr).write_volatile(value as u32) }
+        }
+    }
+
+    struct DmaWindow {
+        region: DmaRegion<[u8]>,
+    }
+    impl Dma for DmaWindow {
+        fn phys(&self) -> u64 {
+            self.region.physical() as u64
+        }
+        fn size(&self) -> usize {
+            self.region.len()
+        }
+        fn read(&mut self, off: usize, buf: &mut [u8]) {
+            buf.copy_from_slice(&self.region[off..off + buf.len()]);
+        }
+        fn write(&mut self, off: usize, data: &[u8]) {
+            self.region[off..off + data.len()].copy_from_slice(data);
+        }
+    }
+
+    struct Sleep;
+    impl Delay for Sleep {
+        fn delay_us(&mut self, us: u32) {
+            thread::sleep(Duration::from_micros(us as u64));
+        }
+    }
+
+    pub fn run() -> Result<(), Box<dyn Error>> {
+        common::init();
+        let dtb = fs::read("/scheme/kernel.dtb")?;
+        let dt = fdt::Fdt::new(&dtb).map_err(|e| format!("invalid device tree: {e:?}"))?;
+        if dt.find_compatible(&["qcom,sdm845-ufshc"]).is_none() {
+            eprintln!("ufsd: no Qualcomm UFS host controller in device tree; skipping");
+            return Ok(());
+        }
+        eprintln!("ufsd: qcom,sdm845-ufshc declared; starting read-only probe");
+
+        let window = HcWindow::new(HC_BASE, HC_LEN)?;
+        let region = unsafe { DmaRegion::<[u8]>::zeroed_slice(DMA_LEN)?.assume_init() };
+        let dma = DmaWindow { region };
+
+        let mut hc = Ufshc::new(window, HC_BASE, dma, Sleep, Config::sdm845())
+            .map_err(|e| format!("ufsd: DMA region rejected: {e:?}"))?;
+        if let Err(e) = hc.enable() {
+            match e {
+                UfsError::PhyNotReady(state) => {
+                    eprintln!(
+                        "ufsd: emulator gap: DME_GET(MPHY_TX_FSM_STATE)=0x{state:x} is not HIBERN8 (QCOM vendor DME attributes are not modelled); retrying without the vendor path"
+                    );
+                    let (window, dma) = hc.into_parts();
+                    let mut cfg = Config::sdm845();
+                    cfg.qcom = None;
+                    hc = Ufshc::new(window, HC_BASE, dma, Sleep, cfg)
+                        .map_err(|e| format!("ufsd: DMA region rejected: {e:?}"))?;
+                    hc.enable().map_err(|e| format!("ufsd: HCE enable: {e:?}"))?;
+                }
+                e => return Err(format!("ufsd: HCE enable: {e:?}").into()),
+            }
+        }
+        let info = hc.info();
+        eprintln!(
+            "ufsd: HCE enabled: CAP=0x{:08x} VER=0x{:x} HW_VERSION=0x{:08x}",
+            info.cap, info.ver, info.qcom_hw_version
+        );
+
+        hc.link_startup()
+            .map_err(|e| format!("ufsd: link startup: {e:?}"))?;
+        eprintln!("ufsd: link startup OK (HCS.DP set)");
+        hc.start_list()
+            .map_err(|e| format!("ufsd: UTRL start: {e:?}"))?;
+        eprintln!("ufsd: UTRL list running");
+        hc.nop().map_err(|e| format!("ufsd: NOP: {e:?}"))?;
+        eprintln!("ufsd: NOP OUT/IN OK");
+        hc.device_init()
+            .map_err(|e| format!("ufsd: fDeviceInit: {e:?}"))?;
+        eprintln!("ufsd: fDeviceInit done");
+
+        let device = hc.enumerate().map_err(|e| format!("ufsd: enumerate: {e:?}"))?;
+        eprintln!(
+            "ufsd: device: spec 0x{:04x} mfr 0x{:04x} number_of_lu {}",
+            device.spec_version, device.manufacturer_id, device.number_lu
+        );
+        for lu in &device.units {
+            eprintln!(
+                "ufsd: LU{}: {} x {} B write_protect={} boot_lun_id={}",
+                lu.lun, lu.block_count, lu.block_size, lu.write_protect, lu.boot_lun_id
+            );
+        }
+
+        let capacity = hc
+            .read_capacity(0)
+            .map_err(|e| format!("ufsd: READ CAPACITY: {e:?}"))?;
+        eprintln!(
+            "ufsd: READ CAPACITY LUN0: last_lba={} block_size={}",
+            capacity.last_lba, capacity.block_size
+        );
+
+        let mut buf = vec![0u8; 34 * BLOCK];
+        hc.read(0, 0, BLOCK as u32, &mut buf)
+            .map_err(|e| format!("ufsd: READ LBA 0..33: {e:?}"))?;
+        eprintln!("ufsd: READ LBA 0..33 OK (34 x 512 B)");
+
+        let header = gpt::parse_header(&buf[BLOCK..2 * BLOCK])
+            .map_err(|e| format!("ufsd: GPT header: {e:?}"))?;
+        eprintln!(
+            "ufsd: GPT header at LBA 1: \"EFI PART\" entries_lba={} entries={} entry_size={}",
+            header.entries_lba, header.num_entries, header.entry_size
+        );
+        let entries = gpt::parse_entries(&header, &buf[2 * BLOCK..])
+            .map_err(|e| format!("ufsd: GPT entries: {e:?}"))?;
+        for entry in &entries {
+            let kind = if entry.type_guid == ESP_TYPE {
+                "ESP entry"
+            } else {
+                "partition entry"
+            };
+            eprintln!(
+                "ufsd: {kind} {}: name=\"{}\" lba {}..{}",
+                entry.index, entry.name, entry.first_lba, entry.last_lba
+            );
+        }
+        eprintln!("ufsd: done: read-only session, no WRITE opcode was sent");
+        Ok(())
+    }
+}
+
+#[cfg(any(target_os = "redox", feature = "host-compile"))]
+fn main() -> Result<(), Box<dyn std::error::Error>> {
+    redox::run()
+}
+#[cfg(not(any(target_os = "redox", feature = "host-compile")))]
+fn main() {
+    eprintln!("ufsd requires Redox aarch64; use ufs-core tests on the host");
+}
