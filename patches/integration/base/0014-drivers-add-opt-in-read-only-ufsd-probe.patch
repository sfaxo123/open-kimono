diff --git a/drivers/ufs-core/tests/negative_bringup.rs b/drivers/ufs-core/tests/negative_bringup.rs
new file mode 100644
index 00000000..197ec04c
--- /dev/null
+++ b/drivers/ufs-core/tests/negative_bringup.rs
@@ -0,0 +1,145 @@
+//! Bring-up failure paths: each ends in a typed error before the list runs.
+
+mod common;
+
+use common::model::UfsModel;
+use common::{config, phone_device, rig, SharedDma, BASE, DMA_PHYS};
+use mmio_replay::{Replayer, Trace};
+use ufs_core::regs;
+use ufs_core::{Error, NoDelay, Stage, Ufshc};
+
+fn up(m: &mut UfsModel, d: SharedDma) -> Ufshc<&mut UfsModel, SharedDma, NoDelay> {
+    let mut hc = Ufshc::new(m, BASE, d, NoDelay, config()).unwrap();
+    hc.bring_up().unwrap();
+    hc
+}
+
+fn bring_up_err(f: impl FnOnce(&mut UfsModel)) -> (Error, UfsModel) {
+    let (mut m, d) = rig(phone_device());
+    f(&mut m);
+    let e = Ufshc::new(&mut m, BASE, d, NoDelay, config())
+        .unwrap()
+        .bring_up()
+        .unwrap_err();
+    (e, m)
+}
+
+#[test]
+fn link_startup_failure_reports_uic_result() {
+    let (e, m) = bring_up_err(|m| m.hw.link_result = 0x01);
+    assert_eq!(
+        e,
+        Error::Uic {
+            opcode: regs::DME_LINKSTARTUP,
+            result: 1
+        }
+    );
+    assert!(!m.link_up && m.rsr == 0, "list never started");
+}
+
+#[test]
+fn link_up_without_device_present() {
+    assert_eq!(bring_up_err(|m| m.hw.no_device = true).0, Error::NoDevice);
+}
+
+#[test]
+fn dead_phy_is_detected_before_link_startup() {
+    let (e, m) = bring_up_err(|m| m.hw.phy_dead = true);
+    assert_eq!(e, Error::PhyNotReady(0));
+    assert_eq!(
+        m.uic_log.len(),
+        config().polls.phy as usize,
+        "bounded HIBERN8 polling"
+    );
+    assert!(m.uic_log.iter().all(|u| u.0 == regs::DME_GET));
+}
+
+#[test]
+fn hce_enable_and_disable_timeouts() {
+    assert_eq!(
+        bring_up_err(|m| m.hw.hce_stuck_off = true).0,
+        Error::Timeout(Stage::HceEnable)
+    );
+    let (e, _) = bring_up_err(|m| {
+        m.hce = true;
+        m.hw.hce_stuck_on = true;
+    });
+    assert_eq!(e, Error::Timeout(Stage::HceDisable));
+}
+
+#[test]
+fn uic_command_that_never_completes() {
+    assert_eq!(
+        bring_up_err(|m| m.hw.uic_silent = true).0,
+        Error::Timeout(Stage::UicComplete)
+    );
+}
+
+#[test]
+fn list_not_ready_after_link_startup() {
+    assert_eq!(
+        bring_up_err(|m| m.hw.list_not_ready = true).0,
+        Error::ListNotReady
+    );
+}
+
+#[test]
+fn nop_failing_every_attempt_returns_last_ocs() {
+    let (e, m) = bring_up_err(|m| m.dev.faults.nop_ocs = vec![0x05; 10]);
+    assert_eq!(e, Error::Ocs(0x05));
+    assert_eq!(m.dev.seen.len(), config().nop_attempts as usize);
+}
+
+#[test]
+fn device_init_that_never_clears() {
+    let (e, _) = bring_up_err(|m| m.dev.faults.device_init_busy = u32::MAX);
+    assert_eq!(e, Error::Timeout(Stage::DeviceInit));
+}
+
+#[test]
+fn descriptor_with_wrong_idn_is_rejected() {
+    assert_eq!(
+        bring_up_err(|m| m.dev.faults.wrong_idn = Some(0x09)).0,
+        Error::Descriptor(0x00)
+    );
+}
+
+#[test]
+fn dma_layout_and_capability_checks() {
+    let r = || Replayer::strict(Trace::new());
+    let small = SharedDma::new(DMA_PHYS, 0x1000);
+    assert!(matches!(
+        Ufshc::new(r(), BASE, small, NoDelay, config()),
+        Err(Error::DmaLayout)
+    ));
+    let unaligned = SharedDma::new(DMA_PHYS + 0x80, 0x2000);
+    assert!(matches!(
+        Ufshc::new(r(), BASE, unaligned, NoDelay, config()),
+        Err(Error::DmaLayout)
+    ));
+
+    let high = SharedDma::new(0x1_8000_0000, 0x1000 + 0x10000);
+    let mut m = UfsModel::sdm845(high.clone(), phone_device());
+    m.cap &= !regs::CAP_64AS;
+    let e = Ufshc::new(&mut m, BASE, high, NoDelay, config())
+        .unwrap()
+        .bring_up();
+    assert_eq!(e, Err(Error::Unsupported("64-bit addressing")));
+
+    let (mut m, d) = rig(phone_device());
+    m.cap |= regs::CAP_LSDBS;
+    let e = Ufshc::new(&mut m, BASE, d, NoDelay, config())
+        .unwrap()
+        .bring_up();
+    assert_eq!(e, Err(Error::Unsupported("single doorbell")));
+}
+
+#[test]
+fn bring_up_on_a_32_lun_device_scans_all_32() {
+    let mut dev = phone_device();
+    dev.max_lu_code = 1;
+    let (mut m, d) = rig(dev);
+    let info = up(&mut m, d).enumerate().unwrap();
+    assert_eq!(info.max_lu, 32);
+    assert_eq!(info.units.len(), 3);
+}
diff --git a/drivers/ufs-core/tests/negative_io.rs b/drivers/ufs-core/tests/negative_io.rs
new file mode 100644
index 00000000..725e678b
--- /dev/null
+++ b/drivers/ufs-core/tests/negative_io.rs
@@ -0,0 +1,224 @@
+//! Transfer, SCSI, refusal and GPT failure paths: typed errors, no slot left outstanding.
+
+mod common;
+
+use common::model::UfsModel;
+use common::{config, dma, phone_device, rig, SharedDma, BASE};
+use mmio_replay::{Replayer, Trace};
+use ufs_core::gpt::GptError;
+use ufs_core::regs;
+use ufs_core::scsi::{Cmd, Sense};
+use ufs_core::{Error, NoDelay, Stage, Ufshc};
+
+fn up(m: &mut UfsModel, d: SharedDma) -> Ufshc<&mut UfsModel, SharedDma, NoDelay> {
+    let mut hc = Ufshc::new(m, BASE, d, NoDelay, config()).unwrap();
+    hc.bring_up().unwrap();
+    hc
+}
+
+#[test]
+fn ocs_error_on_a_command() {
+    let (mut m, d) = rig(phone_device());
+    up(&mut m, d.clone());
+    m.dev.faults.command_ocs = Some(0x08);
+    let mut hc = Ufshc::new(&mut m, BASE, d, NoDelay, config()).unwrap();
+    assert_eq!(hc.read_capacity(0), Err(Error::Ocs(0x08)));
+}
+
+#[test]
+fn doorbell_timeout_clears_the_slot_and_recovers() {
+    let (mut m, d) = rig(phone_device());
+    up(&mut m, d.clone());
+    m.hw.hang_doorbell = true;
+    let mut hc = Ufshc::new(&mut m, BASE, d.clone(), NoDelay, config()).unwrap();
+    assert_eq!(hc.read_capacity(0), Err(Error::Timeout(Stage::Doorbell)));
+    drop(hc);
+    assert_eq!(m.dbr, 0, "UTRLCLR (0 bit) released slot 0");
+    m.hw.hang_doorbell = false;
+    let mut hc = Ufshc::new(&mut m, BASE, d, NoDelay, config()).unwrap();
+    assert_eq!(
+        hc.read_capacity(0).unwrap().last_lba,
+        63,
+        "next command succeeds"
+    );
+}
+
+#[test]
+fn slot_that_ignores_clear_times_out_in_clear() {
+    let (mut m, d) = rig(phone_device());
+    up(&mut m, d.clone());
+    m.hw.hang_doorbell = true;
+    m.hw.clear_ignored = true;
+    let mut hc = Ufshc::new(&mut m, BASE, d, NoDelay, config()).unwrap();
+    assert_eq!(hc.read_capacity(0), Err(Error::Timeout(Stage::Clear)));
+}
+
+#[test]
+fn fatal_interrupt_status_aborts_the_transfer() {
+    let (mut m, d) = rig(phone_device());
+    up(&mut m, d.clone());
+    m.hw.fatal_is = Some(regs::IS_HCFES);
+    let mut hc = Ufshc::new(&mut m, BASE, d, NoDelay, config()).unwrap();
+    assert_eq!(hc.read_capacity(0), Err(Error::Fatal(regs::IS_HCFES)));
+    drop(hc);
+    assert_eq!(m.dbr, 0);
+}
+
+#[test]
+fn scsi_check_conditions() {
+    let mut dev = phone_device();
+    dev.faults.read_error = Some((0x03, 0x11));
+    let (mut m, d) = rig(dev);
+    let mut hc = up(&mut m, d);
+    let mut b = vec![0u8; 4096];
+    let medium = Error::CheckCondition(Sense {
+        key: 3,
+        asc: 0x11,
+        ascq: 0,
+    });
+    assert_eq!(hc.read(0, 0, 4096, &mut b), Err(medium));
+    // Unsupported / disabled LU → ILLEGAL REQUEST, LOGICAL UNIT NOT SUPPORTED.
+    let lu = Error::CheckCondition(Sense {
+        key: 5,
+        asc: 0x25,
+        ascq: 0,
+    });
+    assert_eq!(hc.read_capacity(2), Err(lu));
+}
+
+#[test]
+fn read_past_the_end_of_a_lu() {
+    let (mut m, d) = rig(phone_device());
+    let mut hc = up(&mut m, d);
+    let mut b = vec![0u8; 2 * 4096];
+    let e = Error::CheckCondition(Sense {
+        key: 5,
+        asc: 0x21,
+        ascq: 0,
+    });
+    assert_eq!(hc.read(0, 63, 4096, &mut b), Err(e));
+}
+
+#[test]
+fn short_data_in_is_reported() {
+    let (mut m, d) = rig(phone_device());
+    up(&mut m, d.clone());
+    m.dev.faults.residual = Some(4);
+    let mut hc = Ufshc::new(&mut m, BASE, d, NoDelay, config()).unwrap();
+    assert_eq!(hc.read_capacity(0), Err(Error::ShortTransfer(4)));
+}
+
+#[test]
+fn mismatched_task_tag_is_rejected() {
+    let (mut m, d) = rig(phone_device());
+    up(&mut m, d.clone());
+    m.dev.faults.bad_tag = true;
+    let mut hc = Ufshc::new(&mut m, BASE, d, NoDelay, config()).unwrap();
+    assert_eq!(hc.read_capacity(0), Err(Error::BadUpiu));
+}
+
+#[test]
+fn query_errors_surface_the_response_code() {
+    let (mut m, d) = rig(phone_device());
+    let mut hc = up(&mut m, d);
+    assert_eq!(hc.read_descriptor(0x55, 0), Err(Error::Response(0xfd)));
+    assert_eq!(hc.read_descriptor(0x02, 8), Err(Error::Response(0xfc)));
+}
+
+/// A replayer with an empty trace fails on the first access: proves "nothing was sent".
+fn silent() -> Ufshc<Replayer, SharedDma, NoDelay> {
+    Ufshc::new(
+        Replayer::strict(Trace::new()),
+        BASE,
+        dma(),
+        NoDelay,
+        config(),
+    )
+    .unwrap()
+}
+
+#[test]
+fn write_class_opcodes_are_refused_without_any_access() {
+    let mut hc = silent();
+    let mut buf = [0u8; 4096];
+    // WRITE(6/10/16), WRITE SAME, SYNC CACHE, UNMAP, START STOP, MODE SELECT, FORMAT, WRITE BUFFER.
+    for op in [
+        0x0a, 0x2a, 0x8a, 0x41, 0x35, 0x42, 0x1b, 0x55, 0x04, 0x3b, 0xa0,
+    ] {
+        assert_eq!(
+            hc.scsi_raw(0, &[op, 0, 0, 0, 0, 0, 0, 0, 1, 0], 4096, &mut buf),
+            Err(Error::Refused(op))
+        );
+    }
+    assert!(hc.into_parts().0.finish().ok());
+}
+
+#[test]
+fn invalid_arguments_make_no_access() {
+    let mut hc = silent();
+    let mut buf = [0u8; 4096];
+    assert_eq!(
+        hc.scsi_raw(0x81, &[0x00], 0, &mut buf),
+        Err(Error::InvalidArgument),
+        "W-LUN"
+    );
+    assert_eq!(
+        hc.scsi_raw(0, &[], 0, &mut buf),
+        Err(Error::InvalidArgument)
+    );
+    assert_eq!(
+        hc.scsi_raw(0, &[0x28; 17], 0, &mut buf),
+        Err(Error::InvalidArgument)
+    );
+    assert_eq!(
+        hc.scsi(0, Cmd::Read10 { lba: 0, blocks: 2 }, 4096, &mut buf),
+        Err(Error::InvalidArgument)
+    );
+    assert_eq!(
+        hc.read(0, 0, 4096, &mut buf[..100]),
+        Err(Error::InvalidArgument)
+    );
+    assert_eq!(
+        hc.read(0, 0, 0, &mut buf),
+        Err(Error::InvalidArgument),
+        "zero block size"
+    );
+    let past = u32::MAX as u64 + 1;
+    assert_eq!(
+        hc.read(0, past, 4096, &mut buf),
+        Err(Error::InvalidArgument),
+        "beyond READ(10) LBA range"
+    );
+    let big = 0x2_0000 + 4096;
+    let mut huge = vec![0u8; big];
+    assert_eq!(
+        hc.scsi(
+            0,
+            Cmd::Read10 {
+                lba: 0,
+                blocks: (big / 4096) as u16
+            },
+            4096,
+            &mut huge
+        ),
+        Err(Error::InvalidArgument),
+        "beyond DMA buffer"
+    );
+    assert!(hc.into_parts().0.finish().ok());
+}
+
+#[test]
+fn lu_without_gpt_and_corrupt_gpts() {
+    let (mut m, d) = rig(phone_device());
+    up(&mut m, d.clone());
+    let mut hc = Ufshc::new(&mut m, BASE, d.clone(), NoDelay, config()).unwrap();
+    assert_eq!(hc.read_gpt(3, 4096), Err(Error::Gpt(GptError::Signature)));
+    drop(hc);
+    m.dev.luns[0].data[4096 + 40] ^= 1; // first_usable inside the CRC-covered header
+    let mut hc = Ufshc::new(&mut m, BASE, d.clone(), NoDelay, config()).unwrap();
+    assert_eq!(hc.read_gpt(0, 4096), Err(Error::Gpt(GptError::HeaderCrc)));
+    drop(hc);
+    m.dev.luns[1].data[2 * 4096 + 60] ^= 1; // a partition name byte
+    let mut hc = Ufshc::new(&mut m, BASE, d, NoDelay, config()).unwrap();
+    assert_eq!(hc.read_gpt(1, 4096), Err(Error::Gpt(GptError::EntriesCrc)));
+}
diff --git a/drivers/ufs-core/tests/replay.rs b/drivers/ufs-core/tests/replay.rs
new file mode 100644
index 00000000..2a1408b3
--- /dev/null
+++ b/drivers/ufs-core/tests/replay.rs
@@ -0,0 +1,157 @@
+//! Golden MMIO trace: bring-up + GPT reads recorded against the model, frozen in
+//! `tests/fixtures/bringup_gpt.trace` (JSONL; `*.jsonl` is gitignored in this repo) and replayed
+//! strictly. Re-bless after an intended sequence change with `UFS_BLESS=1 cargo test`.
+//! This is also the reference a phone-recorded trace is diffed against (`specs/ufs.md` §7).
+
+mod common;
+
+use common::device::UfsDevice;
+use common::{config, phone_device, rig, SharedDma, BASE};
+use mmio_replay::{Compare, MismatchKind, Mmio, Op, Recorder, Replayer, Trace, Width};
+use ufs_core::gpt::Gpt;
+use ufs_core::regs::{self, qcom};
+use ufs_core::{Config, DeviceInfo, Error, NoDelay, Ufshc};
+
+const FIXTURE: &str = concat!(
+    env!("CARGO_MANIFEST_DIR"),
+    "/tests/fixtures/bringup_gpt.trace"
+);
+
+/// Replays register reads from a trace and runs the device model on each doorbell write,
+/// standing in for the DMA side effects a register trace cannot carry.
+struct Harness {
+    rep: Replayer,
+    dev: UfsDevice,
+    dma: SharedDma,
+    utrlba: u64,
+}
+
+impl Mmio for Harness {
+    fn read(&mut self, addr: u64, width: Width) -> u64 {
+        self.rep.read(addr, width)
+    }
+    fn write(&mut self, addr: u64, width: Width, value: u64) {
+        self.rep.write(addr, width, value);
+        match addr - BASE {
+            regs::UTRLBA => self.utrlba = (self.utrlba & !0xffff_ffff) | value,
+            regs::UTRLBAU => self.utrlba = (self.utrlba & 0xffff_ffff) | value << 32,
+            regs::UTRLDBR => {
+                for slot in (0..32).filter(|s| value & (1 << s) != 0) {
+                    self.dev.process(&self.dma, self.utrlba + 32 * slot);
+                }
+            }
+            _ => {}
+        }
+    }
+}
+
+type Session = Result<(DeviceInfo, Gpt, Gpt), Error>;
+
+fn session<M: Mmio>(io: M, dma: SharedDma, cfg: Config) -> (Session, M) {
+    let mut hc = Ufshc::new(io, BASE, dma, NoDelay, cfg).unwrap();
+    let mut run = || -> Session {
+        let info = hc.bring_up()?;
+        Ok((info, hc.read_gpt(0, 4096)?, hc.read_gpt(1, 4096)?))
+    };
+    let r = run();
+    (r, hc.into_parts().0)
+}
+
+fn record() -> (Trace, (DeviceInfo, Gpt, Gpt)) {
+    let (mut m, dma) = rig(phone_device());
+    let (r, rec) = session(Recorder::new(&mut m), dma, config());
+    (rec.into_trace(), r.unwrap())
+}
+
+fn golden() -> Trace {
+    let text = std::fs::read_to_string(FIXTURE).expect("fixture missing: run with UFS_BLESS=1");
+    Trace::from_jsonl(&text).unwrap()
+}
+
+fn replay(mode: Compare, cfg: Config) -> (Session, mmio_replay::ReplayReport) {
+    let dma = common::dma();
+    let h = Harness {
+        rep: Replayer::new(golden(), mode),
+        dev: phone_device(),
+        dma: dma.clone(),
+        utrlba: 0,
+    };
+    let (r, mut h) = session(h, dma, cfg);
+    (r, h.rep.finish())
+}
+
+#[test]
+fn recorded_trace_matches_the_frozen_fixture() {
+    let text = record().0.to_jsonl();
+    if std::env::var_os("UFS_BLESS").is_some() {
+        std::fs::create_dir_all(std::path::Path::new(FIXTURE).parent().unwrap()).unwrap();
+        std::fs::write(FIXTURE, &text).unwrap();
+    }
+    assert_eq!(
+        text,
+        std::fs::read_to_string(FIXTURE).unwrap(),
+        "MMIO sequence drifted; re-bless if intended"
+    );
+}
+
+#[test]
+fn strict_replay_of_the_fixture_reproduces_the_session() {
+    let (_, expected) = record();
+    let (got, report) = replay(Compare::Strict, config());
+    assert!(report.ok(), "{report:?}");
+    assert_eq!(report.warnings(), 0);
+    assert_eq!(got.unwrap(), expected);
+}
+
+#[test]
+fn strict_replay_catches_a_changed_register_value() {
+    let mut cfg = config();
+    cfg.qcom = Some(ufs_core::Qcom {
+        unipro_core_clk_mhz: 100,
+    });
+    let (_, report) = replay(Compare::Strict, cfg);
+    assert!(!report.ok());
+    assert!(report
+        .mismatches
+        .iter()
+        .any(|m| m.kind == MismatchKind::WriteValue));
+    // Lenient mode tolerates the different value as a warning.
+    let (got, report) = replay(Compare::Lenient, cfg);
+    assert!(
+        report.ok() && report.warnings() > 0 && got.is_ok(),
+        "{report:?}"
+    );
+}
+
+#[test]
+fn golden_trace_only_writes_allowlisted_registers() {
+    let allowed = [
+        regs::IE,
+        regs::HCE,
+        regs::IS,
+        regs::UCMDARG1,
+        regs::UCMDARG2,
+        regs::UCMDARG3,
+        regs::UICCMD,
+        regs::UTRLBA,
+        regs::UTRLBAU,
+        regs::UTRLRSR,
+        regs::UTRLDBR,
+        qcom::CFG1,
+    ];
+    let t = golden();
+    let writes: Vec<_> = t.events.iter().filter(|e| e.op == Op::Write).collect();
+    assert!(writes.iter().all(|e| allowed.contains(&(e.addr - BASE))));
+    assert!(t.events.iter().all(|e| e.width == Width::W32));
+    // One SET_FLAG; every doorbell rings slot 0 only.
+    let bells = writes
+        .iter()
+        .filter(|e| e.addr == BASE + regs::UTRLDBR)
+        .count();
+    assert!(writes
+        .iter()
+        .filter(|e| e.addr == BASE + regs::UTRLDBR)
+        .all(|e| e.value == 1));
+    // NOP, SET_FLAG, READ_FLAG, device, geometry, 8 units, then 2 × (header + entries).
+    assert_eq!(bells, 1 + 1 + 1 + 2 + 8 + 2 * 2);
+}
