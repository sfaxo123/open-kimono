From 18400fdeffcbc1e7741261dc8e6d23e1596601d0 Mon Sep 17 00:00:00 2001
From: x <x@y.z>
Date: Sat, 24 Oct 2026 23:46:08 +0000
Subject: [PATCH 10/10] ramboot: start inputd before vesad

Co-Authored-By: Codex <noreply@openai.com>
---
 Makefile                        | 3 ++-
 init.initfs.d/90_ramboot.target | 2 +-
 2 files changed, 3 insertions(+), 2 deletions(-)

diff --git a/Makefile b/Makefile
index c2115a35..eb777880 100644
--- a/Makefile
+++ b/Makefile
@@ -15,7 +15,7 @@ BUILD_FLAGS +=  --target-dir $(BUILD_DIR)
 INITFS_BINS = ipcd init logd ramfs randd zerod \
 	acpid fbbootlogd hwd inputd lived \
 	pcid pcid-spawner rtcd vesad
-RAMBOOT_BINS = ipcd init logd ramfs randd zerod rtcd ramsh spmid vesad geni-i2cd rmi4d
+RAMBOOT_BINS = ipcd init logd ramfs randd zerod rtcd ramsh spmid inputd vesad geni-i2cd rmi4d
 INITFS_DRIVERS_BINS = nvmed virtio-blkd  virtio-gpud
 BASE_BINS = fbcond getty inputd pcid pcid-spawner redoxerd audiod dhcpd ptyd netstack nbdd
 DRIVERS_BINS = e1000d ihdad ihdgd ixgbed rtl8139d rtl8168d \
@@ -152,6 +152,7 @@ ramboot-initfs:
 	cp "$(SRC_DIR)/init.initfs.d"/00_* "$(SRC_DIR)/init.initfs.d"/ramfs@.service \
 		"$(SRC_DIR)/init.initfs.d"/30_ramsh.service \
 		"$(SRC_DIR)/init.initfs.d"/30_spmid.service \
+		"$(SRC_DIR)/init.initfs.d"/10_inputd.service \
 		"$(SRC_DIR)/init.initfs.d"/20_vesad.service \
 		"$(SRC_DIR)/init.initfs.d"/90_ramboot.target "$(BUILD_DIR)/ramboot-initfs/lib/init.d/"
 	$(CARGO_HOST) run --manifest-path "$(SRC_DIR)/initfs/tools/Cargo.toml" --bin redox-initfs-ar -- \
diff --git a/init.initfs.d/90_ramboot.target b/init.initfs.d/90_ramboot.target
index 08333941..21620f79 100644
--- a/init.initfs.d/90_ramboot.target
+++ b/init.initfs.d/90_ramboot.target
@@ -1,3 +1,3 @@
 [unit]
 description = "RAM-only boot shell"
-requires_weak = ["20_vesad.service", "30_ramsh.service", "30_spmid.service"]
+requires_weak = ["10_inputd.service", "20_vesad.service", "30_ramsh.service", "30_spmid.service"]
-- 
