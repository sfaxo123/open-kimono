+use super::*;
+
+/// Minimal flattened device tree writer (DT spec v17 layout).
+#[derive(Default)]
+struct Builder {
+    structs: Vec<u8>,
+    strings: Vec<u8>,
+}
+
+impl Builder {
+    fn word(&mut self, v: u32) {
+        self.structs.extend_from_slice(&v.to_be_bytes());
+    }
+
+    fn pad(&mut self) {
+        while !self.structs.len().is_multiple_of(4) {
+            self.structs.push(0);
+        }
+    }
+
+    fn begin(&mut self, name: &str) -> &mut Self {
+        self.word(1);
+        self.structs.extend_from_slice(name.as_bytes());
+        self.structs.push(0);
+        self.pad();
+        self
+    }
+
+    fn end(&mut self) -> &mut Self {
+        self.word(2);
+        self
+    }
+
+    fn prop(&mut self, name: &str, value: &[u8]) -> &mut Self {
+        let nameoff = self.strings.len() as u32;
+        self.strings.extend_from_slice(name.as_bytes());
+        self.strings.push(0);
+        self.word(3);
+        self.word(value.len() as u32);
+        self.word(nameoff);
+        self.structs.extend_from_slice(value);
+        self.pad();
+        self
+    }
+
+    fn cells(&mut self, name: &str, cells: &[u32]) -> &mut Self {
+        let value: Vec<u8> = cells.iter().flat_map(|c| c.to_be_bytes()).collect();
+        self.prop(name, &value)
+    }
+
+    fn string(&mut self, name: &str, s: &str) -> &mut Self {
+        let mut value = s.as_bytes().to_vec();
+        value.push(0);
+        self.prop(name, &value)
+    }
+
+    fn finish(mut self) -> Vec<u8> {
+        self.word(9);
+        let rsvmap = 40;
+        let off_struct = rsvmap + 16;
+        let off_strings = off_struct + self.structs.len();
+        let total = off_strings + self.strings.len();
+        let header = [
+            0xd00d_feed,
+            total as u32,
+            off_struct as u32,
+            off_strings as u32,
+            rsvmap as u32,
+            17,
+            16,
+            0,
+            self.strings.len() as u32,
+            self.structs.len() as u32,
+        ];
+        let mut out: Vec<u8> = header.iter().flat_map(|w| w.to_be_bytes()).collect();
+        out.extend_from_slice(&[0; 16]);
+        out.extend_from_slice(&self.structs);
+        out.extend_from_slice(&self.strings);
+        out
+    }
+}
+
+const SPLASH_BASE: u32 = 0x9d40_0000;
+const SPLASH_SIZE: u32 = 0x0240_0000;
+
+/// The OnePlus 6 layout: framebuffer in `/chosen`, base via `memory-region`.
+fn tree(splash_size: u32, fb: impl FnOnce(&mut Builder)) -> Vec<u8> {
+    let mut b = Builder::default();
+    b.begin("")
+        .cells("#address-cells", &[2])
+        .cells("#size-cells", &[2]);
+    b.begin("chosen")
+        .cells("#address-cells", &[2])
+        .cells("#size-cells", &[2])
+        .prop("ranges", &[]);
+    b.begin("framebuffer");
+    fb(&mut b);
+    b.end().end();
+    b.begin("reserved-memory")
+        .cells("#address-cells", &[2])
+        .cells("#size-cells", &[2])
+        .prop("ranges", &[]);
+    b.begin("splash@9d400000")
+        .cells("reg", &[0, SPLASH_BASE, 0, splash_size])
+        .prop("no-map", &[])
+        .cells("phandle", &[1]);
+    b.end().end().end();
+    b.finish()
+}
+
+fn op6_props(b: &mut Builder) {
+    b.string("compatible", "simple-framebuffer")
+        .cells("memory-region", &[1])
+        .string("format", "a8r8g8b8")
+        .cells("stride", &[1080 * 4])
+        .cells("width", &[1080])
+        .cells("height", &[2280]);
+}
+
+const OP6: SimpleFb = SimpleFb {
+    phys: 0x9d40_0000,
+    width: 1080,
+    height: 2280,
+    stride: 1080,
+    format: Format::A8R8G8B8,
+};
+
+#[test]
+fn op6_memory_region() {
+    let fb = find(&tree(SPLASH_SIZE, op6_props)).unwrap().unwrap();
+    assert_eq!(fb, OP6);
+    assert_eq!(fb.size(), 1080 * 2280 * 4);
+}
+
+#[test]
+fn reg_without_memory_region() {
+    let dtb = tree(SPLASH_SIZE, |b| {
+        b.string("compatible", "simple-framebuffer")
+            .cells("reg", &[0, 0x5e00_0000, 0, 0x30_0000])
+            .string("format", "x8r8g8b8")
+            .cells("stride", &[1024 * 4])
+            .cells("width", &[1024])
+            .cells("height", &[768]);
+    });
+    let fb = find(&dtb).unwrap().unwrap();
+    assert_eq!(
+        fb,
+        SimpleFb {
+            phys: 0x5e00_0000,
+            width: 1024,
+            height: 768,
+            stride: 1024,
+            format: Format::X8R8G8B8,
+        }
+    );
+}
+
+#[test]
+fn memory_region_overrides_reg() {
+    let dtb = tree(SPLASH_SIZE, |b| {
+        op6_props(b);
+        b.cells("reg", &[0, 0x5e00_0000, 0, 0x30_0000]);
+    });
+    assert_eq!(find(&dtb).unwrap().unwrap().phys, 0x9d40_0000);
+}
+
+#[test]
+fn padded_stride_is_kept() {
+    let dtb = tree(SPLASH_SIZE, |b| {
+        b.string("compatible", "simple-framebuffer")
+            .cells("memory-region", &[1])
+            .string("format", "a8r8g8b8")
+            .cells("stride", &[1088 * 4])
+            .cells("width", &[1080])
+            .cells("height", &[2280]);
+    });
+    let fb = find(&dtb).unwrap().unwrap();
+    assert_eq!((fb.width, fb.stride), (1080, 1088));
+}
+
+#[test]
+fn okay_status_is_used() {
+    let dtb = tree(SPLASH_SIZE, |b| {
+        op6_props(b);
+        b.string("status", "okay");
+    });
+    assert_eq!(find(&dtb).unwrap(), Some(OP6));
+}
+
+#[test]
+fn disabled_node_is_ignored() {
+    let dtb = tree(SPLASH_SIZE, |b| {
+        op6_props(b);
+        b.string("status", "disabled");
+    });
+    assert_eq!(find(&dtb).unwrap(), None);
+}
+
+#[test]
+fn other_compatible_is_ignored() {
+    let dtb = tree(SPLASH_SIZE, |b| {
+        b.string("compatible", "vendor,not-a-framebuffer");
+    });
+    assert_eq!(find(&dtb).unwrap(), None);
+}
+
+#[test]
+fn no_chosen_node() {
+    let mut b = Builder::default();
+    b.begin("").cells("#address-cells", &[2]).end();
+    assert_eq!(find(&b.finish()).unwrap(), None);
+}
+
+#[test]
+fn unsupported_format() {
+    let dtb = tree(SPLASH_SIZE, |b| {
+        b.string("compatible", "simple-framebuffer")
+            .cells("memory-region", &[1])
+            .string("format", "r5g6b5")
+            .cells("stride", &[1080 * 2])
+            .cells("width", &[1080])
+            .cells("height", &[2280]);
+    });
+    assert_eq!(
+        find(&dtb),
+        Err(Error::UnsupportedFormat("r5g6b5".to_owned()))
+    );
+}
+
+#[test]
+fn stride_smaller_than_row() {
+    let dtb = tree(SPLASH_SIZE, |b| {
+        b.string("compatible", "simple-framebuffer")
+            .cells("memory-region", &[1])
+            .string("format", "a8r8g8b8")
+            .cells("stride", &[1080])
+            .cells("width", &[1080])
+            .cells("height", &[2280]);
+    });
+    assert_eq!(find(&dtb), Err(Error::BadGeometry));
+}
+
+#[test]
+fn region_too_small() {
+    let dtb = tree(0x10_0000, op6_props);
+    assert_eq!(
+        find(&dtb),
+        Err(Error::RegionTooSmall {
+            needed: 1080 * 2280 * 4,
+            region: 0x10_0000,
+        })
+    );
+}
+
+#[test]
+fn unaligned_base() {
+    let dtb = tree(SPLASH_SIZE, |b| {
+        b.string("compatible", "simple-framebuffer")
+            .cells("reg", &[0, 0x5e00_0100, 0, 0x30_0000])
+            .string("format", "a8r8g8b8")
+            .cells("stride", &[1024 * 4])
+            .cells("width", &[1024])
+            .cells("height", &[768]);
+    });
+    assert_eq!(find(&dtb), Err(Error::Unaligned(0x5e00_0100)));
+}
+
+#[test]
+fn dangling_memory_region() {
+    let dtb = tree(SPLASH_SIZE, |b| {
+        b.string("compatible", "simple-framebuffer")
+            .cells("memory-region", &[7])
+            .string("format", "a8r8g8b8")
+            .cells("stride", &[1080 * 4])
+            .cells("width", &[1080])
+            .cells("height", &[2280]);
+    });
+    assert_eq!(find(&dtb), Err(Error::BadMemoryRegion));
+}
+
+#[test]
+fn missing_height() {
+    let dtb = tree(SPLASH_SIZE, |b| {
+        b.string("compatible", "simple-framebuffer")
+            .cells("memory-region", &[1])
+            .string("format", "a8r8g8b8")
+            .cells("stride", &[1080 * 4])
+            .cells("width", &[1080]);
+    });
+    assert_eq!(find(&dtb), Err(Error::MissingProperty("height")));
+}
+
+#[test]
+fn not_a_dtb() {
+    assert_eq!(find(b"not a device tree"), Err(Error::InvalidDtb));
+}
+
+/// Set `SIMPLEFB_ENCHILADA_DTB` to a DTB compiled from Linux
+/// `arch/arm64/boot/dts/qcom/sdm845-oneplus-enchilada.dts`.
+#[test]
+fn enchilada_dtb_from_env() {
+    let Ok(path) = std::env::var("SIMPLEFB_ENCHILADA_DTB") else {
+        eprintln!("SIMPLEFB_ENCHILADA_DTB not set; skipping");
+        return;
+    };
+    let dtb = std::fs::read(path).unwrap();
+    assert_eq!(find(&dtb).unwrap(), Some(OP6));
+}
