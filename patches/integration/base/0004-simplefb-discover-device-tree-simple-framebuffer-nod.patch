@@ -0,0 +1,168 @@
+//! Discovery of a firmware-initialized framebuffer described by a device tree
+//! `simple-framebuffer` node (binding: `display/simple-framebuffer.yaml`).
+//!
+//! The node is looked up among the children of `/chosen`, where Linux, U-Boot
+//! and the OnePlus 6 device tree place it. The framebuffer base comes from the
+//! first `memory-region` phandle if present, otherwise from `reg`.
+
+use std::fmt;
+
+use fdt::node::FdtNode;
+use fdt::Fdt;
+
+/// Mapping granularity of `/scheme/memory/physical`.
+const PAGE_SIZE: usize = 4096;
+
+/// Pixel formats that match the BGRA32 layout vesad and its clients assume.
+#[derive(Clone, Copy, Debug, Eq, PartialEq)]
+pub enum Format {
+    A8R8G8B8,
+    X8R8G8B8,
+}
+
+impl Format {
+    fn from_dt(name: &str) -> Option<Self> {
+        match name {
+            "a8r8g8b8" => Some(Self::A8R8G8B8),
+            "x8r8g8b8" => Some(Self::X8R8G8B8),
+            _ => None,
+        }
+    }
+}
+
+#[derive(Clone, Copy, Debug, Eq, PartialEq)]
+pub struct SimpleFb {
+    pub phys: usize,
+    pub width: usize,
+    pub height: usize,
+    /// Pixels per scanline (the unit of `FRAMEBUFFER_STRIDE`), not the DT's bytes.
+    pub stride: usize,
+    pub format: Format,
+}
+
+impl SimpleFb {
+    /// Bytes of the visible framebuffer, which may be smaller than its region.
+    pub fn size(&self) -> usize {
+        self.stride * self.height * 4
+    }
+}
+
+#[derive(Debug, Eq, PartialEq)]
+pub enum Error {
+    InvalidDtb,
+    MissingProperty(&'static str),
+    UnsupportedFormat(String),
+    BadMemoryRegion,
+    BadGeometry,
+    RegionTooSmall { needed: usize, region: usize },
+    Unaligned(usize),
+}
+
+impl fmt::Display for Error {
+    fn fmt(&self, f: &mut fmt::Formatter<'_>) -> fmt::Result {
+        match self {
+            Self::InvalidDtb => write!(f, "invalid device tree blob"),
+            Self::MissingProperty(name) => write!(f, "missing property '{name}'"),
+            Self::UnsupportedFormat(name) => write!(f, "unsupported format '{name}'"),
+            Self::BadMemoryRegion => write!(f, "memory-region does not resolve to a reg"),
+            Self::BadGeometry => write!(f, "inconsistent width/height/stride"),
+            Self::RegionTooSmall { needed, region } => {
+                write!(f, "needs {needed:#x} bytes but region is {region:#x}")
+            }
+            Self::Unaligned(phys) => write!(f, "base {phys:#x} is not page aligned"),
+        }
+    }
+}
+
+impl std::error::Error for Error {}
+
+/// Returns `Ok(None)` when the tree has no enabled `simple-framebuffer` under `/chosen`.
+pub fn find(dtb: &[u8]) -> Result<Option<SimpleFb>, Error> {
+    let dt = Fdt::new(dtb).map_err(|_| Error::InvalidDtb)?;
+    let Some(chosen) = dt.find_node("/chosen") else {
+        return Ok(None);
+    };
+    let Some(node) = chosen
+        .children()
+        .find(|node| is_simplefb(node) && is_available(node))
+    else {
+        return Ok(None);
+    };
+    parse_node(&dt, node).map(Some)
+}
+
+fn is_simplefb(node: &FdtNode) -> bool {
+    node.compatible()
+        .is_some_and(|compat| compat.all().any(|c| c == "simple-framebuffer"))
+}
+
+fn is_available(node: &FdtNode) -> bool {
+    match node.property("status").and_then(|p| p.as_str()) {
+        None => true,
+        Some(status) => status == "okay" || status == "ok",
+    }
+}
+
+fn u32_prop(node: &FdtNode, name: &'static str) -> Result<usize, Error> {
+    node.property(name)
+        .filter(|p| p.value.len() == 4)
+        .and_then(|p| p.as_usize())
+        .ok_or(Error::MissingProperty(name))
+}
+
+fn first_reg(node: &FdtNode) -> Option<(usize, Option<usize>)> {
+    let region = node.reg()?.next()?;
+    Some((region.starting_address as usize, region.size))
+}
+
+fn parse_node(dt: &Fdt, node: FdtNode) -> Result<SimpleFb, Error> {
+    let width = u32_prop(&node, "width")?;
+    let height = u32_prop(&node, "height")?;
+    let stride_bytes = u32_prop(&node, "stride")?;
+    let format_name = node
+        .property("format")
+        .and_then(|p| p.as_str())
+        .ok_or(Error::MissingProperty("format"))?;
+    let format = Format::from_dt(format_name)
+        .ok_or_else(|| Error::UnsupportedFormat(format_name.to_owned()))?;
+
+    let (phys, region_size) = match node.property("memory-region") {
+        Some(prop) => {
+            let phandle = prop
+                .value
+                .get(..4)
+                .map(|b| u32::from_be_bytes([b[0], b[1], b[2], b[3]]))
+                .ok_or(Error::BadMemoryRegion)?;
+            dt.find_phandle(phandle)
+                .and_then(|region| first_reg(&region))
+                .ok_or(Error::BadMemoryRegion)?
+        }
+        None => first_reg(&node).ok_or(Error::MissingProperty("reg"))?,
+    };
+
+    if width == 0 || height == 0 || !stride_bytes.is_multiple_of(4) || stride_bytes < width * 4 {
+        return Err(Error::BadGeometry);
+    }
+    let fb = SimpleFb {
+        phys,
+        width,
+        height,
+        stride: stride_bytes / 4,
+        format,
+    };
+    if let Some(region) = region_size {
+        if fb.size() > region {
+            return Err(Error::RegionTooSmall {
+                needed: fb.size(),
+                region,
+            });
+        }
+    }
+    if !phys.is_multiple_of(PAGE_SIZE) {
+        return Err(Error::Unaligned(phys));
+    }
+    Ok(fb)
+}
+
