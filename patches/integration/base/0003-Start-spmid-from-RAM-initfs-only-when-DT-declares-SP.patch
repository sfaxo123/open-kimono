From ef40656a84169b4e87e1277baaaa7acefb518ea4 Mon Sep 17 00:00:00 2001
From: x <x@y.z>
Date: Sat, 24 Oct 2026 23:35:37 +0000
Subject: [PATCH 03/10] Start spmid from RAM initfs only when DT declares SPMI

Probe the device tree before mapping fixed SDM845 windows, so QEMU exits cleanly without SPMI hardware. Include the daemon and its unit in the drive-free initfs.

Co-Authored-By: Codex <noreply@openai.com>
---
 Cargo.lock                      |  1 +
 Makefile                        |  3 ++-
 drivers/spmid/Cargo.toml        |  1 +
 drivers/spmid/README.md         |  4 ++--
 drivers/spmid/src/main.rs       | 19 +++++++++++++++++--
 init.initfs.d/30_spmid.service  |  6 ++++++
 init.initfs.d/90_ramboot.target |  2 +-
 7 files changed, 30 insertions(+), 6 deletions(-)
 create mode 100644 init.initfs.d/30_spmid.service

diff --git a/Cargo.lock b/Cargo.lock
index d82e3e9a..0432734c 100644
--- a/Cargo.lock
+++ b/Cargo.lock
@@ -2495,6 +2495,7 @@ name = "spmid"
 version = "0.1.0"
 dependencies = [
  "common",
+ "fdt 0.1.5",
  "inputd",
  "mmio-replay",
  "orbclient",
diff --git a/Makefile b/Makefile
index 369b9612..b05afba8 100644
--- a/Makefile
+++ b/Makefile
@@ -15,7 +15,7 @@ BUILD_FLAGS +=  --target-dir $(BUILD_DIR)
 INITFS_BINS = ipcd init logd ramfs randd zerod \
 	acpid fbbootlogd hwd inputd lived \
 	pcid pcid-spawner rtcd vesad
-RAMBOOT_BINS = ipcd init logd ramfs randd zerod rtcd ramsh
+RAMBOOT_BINS = ipcd init logd ramfs randd zerod rtcd ramsh spmid
 INITFS_DRIVERS_BINS = nvmed virtio-blkd  virtio-gpud
 BASE_BINS = fbcond getty inputd pcid pcid-spawner redoxerd audiod dhcpd ptyd netstack nbdd
 DRIVERS_BINS = e1000d ihdad ihdgd ixgbed rtl8139d rtl8168d \
@@ -151,6 +151,7 @@ ramboot-initfs:
 	done
 	cp "$(SRC_DIR)/init.initfs.d"/00_* "$(SRC_DIR)/init.initfs.d"/ramfs@.service \
 		"$(SRC_DIR)/init.initfs.d"/30_ramsh.service \
+		"$(SRC_DIR)/init.initfs.d"/30_spmid.service \
 		"$(SRC_DIR)/init.initfs.d"/90_ramboot.target "$(BUILD_DIR)/ramboot-initfs/lib/init.d/"
 	$(CARGO_HOST) run --manifest-path "$(SRC_DIR)/initfs/tools/Cargo.toml" --bin redox-initfs-ar -- \
 		"$(BUILD_DIR)/ramboot-initfs" "$(TARGET_DIR)/bootstrap" -o "$(BUILD_DIR)/ramboot-initfs.img"
