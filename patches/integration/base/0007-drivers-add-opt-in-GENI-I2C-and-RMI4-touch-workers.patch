--- /dev/null
+++ b/drivers/geni-i2cd/src/main.rs
@@ -0,0 +1,23 @@
+//! GENI i2c12 diagnostic worker. Owns the bus only while explicitly invoked.
+#[cfg(target_os = "redox")]
+mod hardware {
+    include!("hardware.inc");
+}
+#[cfg(target_os = "redox")]
+fn main() -> Result<(), Box<dyn std::error::Error>> {
+    use geni_i2c_core::{Bus, Geni};
+    // No autonomous probing: the bus is shared with rmi4d until an IPC owner exists.
+    if std::env::args().nth(1).as_deref() != Some("--probe-rmi4") {
+        return Err("explicit --probe-rmi4 required".into());
+    }
+    let mut bus = Geni::new(hardware::Mapped::open()?, 0xa90000);
+    let mut descriptor = [0u8; 6];
+    bus.write_read(0x20, &[0xe9], &mut descriptor)
+        .map_err(|e| format!("{e:?}"))?;
+    println!("PDT first descriptor: {descriptor:02x?}");
+    Ok(())
+}
+#[cfg(not(target_os = "redox"))]
+fn main() {
+    eprintln!("geni-i2cd requires Redox aarch64; use core replay tests on the host");
+}
