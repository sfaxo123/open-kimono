+# GENI I2C12 diagnostic process
+
+This opt-in Redox process maps 0x00a90000 and reads the first s3706b PDT entry when invoked with `--probe-rmi4`. It is a diagnostic for validating the FIFO controller, not a shared bus scheme. Do not run it while `rmi4d` owns I2C12. No automatic startup is configured. The core crate in `../geni-i2c-core` has strict register replay tests.
diff --git a/drivers/geni-i2cd/src/hardware.inc b/drivers/geni-i2cd/src/hardware.inc
new file mode 100644
index 00000000..e1a4eafc
--- /dev/null
+++ b/drivers/geni-i2cd/src/hardware.inc
@@ -0,0 +1,33 @@
+use std::ptr::{read_volatile, write_volatile};
+
+use common::{MemoryType, PhysBorrowed, Prot};
+use mmio_replay::{Mmio, Width};
+pub struct Mapped {
+    _region: PhysBorrowed,
+    ptr: *mut u8,
+}
+impl Mapped {
+    pub fn open() -> Result<Self, Box<dyn std::error::Error>> {
+        let region = PhysBorrowed::map(0xa90000, 0x1000, Prot::RW, MemoryType::DeviceMemory)?;
+        let ptr = region.as_ptr().cast();
+        Ok(Self {
+            _region: region,
+            ptr,
+        })
+    }
+}
+impl Mmio for Mapped {
+    fn read(&mut self, addr: u64, width: Width) -> u64 {
+        assert_eq!(width, Width::W32);
+        unsafe { read_volatile(self.ptr.add((addr - 0xa90000) as usize).cast::<u32>()) as u64 }
+    }
+    fn write(&mut self, addr: u64, width: Width, value: u64) {
+        assert_eq!(width, Width::W32);
+        unsafe {
+            write_volatile(
+                self.ptr.add((addr - 0xa90000) as usize).cast::<u32>(),
+                value as u32,
+            )
+        }
+    }
+}
diff --git a/drivers/geni-i2cd/src/main.rs b/drivers/geni-i2cd/src/main.rs
