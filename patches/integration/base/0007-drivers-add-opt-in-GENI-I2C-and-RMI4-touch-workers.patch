@@ -0,0 +1,71 @@
+//! RMI4 touch producer. Disabled unless a verified Data1 descriptor is supplied.
+#[cfg(target_os = "redox")]
+mod hardware {
+    include!("../../geni-i2cd/src/hardware.inc");
+}
+#[cfg(target_os = "redox")]
+fn main() -> Result<(), Box<dyn std::error::Error>> {
+    use std::time::Duration;
+
+    use geni_i2c_core::Geni;
+    use inputd::ProducerHandle;
+    use orbclient::{ButtonEvent, MouseEvent};
+    use rmi4_touch_core::{Data1, Rmi4};
+    let args: Vec<String> = std::env::args().collect();
+    if args.len() != 3 {
+        return Err("usage: rmi4d DATA1_OFFSET SLOTS (oracle-verified)".into());
+    }
+    let offset = args[1].parse::<u8>()?;
+    let slots = args[2].parse::<u8>()?;
+    let descriptor = Data1::checked(offset, slots).map_err(|e| format!("{e:?}"))?;
+    let bus = Geni::new(hardware::Mapped::open()?, 0xa90000);
+    let mut touch = Rmi4::discover(bus).map_err(|e| format!("{e:?}"))?;
+    touch.set_data1(descriptor);
+    let mut input = ProducerHandle::new()?;
+    let mut pressed = false;
+    loop {
+        let contacts = match touch.poll() {
+            Ok(contacts) => contacts,
+            Err(e) => {
+                if pressed {
+                    input.write_event(
+                        ButtonEvent {
+                            left: false,
+                            right: false,
+                            middle: false,
+                        }
+                        .to_event(),
+                    )?;
+                }
+                return Err(format!("{e:?}").into());
+            }
+        };
+        let first = contacts.first();
+        if let Some(point) = first {
+            input.write_event(
+                MouseEvent {
+                    x: i32::from(point.x),
+                    y: i32::from(point.y),
+                }
+                .to_event(),
+            )?;
+        }
+        let next = first.is_some();
+        if next != pressed {
+            input.write_event(
+                ButtonEvent {
+                    left: next,
+                    right: false,
+                    middle: false,
+                }
+                .to_event(),
+            )?;
+            pressed = next;
+        }
+        std::thread::sleep(Duration::from_millis(16));
+    }
+}
+#[cfg(not(target_os = "redox"))]
+fn main() {
+    eprintln!("rmi4d requires Redox aarch64; use core replay tests on the host");
+}
