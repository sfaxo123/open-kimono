diff --git a/drivers/mmio-replay/src/lib.rs b/drivers/mmio-replay/src/lib.rs
new file mode 100644
index 00000000..91286fc3
--- /dev/null
+++ b/drivers/mmio-replay/src/lib.rs
@@ -0,0 +1,71 @@
+//! `mmio-replay` — MMIO trait + recorder/replayer of register traces.
+//!
+//! Part of the Redox-on-OnePlus-6 "emulator first" rule (docs/PLAN.md,
+//! VISION "Emulator first"): the OnePlus 6's peripherals are not modelled by
+//! QEMU, so drivers are developed against **register traces replayed from the
+//! real phone** (recorded later by the pmOS oracle, `scripts/oracle/`).
+//!
+//! A driver takes a `&mut impl [`Mmio`]` instead of touching pointers:
+//!
+//! - production: the real register window;
+//! - host test: a [`MemModel`] register model, a [`Recorder`] wrapping one
+//!   (to capture a trace), or a [`Replayer`] feeding a recorded trace back to
+//!   the driver and comparing every transaction against it.
+//!
+//! Traces are JSONL — one flat JSON object per transaction:
+//!
+//! ```text
+//! {"op":"w","width":32,"addr":"0xa84010","value":"0x2","delay_us":0}
+//! {"op":"r","width":32,"addr":"0xa84018","value":"0x40000000","delay_us":12}
+//! ```
+//!
+//! `op` is `"r"`/`"w"`, `width` is 8/16/32/64, `addr`/`value` are hex
+//! strings (decimal numbers are also accepted), `delay_us` is the time since
+//! the previous event and is optional.
+//!
+//! Compare modes on the [`Replayer`]:
+//!
+//! - [`Compare::Strict`]: every transaction must match the next recorded
+//!   event exactly (op, width, address, and written value); the first
+//!   deviation fails the replay.
+//! - [`Compare::Lenient`]: structure must match — a driver may write values
+//!   that differ from the recording (logged as warnings) and may skip
+//!   recorded events, but touching a register that is not in the trace fails.
+//!
+//! ```
+//! use mmio_replay::{Compare, MemModel, Mmio, Recorder, Replayer};
+//!
+//! // Record a reference run against a register model…
+//! let mut model = MemModel::new();
+//! model.load(0xa84e24, &[0x10, 0x00, 0x00, 0x00]); // firmware-left state
+//! let mut rec = Recorder::new(&mut model);
+//! rec.write_u32(0xa84010, 1);
+//! assert_eq!(rec.read_u32(0xa84e24), 0x10);
+//! let trace = rec.into_trace();
+//!
+//! // …freeze it as JSONL…
+//! let text = trace.to_jsonl();
+//! let trace = mmio_replay::Trace::from_jsonl(&text).unwrap();
+//!
+//! // …and replay it strictly against the driver.
+//! let mut rep = Replayer::strict(trace);
+//! rep.write_u32(0xa84010, 1);
+//! assert_eq!(rep.read_u32(0xa84e24), 0x10); // recorded value comes back
+//! assert!(rep.finish().ok());
+//! ```
+
+#![no_std]
+#![forbid(unsafe_code)]
+#![deny(missing_docs)]
+
+extern crate alloc;
+
+mod mmio;
+mod recorder;
+mod replayer;
+mod trace;
+
+pub use mmio::{MemModel, Mmio, Op, Width};
+pub use recorder::Recorder;
+pub use replayer::{Compare, Mismatch, MismatchKind, ObservedAccess, ReplayReport, Replayer};
+pub use trace::{Event, ParseError, Trace};
diff --git a/drivers/mmio-replay/src/mmio.rs b/drivers/mmio-replay/src/mmio.rs
new file mode 100644
index 00000000..bdfc4873
--- /dev/null
+++ b/drivers/mmio-replay/src/mmio.rs
@@ -0,0 +1,239 @@
+//! The MMIO access trait and a sparse byte-memory model.
+//!
+//! Drivers never touch `volatile` pointers directly: they take a `&mut impl
+//! Mmio` (or `&mut dyn Mmio`). In production that is backed by the real
+//! register window; in host tests it is backed by [`MemModel`] (a plain
+//! sparse memory), a [`crate::Recorder`] around one, or a
+//! [`crate::Replayer`] replaying a trace recorded on the phone.
+
+use alloc::collections::BTreeMap;
+
+/// Access width of one MMIO transaction.
+#[derive(Clone, Copy, PartialEq, Eq, Debug)]
+pub enum Width {
+    /// 8-bit access.
+    W8,
+    /// 16-bit access.
+    W16,
+    /// 32-bit access (the common Qualcomm register width).
+    W32,
+    /// 64-bit access.
+    W64,
+}
+
+impl Width {
+    /// Width in bits.
+    pub fn bits(self) -> u32 {
+        match self {
+            Width::W8 => 8,
+            Width::W16 => 16,
+            Width::W32 => 32,
+            Width::W64 => 64,
+        }
+    }
+
+    /// Width in bytes.
+    pub fn bytes(self) -> usize {
+        (self.bits() / 8) as usize
+    }
+
+    /// Decode from a bit count (8, 16, 32 or 64).
+    pub fn from_bits(bits: u32) -> Option<Width> {
+        match bits {
+            8 => Some(Width::W8),
+            16 => Some(Width::W16),
+            32 => Some(Width::W32),
+            64 => Some(Width::W64),
+            _ => None,
+        }
+    }
+
+    /// Bitmask of the low `bits()` bits, e.g. `W16 -> 0xffff`.
+    pub fn mask(self) -> u64 {
+        match self {
+            Width::W64 => u64::MAX,
+            w => (1u64 << w.bits()) - 1,
+        }
+    }
+}
+
+/// Direction of one MMIO transaction.
+#[derive(Clone, Copy, PartialEq, Eq, Debug)]
+pub enum Op {
+    /// Read transaction.
+    Read,
+    /// Write transaction.
+    Write,
+}
+
+/// A memory-mapped register window a driver can touch.
+///
+/// All values are transferred little-endian; `write` must ignore the bits of
+/// `value` above `width`. Implementations must not reorder or coalesce
+/// transactions — trace replay depends on one event per call.
+pub trait Mmio {
+    /// Read `width` bits at `addr`.
+    fn read(&mut self, addr: u64, width: Width) -> u64;
+
+    /// Write the low `width` bits of `value` at `addr`.
+    fn write(&mut self, addr: u64, width: Width, value: u64);
+
+    /// `W8` read.
+    fn read_u8(&mut self, addr: u64) -> u8 {
+        self.read(addr, Width::W8) as u8
+    }
+
+    /// `W16` read.
+    fn read_u16(&mut self, addr: u64) -> u16 {
+        self.read(addr, Width::W16) as u16
+    }
+
+    /// `W32` read.
+    fn read_u32(&mut self, addr: u64) -> u32 {
+        self.read(addr, Width::W32) as u32
+    }
+
+    /// `W64` read.
+    fn read_u64(&mut self, addr: u64) -> u64 {
+        self.read(addr, Width::W64)
+    }
+
+    /// `W8` write.
+    fn write_u8(&mut self, addr: u64, value: u8) {
+        self.write(addr, Width::W8, value as u64)
+    }
+
+    /// `W16` write.
+    fn write_u16(&mut self, addr: u64, value: u16) {
+        self.write(addr, Width::W16, value as u64)
+    }
+
+    /// `W32` write.
+    fn write_u32(&mut self, addr: u64, value: u32) {
+        self.write(addr, Width::W32, value as u64)
+    }
+
+    /// `W64` write.
+    fn write_u64(&mut self, addr: u64, value: u64) {
+        self.write(addr, Width::W64, value)
+    }
+}
+
+/// A sparse little-endian byte memory: a simple device model for host tests
+/// (pre-load reset values with [`MemModel::load`], then let the driver run).
+///
+/// Unwritten addresses read as zero. No alignment or side-effect modelling —
+/// drivers that need register semantics layer them on top of this.
+#[derive(Clone, Debug, Default)]
+pub struct MemModel {
+    bytes: BTreeMap<u64, u8>,
+}
+
+impl MemModel {
+    /// An empty model (everything reads zero).
+    pub fn new() -> Self {
+        Self::default()
+    }
+
+    /// Pre-load raw bytes (device-tree style setup of reset/firmware state).
+    pub fn load(&mut self, addr: u64, data: &[u8]) {
+        for (i, b) in data.iter().enumerate() {
+            self.bytes.insert(addr + i as u64, *b);
+        }
+    }
+
+    /// The stored byte at `addr`, or `None` if never written or loaded.
+    pub fn peek(&self, addr: u64) -> Option<u8> {
+        self.bytes.get(&addr).copied()
+    }
+}
+
+impl Mmio for MemModel {
+    fn read(&mut self, addr: u64, width: Width) -> u64 {
+        let mut v = 0u64;
+        for i in 0..width.bytes() {
+            let b = self.bytes.get(&(addr + i as u64)).copied().unwrap_or(0);
+            v |= (b as u64) << (8 * i);
+        }
+        v
+    }
+
+    fn write(&mut self, addr: u64, width: Width, value: u64) {
+        let value = value & width.mask();
+        for i in 0..width.bytes() {
+            self.bytes
+                .insert(addr + i as u64, ((value >> (8 * i)) & 0xff) as u8);
+        }
+    }
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    #[test]
+    fn width_helpers() {
+        assert_eq!(Width::W32.bits(), 32);
+        assert_eq!(Width::W16.bytes(), 2);
+        assert_eq!(Width::from_bits(64), Some(Width::W64));
+        assert_eq!(Width::from_bits(12), None);
+        assert_eq!(Width::W8.mask(), 0xff);
+        assert_eq!(Width::W16.mask(), 0xffff);
+        assert_eq!(Width::W32.mask(), 0xffff_ffff);
+        assert_eq!(Width::W64.mask(), u64::MAX);
+    }
+
+    #[test]
+    fn u32_roundtrip_little_endian() {
+        let mut m = MemModel::new();
+        m.write_u32(0xa84010, 0xdead_beef);
+        assert_eq!(m.peek(0xa84010), Some(0xef));
+        assert_eq!(m.peek(0xa84011), Some(0xbe));
+        assert_eq!(m.peek(0xa84012), Some(0xad));
+        assert_eq!(m.peek(0xa84013), Some(0xde));
+        assert_eq!(m.read_u32(0xa84010), 0xdead_beef);
+    }
+
+    #[test]
+    fn narrow_write_does_not_clobber_neighbours() {
+        let mut m = MemModel::new();
+        m.write_u32(0x100, 0x1122_3344);
+        m.write_u8(0x101, 0xff);
+        assert_eq!(m.read_u32(0x100), 0x1122_ff44);
+        m.write_u16(0x102, 0xabcd);
+        assert_eq!(m.read_u32(0x100), 0xabcd_ff44);
+    }
+
+    #[test]
+    fn write_masks_value_to_width() {
+        let mut m = MemModel::new();
+        m.write(0x200, Width::W8, 0x1ff);
+        assert_eq!(m.peek(0x200), Some(0xff));
+        assert_eq!(m.peek(0x201), None);
+        m.write(0x210, Width::W16, 0x1_2345);
+        assert_eq!(m.read_u16(0x210), 0x2345);
+        assert_eq!(m.peek(0x212), None);
+    }
+
+    #[test]
+    fn unwritten_reads_zero() {
+        let mut m = MemModel::new();
+        assert_eq!(m.read_u64(0x8000), 0);
+        assert_eq!(m.read_u8(0), 0);
+    }
+
+    #[test]
+    fn u64_spans_loaded_and_unwritten_bytes() {
+        let mut m = MemModel::new();
+        m.load(0x40, &[0x01, 0x02]);
+        assert_eq!(m.read_u64(0x40), 0x0000_0000_0000_0201);
+    }
+
+    #[test]
+    fn load_preloads_reset_state() {
+        let mut m = MemModel::new();
+        // Pretend firmware left SE_HW_PARAM_0 = 0x0000_0010 at +0xe24.
+        m.load(0xa84e24, &[0x10, 0x00, 0x00, 0x00]);
+        assert_eq!(m.read_u32(0xa84e24), 0x10);
+    }
+}
diff --git a/drivers/mmio-replay/src/recorder.rs b/drivers/mmio-replay/src/recorder.rs
new file mode 100644
index 00000000..4a987b41
--- /dev/null
+++ b/drivers/mmio-replay/src/recorder.rs
@@ -0,0 +1,134 @@
+//! Recorder: wraps any [`Mmio`] device and captures every transaction as a
+//! [`Trace`].
+//!
+//! On the phone this wraps the real register window (via the oracle tooling);
+//! in host tests it wraps a [`MemModel`] so a reference driver run can be
+//! captured and frozen as JSONL.
+
+use crate::mmio::{Mmio, Op, Width};
+use crate::trace::{Event, Trace};
+
+/// Wraps a device and records each MMIO transaction in order.
+pub struct Recorder<'a, T: Mmio> {
+    inner: &'a mut T,
+    trace: Trace,
+    delay_us: u64,
+}
+
+impl<'a, T: Mmio> Recorder<'a, T> {
+    /// Start recording accesses to `inner`.
+    pub fn new(inner: &'a mut T) -> Self {
+        Self {
+            inner,
+            trace: Trace::new(),
+            delay_us: 0,
+        }
+    }
+
+    /// Set the delay (µs since the previous event) attributed to the *next*
+    /// transaction. Resets to 0 after each recorded event.
+    pub fn set_delay_us(&mut self, delay_us: u64) {
+        self.delay_us = delay_us;
+    }
+
+    /// The trace recorded so far.
+    pub fn trace(&self) -> &Trace {
+        &self.trace
+    }
+
+    /// Finish recording and return the trace.
+    pub fn into_trace(self) -> Trace {
+        self.trace
+    }
+}
+
+impl<T: Mmio> Mmio for Recorder<'_, T> {
+    fn read(&mut self, addr: u64, width: Width) -> u64 {
+        let value = self.inner.read(addr, width);
+        self.trace.push(Event {
+            op: Op::Read,
+            width,
+            addr,
+            value,
+            delay_us: self.delay_us,
+        });
+        self.delay_us = 0;
+        value
+    }
+
+    fn write(&mut self, addr: u64, width: Width, value: u64) {
+        self.inner.write(addr, width, value);
+        self.trace.push(Event {
+            op: Op::Write,
+            width,
+            addr,
+            value: value & width.mask(),
+            delay_us: self.delay_us,
+        });
+        self.delay_us = 0;
+    }
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+    use crate::mmio::MemModel;
+
+    #[test]
+    fn records_reads_and_writes_in_order() {
+        let mut model = MemModel::new();
+        model.load(0x40, &[0x78, 0x56, 0x34, 0x12]);
+        let mut rec = Recorder::new(&mut model);
+        rec.write_u32(0x10, 0xdead_beef);
+        assert_eq!(
+            rec.read_u32(0x40),
+            0x1234_5678,
+            "device value must pass through"
+        );
+        rec.write_u8(0x10, 0xff);
+        let trace = rec.into_trace();
+        assert_eq!(trace.events.len(), 3);
+        assert_eq!(trace.events[0], Event::write(0x10, Width::W32, 0xdead_beef));
+        assert_eq!(trace.events[1], Event::read(0x40, Width::W32, 0x1234_5678));
+        assert_eq!(trace.events[2], Event::write(0x10, Width::W8, 0xff));
+        // The wrapped device really was written through the recorder.
+        // write_u8 replaced only the low byte of the earlier u32 write.
+        assert_eq!(model.read_u32(0x10), 0xdead_beef & 0xffff_ff00 | 0xff);
+    }
+
+    #[test]
+    fn recorded_writes_are_masked_to_width() {
+        let mut model = MemModel::new();
+        let mut rec = Recorder::new(&mut model);
+        rec.write(0x100, Width::W16, 0xffff_ffff);
+        let t = rec.into_trace();
+        assert_eq!(t.events[0].value, 0xffff);
+    }
+
+    #[test]
+    fn delays_attach_to_next_event_and_reset() {
+        let mut model = MemModel::new();
+        let mut rec = Recorder::new(&mut model);
+        rec.set_delay_us(1500);
+        rec.write_u32(0x0, 1);
+        rec.write_u32(0x0, 2); // no delay set: 0
+        rec.set_delay_us(7);
+        let _ = rec.read_u32(0x0);
+        let t = rec.into_trace();
+        assert_eq!(t.total_delay_us(), 1507);
+        assert_eq!(t.events[0].delay_us, 1500);
+        assert_eq!(t.events[1].delay_us, 0);
+        assert_eq!(t.events[2].delay_us, 7);
+    }
+
+    #[test]
+    fn recorded_trace_roundtrips_through_jsonl() {
+        let mut model = MemModel::new();
+        let mut rec = Recorder::new(&mut model);
+        rec.write_u32(0xa84010, 2);
+        let _ = rec.read_u32(0xa84018);
+        let trace = rec.into_trace();
+        let text = trace.to_jsonl();
+        assert_eq!(Trace::from_jsonl(&text).unwrap(), trace);
+    }
+}
diff --git a/drivers/mmio-replay/src/replayer.rs b/drivers/mmio-replay/src/replayer.rs
new file mode 100644
index 00000000..14834f28
--- /dev/null
+++ b/drivers/mmio-replay/src/replayer.rs
@@ -0,0 +1,495 @@
+//! Replayer: feeds a recorded [`Trace`] back to a driver and compares every
+//! transaction against it.
+//!
+//! The driver under test is handed `&mut Replayer` as its [`Mmio`]:
+//!
+//! - reads return the value the real hardware returned at that point in the
+//!   recording, so state machines (FIFO-ready bits, handshakes) replay
+//!   faithfully;
+//! - writes are compared against the recording.
+//!
+//! ## Compare modes
+//!
+//! [`Compare::Strict`] — every transaction must equal the next recorded
+//! event (op, width, address, and written value). The first deviation fails
+//! the replay; later accesses are counted but not compared.
+//!
+//! [`Compare::Lenient`] — structure must match: a driver may write values
+//! that differ from the recording (recorded as [`MismatchKind::WriteValue`]
+//! warnings) and may skip recorded events (e.g. extra polling reads the
+//! recording contains), but touching a register that is not in the trace at
+//! all is a [`MismatchKind::Structure`] failure.
+//!
+//! Call [`Replayer::finish`] at the end of the driver run and check
+//! [`ReplayReport::ok`].
+
+use alloc::format;
+use alloc::string::String;
+use alloc::vec::Vec;
+
+use crate::mmio::{Mmio, Op, Width};
+use crate::trace::{Event, Trace};
+
+/// How strictly observed accesses are compared against the trace.
+#[derive(Clone, Copy, PartialEq, Eq, Debug)]
+pub enum Compare {
+    /// Everything must match exactly; first deviation fails.
+    Strict,
+    /// Values may differ and recorded events may be skipped; unknown
+    /// registers or directions fail.
+    Lenient,
+}
+
+/// An access the driver actually performed.
+#[derive(Clone, Copy, PartialEq, Eq, Debug)]
+pub struct ObservedAccess {
+    /// Direction the driver used.
+    pub op: Op,
+    /// Width the driver used.
+    pub width: Width,
+    /// Address the driver touched.
+    pub addr: u64,
+    /// Value the driver wrote (0 for reads).
+    pub value: u64,
+}
+
+/// Why an observed access did not match the recording.
+#[derive(Clone, Copy, PartialEq, Eq, Debug)]
+pub enum MismatchKind {
+    /// Wrong op/width/address: the access does not correspond to the next
+    /// (or any remaining) recorded event. Fails in both compare modes.
+    Structure,
+    /// Right register, wrong value. Fails in strict mode only.
+    WriteValue,
+}
+
+/// One comparison failure.
+#[derive(Clone, Copy, PartialEq, Eq, Debug)]
+pub struct Mismatch {
+    /// Index in the trace of the event that was expected (`None` when the
+    /// driver ran past the end of the trace).
+    pub index: Option<usize>,
+    /// The recorded event that was expected, if any.
+    pub expected: Option<Event>,
+    /// What the driver actually did.
+    pub got: ObservedAccess,
+    /// Which rule was broken.
+    pub kind: MismatchKind,
+}
+
+/// The outcome of a replay, produced by [`Replayer::finish`].
+#[derive(Clone, PartialEq, Eq, Debug)]
+pub struct ReplayReport {
+    /// The compare mode that was used.
+    pub mode: Compare,
+    /// Observed accesses that matched a recorded event.
+    pub matched: usize,
+    /// All comparison failures, in order.
+    pub mismatches: Vec<Mismatch>,
+    /// Recorded events the lenient replay stepped over (extra accesses in
+    /// the recording the driver did not perform).
+    pub skipped: Vec<Event>,
+    /// Recorded events never reached by the driver.
+    pub unconsumed: Vec<Event>,
+    /// Accesses made after a strict replay already failed (not compared).
+    pub uncompared: usize,
+}
+
+impl ReplayReport {
+    /// Whether the replay counts as a pass under its compare mode.
+    pub fn ok(&self) -> bool {
+        match self.mode {
+            Compare::Strict => {
+                self.mismatches.is_empty() && self.unconsumed.is_empty() && self.uncompared == 0
+            }
+            Compare::Lenient => !self
+                .mismatches
+                .iter()
+                .any(|m| m.kind == MismatchKind::Structure),
+        }
+    }
+
+    /// Non-failing deviations worth printing in a test log.
+    pub fn warnings(&self) -> usize {
+        self.mismatches
+            .iter()
+            .filter(|m| m.kind == MismatchKind::WriteValue)
+            .count()
+            + self.skipped.len()
+            + self.unconsumed.len()
+    }
+}
+
+impl core::fmt::Display for ReplayReport {
+    fn fmt(&self, f: &mut core::fmt::Formatter<'_>) -> core::fmt::Result {
+        write!(
+            f,
+            "{:?} replay: {} matched, {} mismatch(es), {} skipped, {} unconsumed, {} uncompared -> {}",
+            self.mode,
+            self.matched,
+            self.mismatches.len(),
+            self.skipped.len(),
+            self.unconsumed.len(),
+            self.uncompared,
+            if self.ok() { "PASS" } else { "FAIL" },
+        )?;
+        for m in &self.mismatches {
+            let exp = match m.expected {
+                Some(e) => format!(
+                    "expected {:?} {:#x} w{} {:#x}",
+                    e.op,
+                    e.addr,
+                    e.width.bits(),
+                    e.value
+                ),
+                None => String::from("expected end of trace"),
+            };
+            write!(
+                f,
+                "\n  [{:?} @{}] {}: {:?} {:#x} w{} {:#x}",
+                m.kind,
+                match m.index {
+                    Some(i) => alloc::string::ToString::to_string(&i),
+                    None => String::from("end"),
+                },
+                exp,
+                m.got.op,
+                m.got.addr,
+                m.got.width.bits(),
+                m.got.value,
+            )?;
+        }
+        Ok(())
+    }
+}
+
+/// Replays a recorded [`Trace`] against a driver and compares accesses.
+pub struct Replayer {
+    trace: Vec<Event>,
+    next: usize,
+    mode: Compare,
+    matched: usize,
+    mismatches: Vec<Mismatch>,
+    skipped: Vec<Event>,
+    uncompared: usize,
+    failed: bool,
+    read_default: u64,
+}
+
+impl Replayer {
+    /// Replay `trace` under the given compare mode.
+    pub fn new(trace: Trace, mode: Compare) -> Self {
+        Self {
+            trace: trace.events,
+            next: 0,
+            mode,
+            matched: 0,
+            mismatches: Vec::new(),
+            skipped: Vec::new(),
+            uncompared: 0,
+            failed: false,
+            read_default: 0,
+        }
+    }
+
+    /// [`Compare::Strict`] replay.
+    pub fn strict(trace: Trace) -> Self {
+        Self::new(trace, Compare::Strict)
+    }
+
+    /// [`Compare::Lenient`] replay.
+    pub fn lenient(trace: Trace) -> Self {
+        Self::new(trace, Compare::Lenient)
+    }
+
+    /// Value returned for reads that have no recorded counterpart (default 0).
+    pub fn with_read_default(mut self, value: u64) -> Self {
+        self.read_default = value;
+        self
+    }
+
+    /// Number of recorded events consumed so far.
+    pub fn consumed(&self) -> usize {
+        self.next
+    }
+
+    /// Number of recorded events not yet consumed.
+    pub fn remaining(&self) -> usize {
+        self.trace.len() - self.next
+    }
+
+    /// Whether the replay has already failed (strict mode stops comparing).
+    pub fn failed(&self) -> bool {
+        self.failed
+    }
+
+    /// End the run and produce the report.
+    pub fn finish(&mut self) -> ReplayReport {
+        ReplayReport {
+            mode: self.mode,
+            matched: self.matched,
+            mismatches: core::mem::take(&mut self.mismatches),
+            skipped: core::mem::take(&mut self.skipped),
+            unconsumed: self.trace[self.next..].to_vec(),
+            uncompared: core::mem::replace(&mut self.uncompared, 0),
+        }
+    }
+
+    fn check(&mut self, op: Op, width: Width, addr: u64, value: u64) -> Option<u64> {
+        let value = value & width.mask();
+        if self.failed {
+            self.uncompared += 1;
+            return (op == Op::Read).then_some(self.read_default);
+        }
+        let got = ObservedAccess {
+            op,
+            width,
+            addr,
+            value,
+        };
+
+        // Fast path: the next recorded event.
+        if let Some(e) = self.trace.get(self.next) {
+            if e.op == op && e.width == width && e.addr == addr {
+                if op == Op::Write && value != e.value {
+                    self.mismatches.push(Mismatch {
+                        index: Some(self.next),
+                        expected: Some(*e),
+                        got,
+                        kind: MismatchKind::WriteValue,
+                    });
+                    if self.mode == Compare::Strict {
+                        self.failed = true;
+                        return None;
+                    }
+                }
+                self.matched += 1;
+                self.next += 1;
+                return (op == Op::Read).then_some(e.value);
+            }
+        }
+
+        if self.mode == Compare::Lenient {
+            // Look ahead: the driver may be skipping recorded events.
+            if let Some(j) = (self.next..self.trace.len()).find(|&j| {
+                self.trace[j].op == op && self.trace[j].width == width && self.trace[j].addr == addr
+            }) {
+                self.skipped
+                    .extend(self.trace[self.next..j].iter().copied());
+                let e = self.trace[j];
+                if op == Op::Write && value != e.value {
+                    self.mismatches.push(Mismatch {
+                        index: Some(j),
+                        expected: Some(e),
+                        got,
+                        kind: MismatchKind::WriteValue,
+                    });
+                }
+                self.matched += 1;
+                self.next = j + 1;
+                return (op == Op::Read).then_some(e.value);
+            }
+        }
+
+        // No counterpart anywhere (lenient) or not the next event (strict).
+        let expected = self.trace.get(self.next).copied();
+        self.mismatches.push(Mismatch {
+            index: Some(self.next),
+            expected,
+            got,
+            kind: MismatchKind::Structure,
+        });
+        if self.mode == Compare::Strict {
+            self.failed = true;
+        }
+        (op == Op::Read).then_some(self.read_default)
+    }
+}
+
+impl Mmio for Replayer {
+    fn read(&mut self, addr: u64, width: Width) -> u64 {
+        self.check(Op::Read, width, addr, 0)
+            .unwrap_or(self.read_default)
+    }
+
+    fn write(&mut self, addr: u64, width: Width, value: u64) {
+        self.check(Op::Write, width, addr, value);
+    }
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    fn trace_of(spec: &[(&str, u64, u64)]) -> Trace {
+        let mut t = Trace::new();
+        for (line, addr, value) in spec {
+            let (op, width) = line.split_once('@').unwrap();
+            let width = Width::from_bits(width.parse().unwrap()).unwrap();
+            let e = if op == "w" {
+                Event::write(*addr, width, *value)
+            } else {
+                Event::read(*addr, width, *value)
+            };
+            t.push(e);
+        }
+        t
+    }
+
+    #[test]
+    fn strict_exact_pass() {
+        let t = trace_of(&[
+            ("w@32", 0x10, 1),
+            ("r@32", 0x18, 0x4000_0000),
+            ("w@32", 0x10, 0),
+        ]);
+        let mut rep = Replayer::strict(t.clone());
+        rep.write_u32(0x10, 1);
+        assert_eq!(
+            rep.read_u32(0x18),
+            0x4000_0000,
+            "reads return recorded values"
+        );
+        rep.write_u32(0x10, 0);
+        let report = rep.finish();
+        assert!(report.ok(), "{report}");
+        assert_eq!(report.matched, 3);
+        assert_eq!(rep.remaining(), 0);
+    }
+
+    #[test]
+    fn strict_write_value_mismatch_fails_at_right_index() {
+        let t = trace_of(&[("w@32", 0x10, 1), ("w@32", 0x14, 7)]);
+        let mut rep = Replayer::strict(t);
+        rep.write_u32(0x10, 1);
+        rep.write_u32(0x14, 8); // wrong value
+        assert!(rep.failed());
+        let r = rep.finish();
+        assert!(!r.ok());
+        assert_eq!(r.mismatches.len(), 1);
+        assert_eq!(r.mismatches[0].kind, MismatchKind::WriteValue);
+        assert_eq!(r.mismatches[0].index, Some(1));
+        assert_eq!(r.mismatches[0].expected.unwrap().value, 7);
+        assert_eq!(r.mismatches[0].got.value, 8);
+    }
+
+    #[test]
+    fn strict_structure_mismatch_stops_comparing() {
+        let t = trace_of(&[("w@32", 0x10, 1), ("w@32", 0x14, 7)]);
+        let mut rep = Replayer::strict(t);
+        rep.write_u32(0x99, 1); // wrong register
+        rep.write_u32(0x10, 1); // would have matched, but strict already failed
+        let r = rep.finish();
+        assert!(!r.ok());
+        assert_eq!(r.mismatches.len(), 1);
+        assert_eq!(r.mismatches[0].kind, MismatchKind::Structure);
+        assert_eq!(r.uncompared, 1);
+        assert_eq!(r.unconsumed.len(), 2);
+    }
+
+    #[test]
+    fn strict_access_past_end_of_trace() {
+        let t = trace_of(&[("w@32", 0x10, 1)]);
+        let mut rep = Replayer::strict(t);
+        rep.write_u32(0x10, 1);
+        rep.write_u32(0x10, 1); // extra
+        let r = rep.finish();
+        assert!(!r.ok());
+        assert_eq!(r.mismatches[0].kind, MismatchKind::Structure);
+        assert_eq!(r.mismatches[0].index, Some(1));
+        assert_eq!(r.mismatches[0].expected, None);
+    }
+
+    #[test]
+    fn strict_driver_doing_fewer_accesses_fails() {
+        let t = trace_of(&[("w@32", 0x10, 1), ("w@32", 0x14, 7)]);
+        let mut rep = Replayer::strict(t);
+        rep.write_u32(0x10, 1);
+        let r = rep.finish();
+        assert!(!r.ok());
+        assert_eq!(r.unconsumed.len(), 1);
+    }
+
+    #[test]
+    fn lenient_tolerates_write_value_differences() {
+        let t = trace_of(&[("w@32", 0x10, 1), ("w@32", 0x14, 7)]);
+        let mut rep = Replayer::lenient(t);
+        rep.write_u32(0x10, 2);
+        rep.write_u32(0x14, 9);
+        let r = rep.finish();
+        assert!(r.ok(), "{r}");
+        assert_eq!(r.matched, 2);
+        assert_eq!(r.mismatches.len(), 2);
+        assert!(r
+            .mismatches
+            .iter()
+            .all(|m| m.kind == MismatchKind::WriteValue));
+        assert_eq!(r.warnings(), 2);
+    }
+
+    #[test]
+    fn lenient_tolerates_skipped_recorded_events() {
+        // Recording polled twice; driver polls once.
+        let t = trace_of(&[
+            ("r@32", 0x18, 0x1),
+            ("r@32", 0x18, 0x1),
+            ("w@32", 0x1c, 0x1),
+        ]);
+        let mut rep = Replayer::lenient(t);
+        assert_eq!(rep.read_u32(0x18), 0x1);
+        rep.write_u32(0x1c, 0x1); // lookahead over the second poll
+        let r = rep.finish();
+        assert!(r.ok(), "{r}");
+        assert_eq!(r.skipped.len(), 1);
+        assert_eq!(r.matched, 2);
+    }
+
+    #[test]
+    fn lenient_fails_on_unknown_register() {
+        let t = trace_of(&[("w@32", 0x10, 1)]);
+        let mut rep = Replayer::lenient(t);
+        rep.write_u32(0x20, 1); // not in the trace at all
+        let r = rep.finish();
+        assert!(!r.ok());
+        assert_eq!(r.mismatches[0].kind, MismatchKind::Structure);
+    }
+
+    #[test]
+    fn lenient_fails_on_wrong_direction() {
+        let t = trace_of(&[("w@32", 0x10, 1)]);
+        let mut rep = Replayer::lenient(t);
+        assert_eq!(rep.read_u32(0x10), 0); // reading a write-only slot
+        let r = rep.finish();
+        assert!(!r.ok());
+        assert_eq!(r.mismatches[0].kind, MismatchKind::Structure);
+        assert_eq!(r.unconsumed.len(), 1);
+    }
+
+    #[test]
+    fn lenient_fails_on_wrong_width() {
+        let t = trace_of(&[("w@32", 0x10, 1)]);
+        let mut rep = Replayer::lenient(t);
+        rep.write_u16(0x10, 1);
+        let r = rep.finish();
+        assert!(!r.ok());
+        assert_eq!(r.mismatches[0].kind, MismatchKind::Structure);
+    }
+
+    #[test]
+    fn read_default_used_for_unmatched_reads() {
+        let t = trace_of(&[("w@32", 0x10, 1)]);
+        let mut rep = Replayer::lenient(t).with_read_default(0xdead_beef);
+        assert_eq!(rep.read_u32(0x99), 0xdead_beef);
+    }
+
+    #[test]
+    fn display_report_is_informative() {
+        let t = trace_of(&[("w@32", 0x10, 1)]);
+        let mut rep = Replayer::strict(t);
+        rep.write_u32(0x20, 5);
+        let text = alloc::format!("{}", rep.finish());
+        assert!(text.contains("FAIL"));
+        assert!(text.contains("Structure"));
+        assert!(text.contains("0x20"));
+    }
+}
