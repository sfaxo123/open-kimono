@@ -0,0 +1,126 @@
+//! Read-only PM8998 button sampler. Manual opt-in until phone oracle validation.
+#[cfg(any(target_os = "redox", feature = "host-compile"))]
+mod redox {
+    use std::error::Error;
+    use std::thread;
+    use std::time::Duration;
+
+    use common::{MemoryType, PhysBorrowed, Prot};
+    use inputd::ProducerHandle;
+    use mmio_replay::{Mmio, Width};
+    use orbclient::{KeyEvent, K_POWER, K_VOLUME_DOWN, K_VOLUME_UP};
+    use spmid_core::{Arbiter, Button, Buttons, Windows};
+
+    const CORE: u64 = 0x0c44_0000;
+    const OBS: u64 = 0x0e60_0000;
+    const CFG: u64 = 0x0c40_a000;
+
+    struct Window {
+        base: u64,
+        len: usize,
+        map: PhysBorrowed,
+    }
+    impl Window {
+        fn new(base: u64, len: usize) -> Result<Self, Box<dyn Error>> {
+            let map = PhysBorrowed::map(
+                base as usize,
+                len,
+                Prot {
+                    read: true,
+                    write: true,
+                },
+                MemoryType::DeviceMemory,
+            )?;
+            Ok(Self { base, len, map })
+        }
+        fn contains(&self, addr: u64) -> bool {
+            addr >= self.base
+                && addr
+                    .checked_add(4)
+                    .is_some_and(|end| end <= self.base + self.len as u64)
+        }
+        fn ptr(&self, addr: u64) -> *mut u32 {
+            assert!(self.contains(addr) && addr % 4 == 0);
+            unsafe { (self.map.as_ptr() as *mut u8).add((addr - self.base) as usize) as *mut u32 }
+        }
+    }
+    struct Hardware {
+        core: Window,
+        observer: Window,
+        config: Window,
+    }
+    impl Hardware {
+        fn new() -> Result<Self, Box<dyn Error>> {
+            Ok(Self {
+                core: Window::new(CORE, 0x1100)?,
+                observer: Window::new(OBS, 0x100000)?,
+                config: Window::new(CFG, 0x26000)?,
+            })
+        }
+        fn window(&self, addr: u64) -> &Window {
+            [&self.core, &self.observer, &self.config]
+                .into_iter()
+                .find(|w| w.contains(addr))
+                .expect("SPMI MMIO outside mapped DT windows")
+        }
+    }
+    impl Mmio for Hardware {
+        fn read(&mut self, addr: u64, width: Width) -> u64 {
+            assert_eq!(width, Width::W32);
+            unsafe { self.window(addr).ptr(addr).read_volatile() as u64 }
+        }
+        fn write(&mut self, addr: u64, width: Width, value: u64) {
+            assert_eq!(width, Width::W32);
+            unsafe { self.window(addr).ptr(addr).write_volatile(value as u32) }
+        }
+    }
+    pub fn run() -> Result<(), Box<dyn Error>> {
+        let hardware = Hardware::new()?;
+        let mut arb = Arbiter::new(
+            hardware,
+            Windows {
+                core: CORE,
+                observer: OBS,
+                config: CFG,
+                owner: 0,
+            },
+        )
+        .map_err(|e| format!("SPMI arbiter probe: {e:?}"))?;
+        let pmic_type = arb
+            .pmic_type()
+            .map_err(|e| format!("PMIC revision read: {e:?}"))?;
+        eprintln!("spmid: PMIC type 0x{pmic_type:02x}; power key enabled per OpenBSD qcpon status bit; verify on hardware before autostart");
+        let mut input = ProducerHandle::new()?;
+        let mut buttons = Buttons::new(true);
+        loop {
+            let levels = arb
+                .sample()
+                .map_err(|e| format!("SPMI button read: {e:?}"))?;
+            for edge in buttons.update(levels) {
+                let scancode = match edge.button {
+                    Button::Power => K_POWER,
+                    Button::VolumeDown => K_VOLUME_DOWN,
+                    Button::VolumeUp => K_VOLUME_UP,
+                };
+                input.write_event(
+                    KeyEvent {
+                        character: '\0',
+                        scancode,
+                        pressed: edge.pressed,
+                    }
+                    .to_event(),
+                )?;
+            }
+            thread::sleep(Duration::from_millis(50));
+        }
+    }
+}
+
+#[cfg(any(target_os = "redox", feature = "host-compile"))]
+fn main() -> Result<(), Box<dyn std::error::Error>> {
+    redox::run()
+}
+#[cfg(not(any(target_os = "redox", feature = "host-compile")))]
+fn main() {
+    eprintln!("spmid requires Redox aarch64; use spmid-core tests on the host");
+}
