@@ -0,0 +1,153 @@
+//! Read-only SDM845 SPMI arbiter v5 and PM8998 button sampling.
+use mmio_replay::Mmio;
+
+const VALID_VERSION_MIN: u32 = 0x5000_0000;
+const VALID_VERSION_MAX: u32 = 0x7000_0000;
+const DONE: u32 = 1;
+const MAX_CHANNELS: usize = 512;
+
+#[derive(Debug, Clone, Copy, PartialEq, Eq)]
+pub enum Error {
+    UnsupportedVersion(u32),
+    BadChannel,
+    Timeout,
+    BadStatus(u32),
+}
+
+#[derive(Debug, Clone, Copy)]
+pub struct Windows {
+    pub core: u64,
+    pub observer: u64,
+    pub config: u64,
+    pub owner: u8,
+}
+
+pub struct Arbiter<M: Mmio> {
+    io: M,
+    windows: Windows,
+    channels: [[Option<u16>; 256]; 16],
+}
+
+impl<M: Mmio> Arbiter<M> {
+    pub fn new(mut io: M, windows: Windows) -> Result<Self, Error> {
+        let version = io.read_u32(windows.core);
+        if !(VALID_VERSION_MIN..VALID_VERSION_MAX).contains(&version) {
+            return Err(Error::UnsupportedVersion(version));
+        }
+        let count = ((io.read_u32(windows.core + 4) & 0x7ff) as usize).min(MAX_CHANNELS);
+        let mut channels = [[None; 256]; 16];
+        for apid in 0..count {
+            let entry = io.read_u32(windows.core + 0x900 + 4 * apid as u64);
+            let sid = ((entry >> 16) & 0xf) as usize;
+            let pid = ((entry >> 8) & 0xff) as usize;
+            let owner = (io.read_u32(windows.config + 4 * apid as u64) & 7) as u8;
+            // Prefer an APID owned by our EE, but observer reads work on either.
+            if channels[sid][pid].is_none() || owner == windows.owner {
+                channels[sid][pid] = Some(apid as u16);
+            }
+        }
+        Ok(Self {
+            io,
+            windows,
+            channels,
+        })
+    }
+
+    pub fn read_byte(&mut self, sid: u8, addr: u16) -> Result<u8, Error> {
+        let channel = self
+            .channels
+            .get(sid as usize)
+            .and_then(|pids| pids[(addr >> 8) as usize])
+            .ok_or(Error::BadChannel)?;
+        let base = self.windows.observer + u64::from(channel) * 0x80;
+        self.io.write_u32(base + 4, 0);
+        self.io
+            .write_u32(base, (1 << 27) | (u32::from(addr & 0xff) << 4) | 1);
+        for _ in 0..1024 {
+            let status = self.io.read_u32(base + 8);
+            if status & DONE != 0 {
+                if status != DONE {
+                    return Err(Error::BadStatus(status));
+                }
+                return Ok(self.io.read_u32(base + 0x18) as u8);
+            }
+        }
+        Err(Error::Timeout)
+    }
+
+    pub fn into_io(self) -> M {
+        self.io
+    }
+
+    pub fn pmic_type(&mut self) -> Result<u8, Error> {
+        self.read_byte(0, 0x104)
+    }
+    pub fn sample(&mut self) -> Result<Levels, Error> {
+        Ok(Levels {
+            power: self.read_byte(0, 0x810)? & 0x80 != 0,
+            volume_down: self.read_byte(0, 0xc410)? & 1 == 0,
+            volume_up: self.read_byte(0, 0xc510)? & 1 == 0,
+        })
+    }
+}
+
+#[derive(Debug, Clone, Copy, PartialEq, Eq)]
+pub struct Levels {
+    pub power: bool,
+    pub volume_down: bool,
+    pub volume_up: bool,
+}
+#[derive(Debug, Clone, Copy, PartialEq, Eq)]
+pub enum Button {
+    Power,
+    VolumeDown,
+    VolumeUp,
+}
+#[derive(Debug, Clone, Copy, PartialEq, Eq)]
+pub struct Edge {
+    pub button: Button,
+    pub pressed: bool,
+}
+
+/// Initial sample establishes a baseline; no phantom press is emitted.
+pub struct Buttons {
+    previous: Option<Levels>,
+    power_confirmed: bool,
+}
+impl Buttons {
+    pub fn new(power_confirmed: bool) -> Self {
+        Self {
+            previous: None,
+            power_confirmed,
+        }
+    }
+    pub fn update(&mut self, levels: Levels) -> Vec<Edge> {
+        let mut edges = Vec::new();
+        if let Some(previous) = self.previous {
+            for (button, old, new, enabled) in [
+                (
+                    Button::Power,
+                    previous.power,
+                    levels.power,
+                    self.power_confirmed,
+                ),
+                (
+                    Button::VolumeDown,
+                    previous.volume_down,
+                    levels.volume_down,
+                    true,
+                ),
+                (Button::VolumeUp, previous.volume_up, levels.volume_up, true),
+            ] {
+                if enabled && old != new {
+                    edges.push(Edge {
+                        button,
+                        pressed: new,
+                    });
+                }
+            }
+        }
+        self.previous = Some(levels);
+        edges
+    }
+}
diff --git a/drivers/spmid-core/tests/arbiter.rs b/drivers/spmid-core/tests/arbiter.rs
new file mode 100644
index 00000000..e98ebb08
--- /dev/null
+++ b/drivers/spmid-core/tests/arbiter.rs
@@ -0,0 +1,159 @@
+use mmio_replay::{Event, Replayer, Trace, Width};
+use spmid_core::{Arbiter, Button, Buttons, Edge, Error, Levels, Windows};
+
+const CORE: u64 = 0x0c44_0000;
+const OBS: u64 = 0x0e60_0000;
+const CFG: u64 = 0x0c40_a000;
+fn win() -> Windows {
+    Windows {
+        core: CORE,
+        observer: OBS,
+        config: CFG,
+        owner: 0,
+    }
+}
+fn r(t: &mut Trace, addr: u64, value: u32) {
+    t.push(Event::read(addr, Width::W32, value as u64));
+}
+fn w(t: &mut Trace, addr: u64, value: u32) {
+    t.push(Event::write(addr, Width::W32, value as u64));
+}
+fn setup(entries: &[(u8, u8)]) -> Trace {
+    let mut t = Trace::new();
+    r(&mut t, CORE, 0x5000_0000);
+    r(&mut t, CORE + 4, entries.len() as u32);
+    for (i, (sid, pid)) in entries.iter().enumerate() {
+        r(
+            &mut t,
+            CORE + 0x900 + (i * 4) as u64,
+            ((*sid as u32) << 16) | ((*pid as u32) << 8),
+        );
+        r(&mut t, CFG + (i * 4) as u64, 0);
+    }
+    t
+}
+fn read(t: &mut Trace, channel: u64, offset: u8, value: u8) {
+    let base = OBS + 0x80 * channel;
+    w(t, base + 4, 0);
+    w(t, base, (1 << 27) | ((offset as u32) << 4) | 1);
+    r(t, base + 8, 1);
+    r(t, base + 0x18, value as u32);
+}
+#[test]
+fn replay_revision_and_three_buttons() {
+    let mut t = setup(&[(0, 1), (0, 8), (0, 0xc4), (0, 0xc5)]);
+    read(&mut t, 0, 4, 0x51);
+    read(&mut t, 1, 0x10, 0x80);
+    read(&mut t, 2, 0x10, 0);
+    read(&mut t, 3, 0x10, 1);
+    let mut arb = Arbiter::new(Replayer::strict(t), win()).unwrap();
+    assert_eq!(arb.pmic_type(), Ok(0x51));
+    assert_eq!(
+        arb.sample(),
+        Ok(Levels {
+            power: true,
+            volume_down: true,
+            volume_up: false
+        })
+    );
+    assert!(arb.into_io().finish().ok());
+}
+#[test]
+fn missing_channel_fails_without_bus_access() {
+    let t = setup(&[(0, 8)]);
+    let mut arb = Arbiter::new(Replayer::strict(t), win()).unwrap();
+    assert_eq!(arb.read_byte(0, 0xc410), Err(Error::BadChannel));
+    assert!(arb.into_io().finish().ok());
+}
+#[test]
+fn timeout_is_bounded() {
+    let mut t = setup(&[(0, 8)]);
+    w(&mut t, OBS + 4, 0);
+    w(&mut t, OBS, (1 << 27) | (0x10 << 4) | 1);
+    for _ in 0..1024 {
+        r(&mut t, OBS + 8, 0);
+    }
+    let mut arb = Arbiter::new(Replayer::strict(t), win()).unwrap();
+    assert_eq!(arb.read_byte(0, 0x810), Err(Error::Timeout));
+    assert!(arb.into_io().finish().ok());
+}
+#[test]
+fn bad_status_is_rejected() {
+    let mut t = setup(&[(0, 8)]);
+    w(&mut t, OBS + 4, 0);
+    w(&mut t, OBS, (1 << 27) | (0x10 << 4) | 1);
+    r(&mut t, OBS + 8, 3);
+    let mut arb = Arbiter::new(Replayer::strict(t), win()).unwrap();
+    assert_eq!(arb.read_byte(0, 0x810), Err(Error::BadStatus(3)));
+    assert!(arb.into_io().finish().ok());
+}
+#[test]
+fn unsupported_version_is_rejected() {
+    let mut t = Trace::new();
+    r(&mut t, CORE, 0x3000_0000);
+    let result = Arbiter::new(Replayer::strict(t), win());
+    assert!(matches!(
+        result,
+        Err(Error::UnsupportedVersion(0x3000_0000))
+    ));
+}
+#[test]
+fn edges_have_no_initial_press_and_power_is_gated() {
+    let mut buttons = Buttons::new(false);
+    let released = Levels {
+        power: false,
+        volume_down: false,
+        volume_up: false,
+    };
+    assert!(buttons.update(released).is_empty());
+    assert_eq!(
+        buttons.update(Levels {
+            power: true,
+            volume_down: true,
+            volume_up: false
+        }),
+        vec![Edge {
+            button: Button::VolumeDown,
+            pressed: true
+        }]
+    );
+    assert_eq!(
+        buttons.update(Levels {
+            power: false,
+            volume_down: false,
+            volume_up: false
+        }),
+        vec![Edge {
+            button: Button::VolumeDown,
+            pressed: false
+        }]
+    );
+}
+
+#[test]
+fn confirmed_power_edges_reach_input_model() {
+    let mut buttons = Buttons::new(true);
+    let released = Levels {
+        power: false,
+        volume_down: false,
+        volume_up: false,
+    };
+    assert!(buttons.update(released).is_empty());
+    assert_eq!(
+        buttons.update(Levels {
+            power: true,
+            ..released
+        }),
+        vec![Edge {
+            button: Button::Power,
+            pressed: true
+        }]
+    );
+    assert_eq!(
+        buttons.update(released),
+        vec![Edge {
+            button: Button::Power,
+            pressed: false
+        }]
+    );
+}
