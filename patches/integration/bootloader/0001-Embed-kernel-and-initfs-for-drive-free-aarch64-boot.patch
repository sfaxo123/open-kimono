+#[cfg(feature = "ramboot")]
+fn embedded_to_memory<O: Os>(os: &O, data: &[u8], magic: &[u8]) -> &'static mut [u8] {
+    assert!(data.starts_with(magic), "invalid embedded boot image");
+    let ptr = os.alloc_zeroed_page_aligned(data.len());
+    assert!(!ptr.is_null(), "failed to allocate embedded boot image");
+    let memory = unsafe { slice::from_raw_parts_mut(ptr, data.len()) };
+    memory.copy_from_slice(data);
+    memory
+}
