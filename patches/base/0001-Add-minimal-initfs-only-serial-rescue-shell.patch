 	ln -sf /scheme/libc/stdout $(DESTDIR)/dev/stdout
 	ln -sf /scheme/libc/stderr $(DESTDIR)/dev/stderr
+
+# Build a small standalone initfs. The normal disk image keeps its existing contents.
+ramboot-initfs:
+	@mkdir -p "$(BUILD_DIR)"
+	CARGO_PROFILE_RELEASE_OPT_LEVEL=s CARGO_PROFILE_RELEASE_PANIC=abort \
+		$(CARGO) build $(BUILD_FLAGS) --manifest-path "$(SRC_DIR)/Cargo.toml" \
+		$(foreach bin,$(RAMBOOT_BINS),-p $(bin))
+	cd "$(SRC_DIR)/bootstrap" && RUSTFLAGS= $(CARGO) rustc $(BUILD_FLAGS) \
+		-- -Ctarget-feature=+crt-static -Clinker="$(LINKER)"
+	rm -rf "$(BUILD_DIR)/ramboot-initfs"
+	mkdir -p "$(BUILD_DIR)/ramboot-initfs/bin" "$(BUILD_DIR)/ramboot-initfs/lib/init.d"
+	for bin in $(RAMBOOT_BINS); do \
+		cp "$(TARGET_DIR)/$$bin" "$(BUILD_DIR)/ramboot-initfs/bin"; \
+	done
+	cp "$(SRC_DIR)/init.initfs.d"/00_* "$(SRC_DIR)/init.initfs.d"/ramfs@.service \
+		"$(SRC_DIR)/init.initfs.d"/30_ramsh.service \
+		"$(SRC_DIR)/init.initfs.d"/90_ramboot.target "$(BUILD_DIR)/ramboot-initfs/lib/init.d/"
+	$(CARGO_HOST) run --manifest-path "$(SRC_DIR)/initfs/tools/Cargo.toml" --bin redox-initfs-ar -- \
+		"$(BUILD_DIR)/ramboot-initfs" "$(TARGET_DIR)/bootstrap" -o "$(BUILD_DIR)/ramboot-initfs.img"
