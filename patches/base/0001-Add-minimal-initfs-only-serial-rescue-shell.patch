+//! Small serial rescue shell for an initfs-only boot.
+
+use std::fs;
+use std::io::{self, BufRead, Write};
+
+use libredox::flag::{O_RDONLY, O_WRONLY};
+
+fn run() -> io::Result<()> {
+    let path = "/scheme/debug/no-preserve";
+    for (fd, flags) in [(0, O_RDONLY), (1, O_WRONLY), (2, O_WRONLY)] {
+        libredox::Fd::open(path, flags, 0)?.dup2(fd, &[])?;
+    }
+
+    let mut input = io::stdin().lock();
+    let mut line = String::new();
+    let mut out = io::stdout().lock();
+    writeln!(out, "Redox RAM shell. Type help for commands.")?;
+    loop {
+        write!(out, "ram:~$ ")?;
+        out.flush()?;
+        line.clear();
+        if input.read_line(&mut line)? == 0 {
+            break;
+        }
+        let command = line.trim();
+        if let Some(message) = command.strip_prefix("echo ") {
+            writeln!(out, "{message}")?;
+        } else {
+            match command {
+                "" => {}
+                "help" => writeln!(out, "help echo pwd ls cat exit")?,
+                "pwd" => writeln!(out, "/scheme/initfs")?,
+                "ls" => {
+                    for entry in fs::read_dir("/scheme/initfs")? {
+                        writeln!(out, "{}", entry?.file_name().to_string_lossy())?;
+                    }
+                }
+                "exit" => break,
+                _ if command.starts_with("cat ") => {
+                    let path = command[4..].trim();
+                    if path.starts_with('/') && !path.starts_with("/scheme/initfs/") {
+                        writeln!(out, "cat: path must be in /scheme/initfs")?;
+                    } else {
+                        let path = path.strip_prefix("/scheme/initfs/").unwrap_or(path);
+                        match fs::read_to_string(format!("/scheme/initfs/{path}")) {
+                            Ok(data) => write!(out, "{data}")?,
+                            Err(err) => writeln!(out, "cat: {err}")?,
+                        }
+                    }
+                }
+                _ => writeln!(out, "unknown command: {command}")?,
+            }
+        }
+    }
+    Ok(())
+}
+
+fn main() {
+    if let Err(err) = run() {
+        eprintln!("ramsh: {err}");
+    }
+}
