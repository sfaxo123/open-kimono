+#[cfg(test)]
+mod tests {
+    use super::{DebugDisplay, BLACK, FONT, MAX_CELLS, ORANGE, WHITE};
+
+    const SENTINEL: u32 = 0xDEAD_BEEF;
+
+    struct Fb {
+        pixels: Vec<u32>,
+        stride: usize,
+        display: DebugDisplay,
+    }
+
+    fn fb(width: usize, height: usize, stride: usize) -> Fb {
+        let mut pixels = vec![SENTINEL; stride * height];
+        let cells = Box::leak(vec![0u16; MAX_CELLS].into_boxed_slice());
+        let display = DebugDisplay::new(width, height, stride, pixels.as_mut_ptr(), cells);
+        Fb {
+            pixels,
+            stride,
+            display,
+        }
+    }
+
+    impl Fb {
+        /// One glyph cell as text art: `#` white, `o` orange, `.` black.
+        fn cell_art(&self, col: usize, row: usize) -> String {
+            let scale = self.display.scale;
+            let (w, h) = (8 * scale, 16 * scale);
+            let mut art = String::new();
+            for y in (row * h..(row + 1) * h).step_by(scale) {
+                for x in (col * w..(col + 1) * w).step_by(scale) {
+                    art.push(match self.pixels[y * self.stride + x] {
+                        WHITE => '#',
+                        ORANGE => 'o',
+                        BLACK => '.',
+                        _ => '?',
+                    });
+                }
+                art.push('\n');
+            }
+            art
+        }
+
+        fn row_text(&self, row: usize) -> String {
+            let cols = self.display.cols;
+            self.display.cells[row * cols..(row + 1) * cols]
+                .iter()
+                .map(|&c| c as u8 as char)
+                .collect::<String>()
+                .trim_end()
+                .to_owned()
+        }
+    }
+
+    /// unifont 'K' (0x4B), the first byte of "Kernel".
+    const GOLDEN_K: &str = "\
+........
+........
+........
+........
+.#....#.
+.#...#..
+.#..#...
+.#.#....
+.##.....
+.##.....
+.#.#....
+.#..#...
+.#...#..
+.#....#.
+........
+........
+";
+
+    /// A glyph straight from the font file, in `cell_art` notation.
+    fn glyph_art(b: u8) -> String {
+        FONT[16 * b as usize..16 * b as usize + 16]
+            .iter()
+            .map(|bits| {
+                (0..8)
+                    .map(|c| if (bits >> (7 - c)) & 1 == 1 { '#' } else { '.' })
+                    .chain(['\n'])
+                    .collect::<String>()
+            })
+            .collect()
+    }
+
+    fn blank_art() -> String {
+        (".".repeat(8) + "\n").repeat(16)
+    }
+
+    #[test]
+    fn glyph_cell_matches_the_golden_bitmap() {
+        let mut fb = fb(640, 480, 640);
+        fb.display.write(b"K");
+        assert_eq!(fb.cell_art(0, 0), GOLDEN_K);
+        assert_eq!(glyph_art(b'K'), GOLDEN_K);
+        assert_eq!(fb.cell_art(1, 0), blank_art());
+    }
+
+    #[test]
+    fn every_printable_glyph_follows_the_font() {
+        let mut fb = fb(1024, 768, 1024);
+        let text: Vec<u8> = (0x20..=0x7E).collect();
+        fb.display.write(&text);
+        for (i, &b) in text.iter().enumerate() {
+            assert_eq!(fb.cell_art(i, 0), glyph_art(b), "glyph {:?}", b as char);
+        }
+    }
+
+    #[test]
+    fn logger_prefix_is_orange_and_message_white() {
+        let mut fb = fb(640, 480, 640);
+        fb.display.write(b"Kernel:INFO -- K\n");
+        assert_eq!(fb.cell_art(0, 0), GOLDEN_K.replace('#', "o"));
+        assert_eq!(fb.cell_art(15, 0), GOLDEN_K);
+    }
+
+    #[test]
+    fn warnings_errors_and_panics_are_orange_to_the_end() {
+        let mut fb = fb(640, 480, 640);
+        fb.display
+            .write(b"a:WARN -- K\nb:ERROR -- K\nKERNEL PANIC K\nplain K\n");
+        let orange = GOLDEN_K.replace('#', "o");
+        assert_eq!(fb.cell_art(10, 0), orange);
+        assert_eq!(fb.cell_art(11, 1), orange);
+        assert_eq!(fb.cell_art(0, 2), orange);
+        assert_eq!(fb.cell_art(13, 2), orange);
+        assert_eq!(fb.cell_art(6, 3), GOLDEN_K);
+    }
+
+    #[test]
+    fn text_scrolls_up_when_the_screen_is_full() {
+        let mut fb = fb(640, 480, 640);
+        let rows = fb.display.rows;
+        assert_eq!(rows, 30);
+        for i in 0..rows + 2 {
+            fb.display.write(format!("line {i}\n").as_bytes());
+        }
+        assert_eq!(fb.row_text(0), "line 3");
+        assert_eq!(fb.row_text(rows - 2), "line 31");
+        assert_eq!(fb.row_text(rows - 1), "");
+        // The pixels follow the grid: the top row now draws "line 3".
+        for (col, b) in b"line 3  ".iter().enumerate() {
+            assert_eq!(fb.cell_art(col, 0), glyph_art(*b), "column {col}");
+        }
+        for (col, b) in b"line 31 ".iter().enumerate() {
+            assert_eq!(fb.cell_art(col, rows - 2), glyph_art(*b), "column {col}");
+        }
+        assert_eq!(fb.cell_art(0, rows - 1), blank_art());
+    }
+
+    #[test]
+    fn long_lines_wrap_and_keep_their_colour() {
+        let mut fb = fb(640, 480, 640);
+        let cols = fb.display.cols;
+        let mut line = b"x:ERROR -- ".to_vec();
+        line.resize(cols, b'-');
+        line.extend_from_slice(b"K\n");
+        fb.display.write(&line);
+        assert_eq!(fb.row_text(1), "K");
+        assert_eq!(fb.cell_art(0, 1), GOLDEN_K.replace('#', "o"));
+    }
+
+    #[test]
+    fn escape_sequences_and_control_bytes_are_not_drawn() {
+        let mut fb = fb(640, 480, 640);
+        fb.display.write(b"\x1b[1;31mK\x1b[0m\x07\tK");
+        assert_eq!(fb.row_text(0), "KK");
+    }
+
+    #[test]
+    fn stride_padding_is_never_written() {
+        let (width, height, stride) = (800, 600, 832);
+        let mut fb = fb(width, height, stride);
+        for i in 0..200 {
+            fb.display.write(format!("{i:>120}\n").as_bytes());
+        }
+        for y in 0..height {
+            for x in width..stride {
+                assert_eq!(fb.pixels[y * stride + x], SENTINEL, "({x}, {y})");
+            }
+            for x in 0..width {
+                assert_ne!(fb.pixels[y * stride + x], SENTINEL, "({x}, {y})");
+            }
+        }
+    }
+
+    #[test]
+    fn phone_panel_uses_doubled_glyphs() {
+        let mut fb = fb(1080, 2280, 1080);
+        assert_eq!(fb.display.scale, 2);
+        assert_eq!((fb.display.cols, fb.display.rows), (67, 71));
+        fb.display.write(b"K");
+        assert_eq!(fb.cell_art(0, 0), GOLDEN_K);
+        // Each font pixel covers a 2x2 block: glyph row 4, column 1 is set.
+        let (x, y) = (2 * 1, 2 * 4);
+        let block = [(x, y), (x + 1, y), (x, y + 1), (x + 1, y + 1)];
+        assert!(block.iter().all(|&(x, y)| fb.pixels[y * 1080 + x] == WHITE));
+    }
+
+    #[test]
+    fn grid_is_clamped_to_the_cell_buffer() {
+        let mut pixels = vec![0u32; 1024 * 768];
+        let cells = Box::leak(vec![0u16; 100].into_boxed_slice());
+        let mut display = DebugDisplay::new(1024, 768, 1024, pixels.as_mut_ptr(), cells);
+        assert_eq!((display.cols, display.rows), (100, 1));
+        for _ in 0..3 {
+            display.write(&[b'K'; 250]);
+        }
     }
 }
