-                    };
+    fn put(&mut self, x: usize, y: usize, cell: u16) {
+        let slot = &mut self.cells[y * self.cols + x];
+        if *slot != cell {
+            *slot = cell;
+            self.draw_cell(x, y, cell);
+        }
+    }
+
+    fn pixel(&self, x: usize, y: usize) -> *mut u32 {
+        unsafe { self.display.onscreen_ptr.add(y * self.display.stride + x) }
+    }
+
+    fn draw_cell(&mut self, x: usize, y: usize, cell: u16) {
+        let colour = if cell & ORANGE_CELL != 0 {
+            ORANGE
+        } else {
+            WHITE
+        };
+        let font_i = GLYPH_H * usize::from(cell as u8);
+        let glyph = FONT.get(font_i..font_i + GLYPH_H).unwrap_or(&[0; GLYPH_H]);
+        let (cell_w, cell_h) = (GLYPH_W * self.scale, GLYPH_H * self.scale);
+        let (px, py) = (x * cell_w, y * cell_h);
+
+        for gy in 0..cell_h {
+            let bits = glyph[gy / self.scale];
+            for gx in 0..cell_w {
+                let on = (bits >> (7 - gx / self.scale)) & 1 == 1;
+                unsafe {
+                    self.pixel(px + gx, py + gy)
+                        .write_volatile(if on { colour } else { BLACK });
                 }
             }
         }
+        self.mark_dirty(py, py + cell_h);
+    }
+
+    fn clear_screen(&mut self) {
+        for y in 0..self.display.height {
+            for x in 0..self.display.width {
+                unsafe { self.pixel(x, y).write_volatile(BLACK) };
+            }
+        }
+        self.mark_dirty(0, self.display.height);
+        self.flush();
+    }
+
+    fn mark_dirty(&mut self, start: usize, end: usize) {
+        self.dirty = Some(match self.dirty {
+            Some((s, e)) => (s.min(start), e.max(end)),
+            None => (start, end),
+        });
+    }
+
+    fn flush(&mut self) {
+        let Some((start, end)) = self.dirty.take() else {
+            return;
+        };
+        if self.clean_cache {
+            let row_bytes = self.display.stride * 4;
+            clean_data_to_poc(self.pixel(0, start) as usize, (end - start) * row_bytes);
+        }
+    }
+}
