+// SPDX-License-Identifier: MIT
+//! Interrupt-controller topology rules that do not depend on the FDT parser.
+//!
+//! Host test: `rustc --edition=2024 --test src/dtb/irq_topology.rs -o /tmp/irq-topology && /tmp/irq-topology`
+
+/// Whether an interrupt-parent link from controller `own` to `parent` places
+/// `own` below another controller in the init tree.
+///
+/// A controller whose interrupt parent resolves to itself is a root, as in
+/// Linux `of_irq_init`. The SDM845 GIC lists its maintenance PPI through the
+/// root `interrupt-parent`, which names the GIC itself.
+pub fn is_parent_link(own: u32, parent: u32) -> bool {
+    own != parent
+}
+
+#[cfg(test)]
+mod tests {
+    use super::is_parent_link;
+
+    const GIC: u32 = 0x01;
+    const TLMM: u32 = 0x4a;
+    const PDC: u32 = 0x8d;
+    const PM8998_GPIO: u32 = 0xf3;
+
+    /// Phandles and interrupt-parent links from the OnePlus 6 U-Boot DTB.
+    fn enchilada() -> Vec<(u32, Vec<u32>)> {
+        vec![
+            (TLMM, vec![GIC, PDC]),
+            (PDC, vec![GIC]),
+            (PM8998_GPIO, vec![]),
+            (GIC, vec![GIC]),
+        ]
+    }
+
+    fn roots(chips: &[(u32, Vec<u32>)]) -> Vec<u32> {
+        chips
+            .iter()
+            .filter(|(own, parents)| !parents.iter().any(|p| is_parent_link(*own, *p)))
+            .map(|(own, _)| *own)
+            .collect()
+    }
+
+    #[test]
+    fn self_parented_gic_is_a_root() {
+        assert!(!is_parent_link(GIC, GIC));
+        assert!(roots(&enchilada()).contains(&GIC));
+    }
+
+    #[test]
+    fn tlmm_and_pdc_stay_below_the_gic() {
+        assert!(is_parent_link(TLMM, GIC));
+        assert!(is_parent_link(TLMM, PDC));
+        assert!(is_parent_link(PDC, GIC));
+        assert_eq!(roots(&enchilada()), vec![PM8998_GPIO, GIC]);
+    }
+}
