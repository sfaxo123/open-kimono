+/// Resolve the interrupt domain using the nearest ancestor's interrupt-parent.
+/// The fdt crate only checks the immediate DT parent, which is commonly a bus
+/// node without #interrupt-cells (for example QEMU virt's /soc).
+pub(crate) fn interrupt_parent(fdt: &Fdt, target: &FdtNode) -> Option<PHandle> {
+    let mut domains: Vec<Option<PHandle>> = Vec::new();
+    // all_nodes visits descendants only; its depth 1 nodes are root children.
+    let root = fdt.find_node("/")?;
+    domains.push(
+        root.raw_property("interrupt-parent")
+            .and_then(|p| p.as_value::<u32>().ok())
+            .map(PHandle::new)
+            .or_else(|| {
+                root.raw_property("interrupt-controller")
+                    .and_then(|_| root.property::<PHandle>())
+            }),
+    );
+    for (depth, node) in fdt.all_nodes() {
+        domains.truncate(depth);
+        let inherited = domains.last().copied().flatten();
+        let explicit = node
+            .raw_property("interrupt-parent")
+            .and_then(|p| p.as_value::<u32>().ok())
+            .map(PHandle::new);
+        let parent = explicit.or(inherited);
+        if node.id() == target.id() {
+            return parent;
+        }
+        let child_domain = if node.raw_property("interrupt-controller").is_some() {
+            node.property::<PHandle>().or(parent)
+        } else {
+            parent
+        };
+        domains.push(child_domain);
+    }
+    None
+}
+
+fn cell(data: &[u8]) -> Option<u32> {
+    Some(u32::from_be_bytes(data.get(..4)?.try_into().ok()?))
+}
+
+fn irq_cell(data: &[u8]) -> Option<IrqCell> {
+    match data {
+        [a, b, c, d] => Some(IrqCell::L1(u32::from_be_bytes([*a, *b, *c, *d]))),
+        [a, b, c, d, e, f, g, h] => Some(IrqCell::L2(
+            u32::from_be_bytes([*a, *b, *c, *d]),
+            u32::from_be_bytes([*e, *f, *g, *h]),
+        )),
+        [a, b, c, d, e, f, g, h, i, j, k, l] => Some(IrqCell::L3(
+            u32::from_be_bytes([*a, *b, *c, *d]),
+            u32::from_be_bytes([*e, *f, *g, *h]),
+            u32::from_be_bytes([*i, *j, *k, *l]),
+        )),
+        _ => None,
+    }
+}
+
+/// Decode both DT interrupt forms without invoking fdt's panicking legacy
+/// parser. Each extended entry supplies its own parent and cell width.
+pub(crate) fn node_interrupts(fdt: &Fdt, node: &FdtNode) -> Vec<(PHandle, IrqCell)> {
+    let mut result = Vec::new();
+    if let Some(prop) = node.raw_property("interrupts-extended") {
+        let mut data = prop.value;
+        while !data.is_empty() {
+            let Some(phandle) = cell(data).map(PHandle::new) else {
+                break;
+            };
+            let Some(parent) = fdt.root().resolve_phandle(phandle) else {
+                break;
+            };
+            let Some(cells) = parent.property::<InterruptCells>() else {
+                break;
+            };
+            let Some(length) = cells.0.checked_mul(4) else {
+                break;
+            };
+            let Some(end) = 4usize.checked_add(length) else {
+                break;
+            };
+            let Some(spec) = data.get(4..end) else { break };
+            if let Some(irq) = irq_cell(spec) {
+                result.push((phandle, irq));
+            }
+            data = &data[end..];
+        }
+    } else if let Some(prop) = node.raw_property("interrupts") {
+        let Some(phandle) = interrupt_parent(fdt, node) else {
+            warn!("no interrupt parent for {}", node.name());
+            return result;
+        };
+        let Some(parent) = fdt.root().resolve_phandle(phandle) else {
+            warn!(
+                "unresolved interrupt parent 0x{:x} for {}",
+                phandle.as_u32(),
+                node.name()
+            );
+            return result;
+        };
+        let Some(cells) = parent.property::<InterruptCells>() else {
+            warn!(
+                "interrupt parent 0x{:x} lacks #interrupt-cells for {}",
+                phandle.as_u32(),
+                node.name()
+            );
+            return result;
+        };
+        let Some(length) = cells.0.checked_mul(4).filter(|length| *length != 0) else {
+            return result;
+        };
+        for spec in prop.value.chunks_exact(length) {
+            if let Some(irq) = irq_cell(spec) {
+                result.push((phandle, irq));
+            }
+        }
+    }
+    result
+}
