@@ -0,0 +1,191 @@
+use std::vec::Vec;
+
+use super::{model::GeniModel, reg, *};
+
+fn port() -> SerialPort<GeniModel> {
+    SerialPort::new(GeniModel::new(PROTOCOL_UART))
+}
+
+fn count_writes(port: &SerialPort<GeniModel>, offset: usize) -> usize {
+    port.mmio()
+        .writes()
+        .iter()
+        .filter(|&&(o, _)| o == offset)
+        .count()
+}
+
+#[test]
+fn init_write_trace_matches_spec_sequence() {
+    let mut port = port();
+    assert_eq!(port.init(None), Ok(()));
+    assert_eq!(
+        port.mmio().writes(),
+        vec![
+            (reg::S_CMD_CTRL, CMD_CTRL_ABORT),
+            (reg::S_IRQ_CLEAR, IRQ_CMD_DONE | IRQ_CMD_ABORT),
+            (reg::FORCE_DEFAULT, 1),
+            (reg::GSI_EVENT_EN, 0),
+            (reg::IRQ_EN, 0),
+            (reg::M_IRQ_CLEAR, u32::MAX),
+            (reg::S_IRQ_CLEAR, u32::MAX),
+            (reg::TX_PACKING_CFG0, 0xf),
+            (reg::TX_PACKING_CFG1, 0),
+            (reg::RX_PACKING_CFG0, 0xf),
+            (reg::RX_PACKING_CFG1, 0),
+            (reg::RX_WATERMARK, 8),
+            (reg::RX_RFR_WATERMARK, 14),
+            (reg::UART_TX_TRANS_CFG, UART_CTS_MASK),
+            (reg::UART_TX_PARITY_CFG, 0),
+            (reg::UART_RX_TRANS_CFG, 0),
+            (reg::UART_RX_PARITY_CFG, 0),
+            (reg::UART_TX_WORD_LEN, 8),
+            (reg::UART_RX_WORD_LEN, 8),
+            (reg::UART_TX_STOP_BIT_LEN, 0),
+            (reg::S_CMD0, 0x0800_0000),
+        ]
+    );
+    assert!(port.mmio().rx_armed());
+}
+
+#[test]
+fn init_rejects_non_uart_firmware_without_touching_registers() {
+    let mut port = SerialPort::new(GeniModel::new(1));
+    assert_eq!(port.init(None), Err(InitError::NotUart { protocol: 1 }));
+    assert!(port.mmio().writes().is_empty());
+}
+
+#[test]
+fn init_aborts_a_tx_command_that_never_completes() {
+    let mut port = port();
+    port.mmio().set_tx_active();
+    assert_eq!(port.init(None), Ok(()));
+    let writes = port.mmio().writes();
+    assert_eq!(writes[0], (reg::M_CMD_CTRL, CMD_CTRL_ABORT));
+    assert_eq!(writes[1], (reg::M_IRQ_CLEAR, IRQ_CMD_DONE | IRQ_CMD_ABORT));
+}
+
+#[test]
+fn init_selects_fifo_mode() {
+    let mut port = port();
+    port.mmio().set_reg(reg::DMA_MODE_EN, 1);
+    assert_eq!(port.init(None), Ok(()));
+    assert_eq!(port.mmio().reg(reg::DMA_MODE_EN), 0);
+}
+
+#[test]
+fn init_programs_both_sequencer_clocks_when_rate_is_known() {
+    let mut port = port();
+    assert_eq!(port.init(Some((7_372_800, 115_200))), Ok(()));
+    assert_eq!(port.mmio().reg(reg::M_CLK_CFG), 0x21);
+    assert_eq!(port.mmio().reg(reg::S_CLK_CFG), 0x21);
+}
+
+#[test]
+fn init_leaves_firmware_clock_alone_without_a_rate() {
+    let mut port = port();
+    port.mmio().set_reg(reg::M_CLK_CFG, 0x21);
+    assert_eq!(port.init(None), Ok(()));
+    assert_eq!(count_writes(&port, reg::M_CLK_CFG), 0);
+    assert_eq!(count_writes(&port, reg::S_CLK_CFG), 0);
+}
+
+#[test]
+fn init_refuses_an_unreachable_baud_before_writing() {
+    let mut port = port();
+    assert_eq!(
+        port.init(Some((19_200_000, 115_200))),
+        Err(InitError::NoClockDivider {
+            se_clock_hz: 19_200_000,
+            baud: 115_200
+        })
+    );
+    assert!(port.mmio().writes().is_empty());
+}
+
+#[test]
+fn clock_divider_accepts_exact_and_near_rates_only() {
+    assert_eq!(clock_divider(7_372_800, 115_200), Some(2));
+    assert_eq!(clock_divider(14_745_600, 115_200), Some(4));
+    assert_eq!(clock_divider(48_000_000, 115_200), Some(13));
+    assert_eq!(clock_divider(19_200_000, 115_200), None);
+    assert_eq!(clock_divider(1_000, 115_200), None);
+    assert_eq!(clock_divider(7_372_800, 0), None);
+    assert_eq!(clock_divider(u32::MAX, 1), None);
+}
+
+#[test]
+fn write_sends_one_command_per_byte_and_expands_newline() {
+    let mut port = port();
+    port.init(None).unwrap();
+    port.mmio().clear_writes();
+
+    port.write(b"ok\n");
+
+    assert_eq!(port.mmio().tx(), b"ok\r\n");
+    assert_eq!(count_writes(&port, reg::M_CMD0), 4);
+    assert_eq!(count_writes(&port, reg::TX_FIFO), 4);
+    assert!(port
+        .mmio()
+        .writes()
+        .iter()
+        .filter(|&&(o, _)| o == reg::UART_TX_TRANS_LEN)
+        .all(|&(_, v)| v == 1));
+    assert_eq!(port.mmio().read(reg::M_IRQ_STATUS), 0);
+}
+
+#[test]
+fn send_aborts_when_the_tx_fifo_never_asks_for_data() {
+    let mut model = GeniModel::new(PROTOCOL_UART);
+    model.stall_tx = true;
+    let mut port = SerialPort::new(model);
+
+    port.send(b'x');
+
+    assert!(port.mmio().tx().is_empty());
+    assert_eq!(count_writes(&port, reg::TX_FIFO), 0);
+    assert_eq!(count_writes(&port, reg::M_CMD_CTRL), 1);
+    assert_eq!(port.mmio().read(reg::STATUS) & STATUS_M_CMD_ACTIVE, 0);
+
+    port.write(b"more");
+    assert_eq!(count_writes(&port, reg::M_CMD0), 1);
+}
+
+fn drain(port: &mut SerialPort<GeniModel>) -> Vec<u8> {
+    let mut out = Vec::new();
+    port.poll_rx(|c| out.push(c));
+    out
+}
