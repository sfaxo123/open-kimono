+#[test]
+fn poll_rx_unpacks_full_and_partial_fifo_words() {
+    let mut port = port();
+    port.init(None).unwrap();
+    port.mmio().inject_rx(b"hello");
+    assert_eq!(drain(&mut port), b"hello");
+}
+
+#[test]
+fn poll_rx_treats_zero_valid_bytes_in_last_word_as_four() {
+    let mut port = port();
+    port.init(None).unwrap();
+    port.mmio().inject_rx(b"abcdefgh");
+    assert_eq!(drain(&mut port), b"abcdefgh");
+}
+
+#[test]
+fn poll_rx_rearms_an_idle_rx_sequencer() {
+    let mut port = port();
+    port.mmio().inject_rx(b"z");
+    assert!(!port.mmio().rx_armed());
+    assert_eq!(drain(&mut port), b"z");
+    assert!(port.mmio().rx_armed());
+    assert!(!port.poll_rx(|_| {}));
+}
