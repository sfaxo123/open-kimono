+#[test]
+fn enable_irq_keeps_se_interrupt_delivery_masked() {
+    let mut port = port();
+    port.mmio().set_reg(reg::IRQ_EN, 0xc);
+    port.enable_irq();
+    assert_eq!(port.mmio().reg(reg::IRQ_EN), 0);
