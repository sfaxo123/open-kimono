+/// Byte spans of the four arbiter regions, as granted by the FDT and
+/// preserved by the kernel glue. The ArbBus surface is infallible —
+/// a volatile access outside the granted mapping faults instead of
+/// returning an error — so the bounded transaction
+/// (`set_reason_with_bus_bounded`) proves up front, before the first
+/// channel access, that every offset it can issue fits the span of
+/// the region it addresses.
+#[derive(Clone, Copy, Debug, PartialEq, Eq)]
+pub struct ArbBounds {
+    /// Span of the core region (VERSION, FEATURES, APID map).
+    pub core: usize,
+    /// Span of the RW-channel region.
+    pub chnls: usize,
+    /// Span of the observer-channel region.
+    pub obsrvr: usize,
+    /// Span of the config region (APID ownership table).
+    pub cnfg: usize,
+}
+
+impl ArbBounds {
+    /// Span of one region.
+    pub fn span(&self, region: Region) -> usize {
+        match region {
+            Region::Core => self.core,
+            Region::Chnls => self.chnls,
+            Region::Obsrvr => self.obsrvr,
+            Region::Cnfg => self.cnfg,
+        }
+    }
+}
+
+/// True when the `len`-byte access at `offset` lies entirely inside a
+/// region of `span` bytes. Checked arithmetic: an end that overflows
+/// is not inside.
+pub const fn access_fits(offset: usize, len: usize, span: usize) -> bool {
+    match offset.checked_add(len) {
+        Some(end) => end <= span,
+        None => false,
+    }
+}
+
+/// How many APID entries the discovery scan may touch under `bounds`:
+/// the scan reads one map entry per APID in the core region and one
+/// ownership word per APID in the cnfg region, so it is capped by
+/// whichever table runs out of span first.
+pub fn apid_scan_cap(bounds: &ArbBounds) -> u32 {
+    fn table_cap(table_base: usize, span: usize) -> u32 {
+        if !access_fits(table_base, 4, span) {
+            return 0;
+        }
+        // Entries sit at table_base + 4*i; entry i fits iff
+        // table_base + 4*(i+1) <= span.
+        u32::try_from((span - table_base) / 4).unwrap_or(u32::MAX)
+    }
+    table_cap(ARB_APID_MAP_BASE, bounds.core).min(table_cap(ARB_OWNER_TABLE, bounds.cnfg))
+}
+
+/// True when the channel window for `apid` — [`stride` * apid,
+/// `stride` * apid + `max_offset` + 4) — lies inside `span`.
+fn channel_fits(stride: usize, apid: u32, max_offset: usize, span: usize) -> bool {
+    match stride.checked_mul(apid as usize) {
+        Some(base) => access_fits(base, max_offset + 4, span),
+        None => false,
+    }
+}
+
+/// Prove the chosen APID's channel windows fit the chnls and obsrvr
+/// spans before any channel access. Channel bases are APID-derived,
+/// so a large APID from a corrupt map could otherwise address far
+/// outside the granted regions. Observer accesses reach CHAN_RDATA0;
+/// RW accesses reach CHAN_WDATA0.
+fn check_channel_extents(apid: u32, bounds: &ArbBounds) -> Result<(), &'static str> {
+    if !channel_fits(OBS_CHAN_STRIDE, apid, CHAN_RDATA0, bounds.obsrvr) {
+        return Err("SPMI observer channel exceeds the FDT obsrvr span");
+    }
+    if !channel_fits(RW_CHAN_STRIDE, apid, CHAN_WDATA0, bounds.chnls) {
+        return Err("SPMI RW channel exceeds the FDT chnls span");
+    }
+    Ok(())
+}
