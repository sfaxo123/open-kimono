+    fn apid_scan_cap_is_bounded_by_both_tables() {
+        let generous = ArbBounds {
+            core: 0x1_0000,
+            chnls: 0x1_0000,
+            obsrvr: 0x1_0000,
+            cnfg: 0x1_0000,
+        };
+        // Core table: (0x10000 - 0x900) / 4 = 15808 entries; cnfg
+        // table: (0x10000 - 0x700) / 4 = 15936. The smaller caps.
+        assert_eq!(apid_scan_cap(&generous), 15808);
+        let core_short = ArbBounds {
+            core: ARB_APID_MAP_BASE + 8,
+            ..generous
+        };
+        assert_eq!(apid_scan_cap(&core_short), 2);
+        let cnfg_short = ArbBounds {
+            cnfg: ARB_OWNER_TABLE + 4,
+            ..generous
+        };
+        assert_eq!(apid_scan_cap(&cnfg_short), 1);
+        let core_tiny = ArbBounds {
+            core: ARB_APID_MAP_BASE + 3,
+            ..generous
+        };
+        assert_eq!(apid_scan_cap(&core_tiny), 0);
+    }
+
+    /// Spans comfortably larger than anything the fake arbiter uses.
+    fn generous_bounds() -> ArbBounds {
+        ArbBounds {
+            core: 0x10_0000,
+            chnls: 0x10_0000,
+            obsrvr: 0x10_0000,
+            cnfg: 0x10_0000,
+        }
+    }
+
+    #[test]
+    fn bounded_transaction_matches_unbounded() {
+        let mut bus = FakeBus::with_apids(&[(0x008, 3), (0x008, 0)]);
+        bus.read_bytes = [0x55, 0x05].into();
+        assert_eq!(
+            set_reason_with_bus_bounded(
+                &mut bus,
+                0,
+                PON_REG_TEST,
+                REASON_BOOTLOADER,
+                &generous_bounds()
+            ),
+            Ok(0x05)
+        );
+    }
+
+    #[test]
+    fn bounded_refuses_invalid_target_before_any_io() {
+        let mut bus = FakeBus::with_apids(&[(0x008, 0)]);
+        let result = set_reason_with_bus_bounded(
+            &mut bus,
+            16,
+            PON_REG_TEST,
+            REASON_BOOTLOADER,
+            &generous_bounds(),
+        );
+        assert!(result.is_err());
+        assert!(bus.writes.is_empty());
+    }
+
+    #[test]
+    fn bounded_refuses_tiny_core_span() {
+        let mut bus = FakeBus::with_apids(&[(0x008, 0)]);
+        bus.read_bytes = [0x00, 0x04].into();
+        let bounds = ArbBounds {
+            core: 4,
+            ..generous_bounds()
+        };
+        let result =
+            set_reason_with_bus_bounded(&mut bus, 0, PON_REG_TEST, REASON_BOOTLOADER, &bounds);
+        assert_eq!(
+            result,
+            Err("SPMI arbiter core span too small for the header registers")
+        );
+        assert!(bus.writes.is_empty());
+    }
+
+    #[test]
+    fn bounded_discovery_is_capped_by_core_span() {
+        // The write-owned APID sits at index 2, but the core span
+        // holds only two map entries: the bounded scan must stay
+        // inside the span, so it cannot find it — and must not write.
+        let mut bus = FakeBus::with_apids(&[(0x009, 0), (0x009, 0), (0x008, 0)]);
+        bus.read_bytes = [0x00, 0x04].into();
+        let bounds = ArbBounds {
+            core: ARB_APID_MAP_BASE + 8,
+            ..generous_bounds()
+        };
+        let result =
+            set_reason_with_bus_bounded(&mut bus, 0, PON_REG_TEST, REASON_BOOTLOADER, &bounds);
+        assert_eq!(result, Err("no write-owned SPMI APID for the PON peripheral"));
+        assert!(bus.writes.is_empty());
+    }
+
+    #[test]
+    fn bounded_refuses_small_obsrvr_span() {
+        let mut bus = FakeBus::with_apids(&[(0x008, 0)]);
+        bus.read_bytes = [0x00, 0x04].into();
+        // APID 0's observer window needs [0, 0x1C); grant only 0x18.
+        let bounds = ArbBounds {
+            obsrvr: CHAN_RDATA0,
+            ..generous_bounds()
+        };
+        let result =
+            set_reason_with_bus_bounded(&mut bus, 0, PON_REG_TEST, REASON_BOOTLOADER, &bounds);
+        assert_eq!(result, Err("SPMI observer channel exceeds the FDT obsrvr span"));
+        assert!(bus.writes.is_empty());
+    }
+
+    #[test]
+    fn bounded_refuses_small_chnls_span() {
+        // APID 1 is the write-owned one; its RW window starts at
+        // 0x10000 and needs 0x14 bytes. Grant exactly the base.
+        let mut bus = FakeBus::with_apids(&[(0x008, 3), (0x008, 0)]);
+        bus.read_bytes = [0x00, 0x04].into();
+        let bounds = ArbBounds {
+            chnls: RW_CHAN_STRIDE,
+            ..generous_bounds()
+        };
+        let result =
+            set_reason_with_bus_bounded(&mut bus, 0, PON_REG_TEST, REASON_BOOTLOADER, &bounds);
+        assert_eq!(result, Err("SPMI RW channel exceeds the FDT chnls span"));
+        assert!(bus.writes.is_empty());
+    }
 }
