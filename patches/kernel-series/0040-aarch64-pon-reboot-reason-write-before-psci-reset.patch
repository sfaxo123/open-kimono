+// ---------------------------------------------------------------------------
+// Host tests (standalone: rustc --test on this file).
+// ---------------------------------------------------------------------------
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+    use std::collections::{HashMap, VecDeque};
+
+    /// Fake arbiter register file. Plain registers live in `regs`;
+    /// channel STATUS is scripted: a CMD write arms the channel, whose
+    /// STATUS then reports Pending `done_after` times before Done,
+    /// unless a fault class or `stuck` overrides it. Observer reads pop
+    /// bytes from `read_bytes` into RDATA0 when the read CMD is written.
+    struct FakeBus {
+        regs: HashMap<(Region, usize), u32>,
+        writes: std::vec::Vec<(Region, usize, u32)>,
+        read_bytes: VecDeque<u8>,
+        pending: HashMap<(Region, usize), u32>,
+        done_after: u32,
+        fault: Option<StatusClass>,
+        stuck: bool,
+        clock: u64,
+        tick: u64,
+    }
+
+    impl FakeBus {
+        fn new() -> Self {
+            Self {
+                regs: HashMap::new(),
+                writes: std::vec::Vec::new(),
+                read_bytes: VecDeque::new(),
+                pending: HashMap::new(),
+                done_after: 0,
+                fault: None,
+                stuck: false,
+                clock: 0,
+                tick: 10,
+            }
+        }
+
+        /// A v5 arbiter whose APID map is `entries` = (ppid, write_ee)
+        /// per APID index.
+        fn with_apids(entries: &[(u32, u32)]) -> Self {
+            let mut bus = Self::new();
+            bus.regs.insert((Region::Core, ARB_VERSION), 0x5000_0000);
+            bus.regs
+                .insert((Region::Core, ARB_FEATURES), entries.len() as u32);
+            for (apid, (ppid, ee)) in entries.iter().enumerate() {
+                bus.regs.insert(
+                    (Region::Core, ARB_APID_MAP_BASE + 4 * apid),
+                    (ppid & 0xFFF) << 8,
+                );
+                bus.regs
+                    .insert((Region::Cnfg, ARB_OWNER_TABLE + 4 * apid), *ee);
+            }
+            bus
+        }
+    }
+
+    impl ArbBus for FakeBus {
+        fn read32(&mut self, region: Region, offset: usize) -> u32 {
+            // STATUS offsets sit at chan + 0x08 in both channel spaces.
+            if matches!(region, Region::Chnls | Region::Obsrvr) && offset % 0x80 == CHAN_STATUS {
+                let chan = offset - CHAN_STATUS;
+                if let Some(fault) = self.fault {
+                    return match fault {
+                        StatusClass::Failed => 1 << 1,
+                        StatusClass::Denied => 1 << 2,
+                        StatusClass::Dropped => 1 << 3,
+                        _ => 0,
+                    };
+                }
+                if self.stuck {
+                    return 0;
+                }
+                return match self.pending.get_mut(&(region, chan)) {
+                    Some(left) if *left > 0 => {
+                        *left -= 1;
+                        0
+                    }
+                    _ => 1, // BIT(0) = done
+                };
+            }
+            *self.regs.get(&(region, offset)).unwrap_or(&0)
+        }
+
+        fn write32(&mut self, region: Region, offset: usize, value: u32) {
+            self.writes.push((region, offset, value));
+            self.regs.insert((region, offset), value);
+            // A CMD write arms the channel's STATUS script.
+            if matches!(region, Region::Chnls | Region::Obsrvr) && offset % 0x80 == CHAN_CMD {
+                self.pending.insert((region, offset), self.done_after);
+                if region == Region::Obsrvr && value == ext_cmd(true, PON_REG_TEST, 1) {
+                    let byte = self.read_bytes.pop_front().unwrap_or(0);
+                    self.regs
+                        .insert((Region::Obsrvr, offset + CHAN_RDATA0), u32::from(byte));
+                }
+            }
+        }
+
+        fn now_us(&mut self) -> u64 {
+            self.clock += self.tick;
+            self.clock
+        }
+    }
+
+    const PON_REG_TEST: u32 = 0x088F;
+
+    #[test]
+    fn ppid_encoding() {
+        assert_eq!(ppid(0, 0x088F), 0x008);
+        assert_eq!(ppid(0, 0x0800), 0x008);
+        assert_eq!(ppid(0, 0x08FF), 0x008);
+        assert_eq!(ppid(0, 0x0900), 0x009);
+        assert_eq!(ppid(1, 0x088F), 0x108);
+    }
+
+    #[test]
+    fn cmd_word_encoding() {
+        assert_eq!(ext_cmd(false, 0x088F, 1), 0x0000_08F0);
+        assert_eq!(ext_cmd(true, 0x088F, 1), 0x0800_08F0);
+        // Multi-byte: bc field is len - 1.
+        assert_eq!(ext_cmd(false, 0x088F, 4), 0x0000_08F3);
+        assert_eq!(ext_cmd(true, 0x0800, 1), 0x0800_0000);
+    }
+
+    #[test]
+    fn map_entry_decode() {
+        assert_eq!(map_entry_ppid(0x008 << 8), 0x008);
+        // BIT(24) irq-owner flag is not part of the PPID.
+        assert_eq!(map_entry_ppid((1 << 24) | (0x123 << 8)), 0x123);
+        assert_eq!(map_entry_ppid(0), 0);
+    }
+
+    #[test]
+    fn reason_field_and_rmw_math() {
+        assert_eq!(reason_field(0), REASON_NONE);
+        assert_eq!(reason_field(1), REASON_RECOVERY);
+        assert_eq!(reason_field(2), REASON_BOOTLOADER);
+        assert_eq!(REASON_BOOTLOADER, 0x04);
+        assert_eq!(REASON_RECOVERY, 0x02);
+        // (old & 0x01) | field: bit 0 always preserved.
+        assert_eq!(rmw_reason(0x00, REASON_BOOTLOADER), 0x04);
+        assert_eq!(rmw_reason(0xFF, REASON_BOOTLOADER), 0x05);
+        assert_eq!(rmw_reason(0x01, REASON_NONE), 0x01);
+        assert_eq!(rmw_reason(0x55, REASON_RECOVERY), 0x03);
+        assert_eq!(rmw_reason(0xFE, REASON_NONE), 0x00);
+        assert_eq!(rmw_reason(0x04, REASON_NONE), 0x00);
+        // The raw-magic form of the same math.
+        for old in [0x00u8, 0xFF, 0x01, 0x55] {
+            for magic in [0u8, 1, 2] {
+                assert_eq!(
+                    rmw_reason(old, reason_field(magic)),
+                    (old & 0x01) | (magic << 1)
+                );
+            }
+        }
+    }
+
+    #[test]
+    fn status_classification() {
+        assert_eq!(classify_status(0), StatusClass::Pending);
+        assert_eq!(classify_status(1), StatusClass::Done);
+        assert_eq!(classify_status(1 << 1), StatusClass::Failed);
+        assert_eq!(classify_status(1 << 2), StatusClass::Denied);
+        assert_eq!(classify_status(1 << 3), StatusClass::Dropped);
+        // Errors win over done.
+        assert_eq!(classify_status(0b0011), StatusClass::Failed);
+        assert_eq!(classify_status(0b0101), StatusClass::Denied);
+        assert_eq!(classify_status(0b1001), StatusClass::Dropped);
+    }
+
+    #[test]
+    fn apid_selection_duplicate_ppid_ownership_rule() {
+        // APID 0 maps PPID 0x008 but is owned by ee 3; APID 1 maps an
+        // unrelated PPID; APID 2 maps PPID 0x008 with write_ee == 0.
+        let mut bus = FakeBus::with_apids(&[(0x008, 3), (0x009, 0), (0x008, 0)]);
+        assert_eq!(discover_apid(&mut bus, 0x008), Ok(2));
+        // No write-owned candidate -> error.
+        let mut bus = FakeBus::with_apids(&[(0x008, 3), (0x008, 1)]);
+        assert_eq!(
+            discover_apid(&mut bus, 0x008),
+            Err("no write-owned SPMI APID for the PON peripheral")
+        );
+        // PPID absent entirely -> error.
+        let mut bus = FakeBus::with_apids(&[(0x009, 0)]);
+        assert!(discover_apid(&mut bus, 0x008).is_err());
+        // The candidate predicate itself.
+        assert!(apid_is_candidate(0x008 << 8, 0, 0x008));
+        assert!(!apid_is_candidate(0x008 << 8, 2, 0x008));
+        assert!(!apid_is_candidate(0x009 << 8, 0, 0x008));
+    }
+
+    #[test]
+    fn version_gate_refuses_pre_v5() {
+        let mut bus = FakeBus::with_apids(&[(0x008, 0)]);
+        bus.regs.insert((Region::Core, ARB_VERSION), 0x4000_0000);
+        assert_eq!(
+            set_reason_with_bus(&mut bus, 0, PON_REG_TEST, REASON_BOOTLOADER),
+            Err("SPMI arbiter is not v5 (VERSION gate)")
+        );
+        // The refusal happens before any channel write.
+        assert!(bus
+            .writes
+            .iter()
+            .all(|(region, _, _)| *region != Region::Chnls));
+    }
+
+    #[test]
+    fn full_transaction_writes_and_verifies() {
+        let mut bus = FakeBus::with_apids(&[(0x008, 3), (0x008, 0)]);
+        bus.read_bytes = [0x55, 0x05].into();
+        let written = set_reason_with_bus(&mut bus, 0, PON_REG_TEST, REASON_BOOTLOADER);
+        // old 0x55 -> (0x55 & 1) | 0x04 = 0x05, APID 1 selected.
+        assert_eq!(written, Ok(0x05));
+        let wdata = bus
+            .writes
+            .iter()
+            .find(|(r, o, _)| *r == Region::Chnls && *o == RW_CHAN_STRIDE + CHAN_WDATA0)
+            .map(|(_, _, v)| *v);
+        assert_eq!(wdata, Some(0x05));
+        let wcmd = bus
+            .writes
+            .iter()
+            .find(|(r, o, _)| *r == Region::Chnls && *o == RW_CHAN_STRIDE + CHAN_CMD)
+            .map(|(_, _, v)| *v);
+        assert_eq!(wcmd, Some(0x0000_08F0));
+        let rcmd = bus
+            .writes
+            .iter()
+            .find(|(r, o, _)| *r == Region::Obsrvr && *o == OBS_CHAN_STRIDE + CHAN_CMD)
+            .map(|(_, _, v)| *v);
+        assert_eq!(rcmd, Some(0x0800_08F0));
+    }
+
+    #[test]
+    fn full_transaction_none_reason_is_deterministic() {
+        let mut bus = FakeBus::with_apids(&[(0x008, 0)]);
+        bus.read_bytes = [0xFF, 0x01].into();
+        // A stale bootloader field (in 0xFF) is cleared; bit 0 survives.
+        assert_eq!(
+            set_reason_with_bus(&mut bus, 0, PON_REG_TEST, REASON_NONE),
+            Ok(0x01)
+        );
+    }
+
+    #[test]
+    fn read_back_mismatch_is_an_error() {
+        let mut bus = FakeBus::with_apids(&[(0x008, 0)]);
+        bus.read_bytes = [0x55, 0x55].into();
+        assert_eq!(
+            set_reason_with_bus(&mut bus, 0, PON_REG_TEST, REASON_BOOTLOADER),
+            Err("PON reboot-reason read-back mismatch")
+        );
+    }
+
+    #[test]
+    fn status_faults_are_distinct_errors() {
+        for (fault, msg) in [
+            (StatusClass::Failed, "SPMI arbiter transaction failed"),
+            (StatusClass::Denied, "SPMI arbiter transaction denied"),
+            (StatusClass::Dropped, "SPMI arbiter transaction dropped"),
+        ] {
+            let mut bus = FakeBus::with_apids(&[(0x008, 0)]);
+            bus.fault = Some(fault);
+            assert_eq!(
+                set_reason_with_bus(&mut bus, 0, PON_REG_TEST, REASON_BOOTLOADER),
+                Err(msg)
+            );
+        }
+    }
+
+    #[test]
+    fn status_timeout_with_fake_clock() {
+        let mut bus = FakeBus::with_apids(&[(0x008, 0)]);
+        bus.stuck = true;
+        assert_eq!(
+            set_reason_with_bus(&mut bus, 0, PON_REG_TEST, REASON_BOOTLOADER),
+            Err("SPMI arbiter transaction timed out")
+        );
+    }
+
+    #[test]
+    fn pending_then_done_completes() {
+        let mut bus = FakeBus::with_apids(&[(0x008, 0)]);
+        bus.done_after = 3;
+        bus.read_bytes = [0x00, 0x04].into();
+        assert_eq!(
+            set_reason_with_bus(&mut bus, 0, PON_REG_TEST, REASON_BOOTLOADER),
+            Ok(0x04)
+        );
+    }
+
+    #[test]
+    fn env_parse() {
+        assert_eq!(
+            parse_reason_field(b"REDOX_RAMBOOT=1\nREDOX_PON_REBOOT_REASON=bootloader\n"),
+            REASON_BOOTLOADER
+        );
+        assert_eq!(
+            parse_reason_field(b"REDOX_PON_REBOOT_REASON=recovery\n"),
+            REASON_RECOVERY
+        );
+        assert_eq!(parse_reason_field(b"REDOX_RAMBOOT=1\n"), REASON_NONE);
+        assert_eq!(
+            parse_reason_field(b"REDOX_PON_REBOOT_REASON=banana\n"),
+            REASON_NONE
+        );
+        // The key must start the line.
+        assert_eq!(
+            parse_reason_field(b"XREDOX_PON_REBOOT_REASON=bootloader\n"),
+            REASON_NONE
+        );
+        // CRLF endings are tolerated.
+        assert_eq!(
+            parse_reason_field(b"REDOX_PON_REBOOT_REASON=bootloader\r\n"),
+            REASON_BOOTLOADER
+        );
+        assert_eq!(parse_reason_field(b""), REASON_NONE);
+    }
+}
