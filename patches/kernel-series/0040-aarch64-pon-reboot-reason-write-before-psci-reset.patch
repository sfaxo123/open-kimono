+//! Narrow Qualcomm PMIC PON reboot-reason support (SDM845 / pm8998).
+//!
+//! Before a PSCI SYSTEM_RESET, Redox can ask the next boot to land in
+//! fastboot (or recovery) by writing the reboot-mode field of the pm8998
+//! PON peripheral's SOFT_RB_SPARE register over the SPMI PMIC arbiter —
+//! the same write Linux's qcom-pon driver performs for
+//! `reboot bootloader` (drivers/power/reset/qcom-pon.c,
+//! qcom_pon_reboot_mode_write()). The register lives behind the arbiter,
+//! so this module implements the minimal arbiter-v5 transaction from
+//! drivers/spmi/spmi-pmic-arb.c: a version gate, runtime APID discovery
+//! for the PON peripheral's PPID (applying Linux's ee-ownership
+//! preference rule on duplicate PPIDs), an observer-channel read, a
+//! read-modify-write on the RW channel, a status poll, and a read-back
+//! verify (Linux does not verify; we do, because this write gates a
+//! reset).
+//!
+//! Everything here is opt-in (Cargo feature `qcom-pon-reboot-reason`,
+//! default OFF, mirroring `qcom-dload-mode-clear`) and fail-safe: every
+//! error is reported to the caller, which logs it and continues with the
+//! normal PSCI reset. Register values and the transaction sequence are
+//! cited to Linux sources and the phone's pinned DTB in the P4 research
+//! notes (p4-pon-research.md, Q1–Q5).
+//!
+//! The pure layer (constants, encodings, the transaction against the
+//! abstract ArbBus surface, and the boot-env parser) has no kernel
+//! dependencies and is host-tested at the bottom of this file; the
+//! kernel glue (FDT discovery, MMIO) is `#[cfg(not(test))]` so this
+//! file also compiles standalone under `rustc --test`.
+
+#[cfg(not(test))]
+use core::sync::atomic::{AtomicBool, AtomicUsize, Ordering};
+
+// ---------------------------------------------------------------------------
+// Pure layer: constants and encodings.
+// ---------------------------------------------------------------------------
+
+/// Value stored in the PON reason field for a normal boot.
+pub const REASON_NONE: u8 = 0x00;
+/// Value stored in the PON reason field to enter recovery (magic 0x1).
+pub const REASON_RECOVERY: u8 = 0x02;
+/// Value stored in the PON reason field to enter the bootloader /
+/// fastboot (magic 0x2).
+pub const REASON_BOOTLOADER: u8 = 0x04;
+
+/// pm8998 PON is a GEN2 device in qcom-pon terms: the reason field is
+/// GENMASK(7, 1), i.e. the mode magic is shifted left by 1.
+pub const REASON_SHIFT: u32 = 1;
+/// Mask of the reason field inside PON_SOFT_RB_SPARE.
+pub const REASON_MASK: u8 = 0xFE;
+/// Bit 0 of PON_SOFT_RB_SPARE is outside the reason field and is
+/// preserved across the read-modify-write.
+const PRESERVE_MASK: u8 = 0x01;
+
+/// Offset of PON_SOFT_RB_SPARE within the PON peripheral (qcom-pon.c).
+pub const PON_SPARE_OFFSET: u32 = 0x8F;
+
+/// Field value stored for a reboot-mode magic (Linux:
+/// `magic << pon->reason_shift`, then masked by regmap_update_bits).
+pub const fn reason_field(magic: u8) -> u8 {
+    (magic << REASON_SHIFT) & REASON_MASK
+}
+
+/// Read-modify-write math for the reason field: the field is replaced,
+/// bit 0 is preserved. Identical to
+/// `(old & 0x01) | (magic << REASON_SHIFT)` for a raw magic.
+pub const fn rmw_reason(old: u8, field: u8) -> u8 {
+    (old & PRESERVE_MASK) | (field & REASON_MASK)
+}
+
+/// SPMI peripheral ID as the arbiter's APID mapping table encodes it:
+/// PPID = (sid << 8) | (addr >> 8). For the pm8998 PON reason register
+/// (sid 0, addr 0x088f) this is 0x008.
+pub const fn ppid(sid: u32, addr: u32) -> u32 {
+    ((sid << 8) | (addr >> 8)) & 0x0FFF
+}
+
+/// Peripheral ID decoded from an APID mapping-table entry
+/// (spmi-pmic-arb.c: ppid = (entry >> 8) & GENMASK(11, 0); BIT(24) is
+/// the irq-owner flag and is not part of the PPID).
+pub const fn map_entry_ppid(entry: u32) -> u32 {
+    (entry >> 8) & 0x0FFF
+}
+
+/// PMIC arbiter command word for an extended register access. `read`
+/// selects arbiter op EXT_READL (1); writes use EXT_WRITEL (0):
+/// cmd = (opc << 27) | ((addr & 0xFF) << 4) | ((len - 1) & 0x7).
+/// Only the low address byte is carried in the command; the high byte
+/// is already encoded by the choice of APID/PPID. For the PON reason
+/// register (0x088f, 1 byte): write = 0x0000_08F0, read = 0x0800_08F0.
+pub const fn ext_cmd(read: bool, addr: u32, len: u32) -> u32 {
+    ((read as u32) << 27) | ((addr & 0xFF) << 4) | (len.saturating_sub(1) & 0x7)
+}
+
+/// Classification of an arbiter channel STATUS word
+/// (pmic_arb_wait_for_done in spmi-pmic-arb.c).
+#[derive(Clone, Copy, Debug, PartialEq, Eq)]
+pub enum StatusClass {
+    /// BIT(0): the transaction completed.
+    Done,
+    /// No completion or error bit set yet.
+    Pending,
+    /// BIT(1): transaction failed (EIO).
+    Failed,
+    /// BIT(2): transaction denied (EPERM).
+    Denied,
+    /// BIT(3): transaction dropped (EIO).
+    Dropped,
+}
+
+/// Classify a STATUS word. Error bits win over the done bit: a faulted
+/// transaction must not be reported as success even if hardware also
+/// sets BIT(0).
+pub const fn classify_status(status: u32) -> StatusClass {
+    if status & (1 << 1) != 0 {
+        StatusClass::Failed
+    } else if status & (1 << 2) != 0 {
+        StatusClass::Denied
+    } else if status & (1 << 3) != 0 {
+        StatusClass::Dropped
+    } else if status & (1 << 0) != 0 {
+        StatusClass::Done
+    } else {
+        StatusClass::Pending
+    }
+}
+
+/// Boot-environment key that requests a PON reboot reason. It reaches
+/// the kernel exactly the way REDOX_RAMBOOT_TTL does: a build-time
+/// option of the Redox bootloader (bootloader patch 0004's mechanism,
+/// `option_env!`) is written as a `KEY=value` line into the kernel
+/// environment, which the kernel keeps in its bootstrap block and
+/// exposes to kernel code via `crate::startup::init_env`. A sibling
+/// bootloader patch mirroring 0004 supplies this key; without it the
+/// request is simply always "none".
+pub const REASON_ENV_KEY: &[u8] = b"REDOX_PON_REBOOT_REASON";
+
+/// Parse the requested PON reason field out of the bootloader
+/// environment (`KEY=value` lines). Only the exact mode strings the DT
+/// declares for pm8998-pon are honoured (`bootloader`, `recovery`);
+/// an absent key or an unknown value yields REASON_NONE, so the field
+/// written on a feature-enabled reset is always deterministic.
+pub fn parse_reason_field(env: &[u8]) -> u8 {
+    for line in env.split(|byte| *byte == b'\n') {
+        let line = if line.last() == Some(&b'\r') {
+            &line[..line.len() - 1]
+        } else {
+            line
+        };
+        if line.len() > REASON_ENV_KEY.len()
+            && &line[..REASON_ENV_KEY.len()] == REASON_ENV_KEY
+            && line[REASON_ENV_KEY.len()] == b'='
+        {
+            let value = &line[REASON_ENV_KEY.len() + 1..];
+            if value == b"bootloader" {
+                return REASON_BOOTLOADER;
+            }
+            if value == b"recovery" {
+                return REASON_RECOVERY;
+            }
+            return REASON_NONE;
+        }
+    }
+    REASON_NONE
+}
+
+// ---------------------------------------------------------------------------
+// Pure layer: the arbiter transaction against an abstract bus.
+// ---------------------------------------------------------------------------
+
+// Arbiter register layout (spmi-pmic-arb.c, v5 ops).
+const ARB_VERSION: usize = 0x0000;
+const ARB_FEATURES: usize = 0x0004;
+const ARB_APID_MAP_BASE: usize = 0x0900;
+/// Offset of the per-APID ownership table within the cnfg region
+/// (SPMI_OWNERSHIP_PERIPH2OWNER).
+const ARB_OWNER_TABLE: usize = 0x0700;
+/// PMIC_ARB_V5_MIN: refuse to transact with an older arbiter.
+const ARB_V5_MIN: u32 = 0x5000_0000;
+/// APID count is PMIC_ARB_FEATURES & GENMASK(10, 0).
+const APID_COUNT_MASK: u32 = 0x7FF;
+
+// Per-channel register offsets (spmi-pmic-arb.c).
+const CHAN_CMD: usize = 0x00;
+const CHAN_STATUS: usize = 0x08;
+const CHAN_WDATA0: usize = 0x10;
+const CHAN_RDATA0: usize = 0x18;
+/// RW channel base = chnls + 0x10000 * apid (one channel per APID on v5).
+const RW_CHAN_STRIDE: usize = 0x1_0000;
+/// Observer channel base = obsrvr + 0x80 * apid (our ee is 0).
+const OBS_CHAN_STRIDE: usize = 0x80;
+
+/// PMIC_ARB_TIMEOUT_US in Linux.
+const STATUS_TIMEOUT_US: u64 = 1000;
+/// Belt-and-braces poll bound in case the microsecond clock is broken
+/// (e.g. a zero counter frequency): the poll must still terminate.
+const STATUS_MAX_POLLS: u32 = 1_000_000;
+
+/// One of the four SPMI arbiter regions this client touches.
+#[derive(Clone, Copy, Debug, PartialEq, Eq, Hash)]
+pub enum Region {
+    Core,
+    Chnls,
+    Obsrvr,
+    Cnfg,
+}
+
+/// The register/clock surface the arbiter transaction needs. The kernel
+/// implementation performs volatile MMIO; host tests substitute a fake
+/// register file with a scripted clock.
+pub trait ArbBus {
+    fn read32(&mut self, region: Region, offset: usize) -> u32;
+    fn write32(&mut self, region: Region, offset: usize, value: u32);
+    /// Monotonic microseconds (any epoch; only differences are used).
+    fn now_us(&mut self) -> u64;
+}
+
+fn check_arbiter_v5<B: ArbBus>(bus: &mut B) -> Result<(), &'static str> {
+    if bus.read32(Region::Core, ARB_VERSION) < ARB_V5_MIN {
+        return Err("SPMI arbiter is not v5 (VERSION gate)");
+    }
+    Ok(())
+}
+
+/// One APID is a usable write channel for a PPID when its mapping entry
+/// decodes to that PPID and its write execution environment is ours
+/// (ee 0). On duplicate PPIDs Linux prefers exactly that APID
+/// (spmi-pmic-arb.c, _pmic_arb_read_apid_map).
+pub const fn apid_is_candidate(entry: u32, write_ee: u32, want_ppid: u32) -> bool {
+    map_entry_ppid(entry) == want_ppid && write_ee == 0
+}
+
+fn discover_apid<B: ArbBus>(bus: &mut B, want_ppid: u32) -> Result<u32, &'static str> {
+    let count = bus.read32(Region::Core, ARB_FEATURES) & APID_COUNT_MASK;
+    for apid in 0..count {
+        let entry = bus.read32(Region::Core, ARB_APID_MAP_BASE + 4 * apid as usize);
+        if map_entry_ppid(entry) != want_ppid {
+            continue;
+        }
+        let write_ee = bus.read32(Region::Cnfg, ARB_OWNER_TABLE + 4 * apid as usize) & 0x7;
+        if apid_is_candidate(entry, write_ee, want_ppid) {
+            return Ok(apid);
+        }
+    }
+    Err("no write-owned SPMI APID for the PON peripheral")
+}
+
+fn wait_done<B: ArbBus>(bus: &mut B, region: Region, chan: usize) -> Result<(), &'static str> {
+    let start = bus.now_us();
+    let mut polls = 0u32;
+    loop {
+        match classify_status(bus.read32(region, chan + CHAN_STATUS)) {
+            StatusClass::Done => return Ok(()),
+            StatusClass::Failed => return Err("SPMI arbiter transaction failed"),
+            StatusClass::Denied => return Err("SPMI arbiter transaction denied"),
+            StatusClass::Dropped => return Err("SPMI arbiter transaction dropped"),
+            StatusClass::Pending => {}
+        }
+        polls += 1;
+        if polls >= STATUS_MAX_POLLS || bus.now_us().wrapping_sub(start) >= STATUS_TIMEOUT_US {
+            return Err("SPMI arbiter transaction timed out");
+        }
+    }
+}
+
+fn observer_read_byte<B: ArbBus>(bus: &mut B, apid: u32, reg: u32) -> Result<u8, &'static str> {
+    let chan = OBS_CHAN_STRIDE * apid as usize;
+    bus.write32(Region::Obsrvr, chan + CHAN_CMD, ext_cmd(true, reg, 1));
+    wait_done(bus, Region::Obsrvr, chan)?;
+    Ok((bus.read32(Region::Obsrvr, chan + CHAN_RDATA0) & 0xFF) as u8)
+}
+
+fn rw_write_byte<B: ArbBus>(bus: &mut B, apid: u32, reg: u32, value: u8) -> Result<(), &'static str> {
+    let chan = RW_CHAN_STRIDE * apid as usize;
+    bus.write32(Region::Chnls, chan + CHAN_WDATA0, u32::from(value));
+    bus.write32(Region::Chnls, chan + CHAN_CMD, ext_cmd(false, reg, 1));
+    wait_done(bus, Region::Chnls, chan)
+}
+
+/// Full PON reboot-reason transaction against an abstracted arbiter:
+/// version gate, APID discovery, observer read, read-modify-write,
+/// status polls, and a read-back verify of the reason field. Returns
+/// the byte written. `sid` is the PMIC's SPMI slave ID and `reg` the
+/// absolute SPMI register address (PON base + PON_SPARE_OFFSET).
+pub fn set_reason_with_bus<B: ArbBus>(
+    bus: &mut B,
+    sid: u32,
+    reg: u32,
+    field: u8,
+) -> Result<u8, &'static str> {
+    check_arbiter_v5(bus)?;
+    let apid = discover_apid(bus, ppid(sid, reg))?;
+    let old = observer_read_byte(bus, apid, reg)?;
+    let new = rmw_reason(old, field);
+    rw_write_byte(bus, apid, reg, new)?;
+    let verify = observer_read_byte(bus, apid, reg)?;
+    if verify & REASON_MASK != new & REASON_MASK {
+        return Err("PON reboot-reason read-back mismatch");
+    }
+    Ok(new)
+}
+
+// ---------------------------------------------------------------------------
+// Kernel glue (excluded from the standalone host-test build).
+// ---------------------------------------------------------------------------
+
+#[cfg(not(test))]
+static PON_AVAILABLE: AtomicBool = AtomicBool::new(false);
+/// Virtual (phys_to_virt) bases of the arbiter regions, from the FDT.
+#[cfg(not(test))]
+static ARB_CORE_VIRT: AtomicUsize = AtomicUsize::new(0);
+#[cfg(not(test))]
+static ARB_CHNLS_VIRT: AtomicUsize = AtomicUsize::new(0);
+#[cfg(not(test))]
+static ARB_OBSRVR_VIRT: AtomicUsize = AtomicUsize::new(0);
+#[cfg(not(test))]
+static ARB_CNFG_VIRT: AtomicUsize = AtomicUsize::new(0);
+#[cfg(not(test))]
+static PON_SID: AtomicUsize = AtomicUsize::new(0);
+#[cfg(not(test))]
+static PON_REG: AtomicUsize = AtomicUsize::new(0);
+
+/// Discover the SPMI arbiter regions and the pm8998 PON peripheral from
+/// the FDT (mirroring qcom_scm::init). Bases come from the device tree,
+/// never from hard-coded literals in the transaction path, so a DT
+/// change fails safe (feature reports unavailable) instead of writing
+/// to a wrong address. The region addresses are translated through the
+/// DT `ranges` chain and converted with the kernel's physical map,
+/// which already registers every /soc child's ranges as device memory
+/// (crate::dtb), so they remain mapped at reset time.
+#[cfg(not(test))]
+pub fn init(fdt: &crate::dtb::Fdt<'_>) {
+    use crate::memory::{RmmA, RmmArch};
+    use rmm::PhysicalAddress;
+
+    let found = probe(fdt);
+    if let Some((regions, sid, pon_base)) = found {
+        ARB_CORE_VIRT.store(
+            RmmA::phys_to_virt(PhysicalAddress::new(regions[0])).data(),
+            Ordering::Release,
+        );
+        ARB_CHNLS_VIRT.store(
+            RmmA::phys_to_virt(PhysicalAddress::new(regions[1])).data(),
+            Ordering::Release,
+        );
+        ARB_OBSRVR_VIRT.store(
+            RmmA::phys_to_virt(PhysicalAddress::new(regions[2])).data(),
+            Ordering::Release,
+        );
+        ARB_CNFG_VIRT.store(
+            RmmA::phys_to_virt(PhysicalAddress::new(regions[3])).data(),
+            Ordering::Release,
+        );
+        PON_SID.store(sid as usize, Ordering::Release);
+        PON_REG.store((pon_base + PON_SPARE_OFFSET) as usize, Ordering::Release);
+    }
+    PON_AVAILABLE.store(found.is_some(), Ordering::Release);
+    if found.is_some() {
+        info!("Qualcomm PMIC PON node found; reboot-reason writes remain opt-in");
+    }
+}
+
+/// FDT probe behind init(): returns (translated CPU-physical bases
+/// [core, chnls, obsrvr, cnfg], PMIC slave ID, PON peripheral base).
+#[cfg(not(test))]
+fn probe(fdt: &crate::dtb::Fdt<'_>) -> Option<([usize; 4], u32, u32)> {
+    use fdt::properties::{values::StringList, Status};
+
+    let arb = fdt
+        .all_compatible(&["qcom,spmi-pmic-arb"])
+        .find(|node| matches!(node.property::<Status>(), None | Some(Status::OKAY)))?;
+
+    // Region bases by reg-names, falling back to the sdm845 binding's
+    // documented order (core, chnls, obsrvr, intr, cnfg).
+    let names: alloc::vec::Vec<alloc::string::String> = arb
+        .raw_property("reg-names")
+        .and_then(|prop| prop.as_value::<StringList>().ok())
+        .map(|list| list.iter().map(alloc::string::ToString::to_string).collect())
+        .unwrap_or_default();
+    let mut translated: alloc::vec::Vec<usize> = alloc::vec::Vec::new();
+    for region in arb.reg()?.iter::<usize, usize>() {
+        translated.push(crate::dtb::translate_mmio_address(fdt, &arb, &region.ok()?)?);
+    }
+    let pick = |name: &str, fallback: usize| -> Option<usize> {
+        if let Some(index) = names.iter().position(|n| n == name) {
+            translated.get(index).copied()
+        } else {
+            translated.get(fallback).copied()
+        }
+    };
+    let regions = [
+        pick("core", 0)?,
+        pick("chnls", 1)?,
+        pick("obsrvr", 2)?,
+        pick("cnfg", 4)?,
+    ];
+
+    // The PON peripheral is a grandchild: arbiter -> pmic (slave) ->
+    // pon@800. The pmic's first reg cell is its SPMI slave ID and the
+    // pon node's reg is the peripheral base (qcom-pon.c reads both with
+    // of_property_read_u32).
+    for pmic in arb.children() {
+        let Some(sid) = pmic
+            .raw_property("reg")
+            .and_then(|prop| prop.as_value::<u32>().ok())
+        else {
+            continue;
+        };
+        for child in pmic.children() {
+            let Some(compatible) = child.property::<fdt::properties::Compatible>() else {
+                continue;
+            };
+            if !compatible.compatible_with("qcom,pm8998-pon") {
+                continue;
+            }
+            if !matches!(child.property::<Status>(), None | Some(Status::OKAY)) {
+                continue;
+            }
+            let base = child
+                .raw_property("reg")
+                .and_then(|prop| prop.as_value::<u32>().ok())?;
+            return Some((regions, sid, base));
+        }
+    }
+    None
+}
+
+/// Volatile-MMIO ArbBus over the kernel's physical map.
+#[cfg(not(test))]
+struct MmioBus {
+    core: usize,
+    chnls: usize,
+    obsrvr: usize,
+    cnfg: usize,
+}
+
+#[cfg(not(test))]
+impl MmioBus {
+    fn base(&self, region: Region) -> usize {
+        match region {
+            Region::Core => self.core,
+            Region::Chnls => self.chnls,
+            Region::Obsrvr => self.obsrvr,
+            Region::Cnfg => self.cnfg,
+        }
+    }
+}
+
+#[cfg(not(test))]
+impl ArbBus for MmioBus {
+    fn read32(&mut self, region: Region, offset: usize) -> u32 {
+        unsafe { core::ptr::read_volatile((self.base(region) + offset) as *const u32) }
+    }
+
+    fn write32(&mut self, region: Region, offset: usize, value: u32) {
+        unsafe { core::ptr::write_volatile((self.base(region) + offset) as *mut u32, value) }
+    }
+
+    fn now_us(&mut self) -> u64 {
+        use crate::arch::device::cpu::registers::control_regs;
+        let freq = u64::from(unsafe { control_regs::cntfrq_el0() });
+        if freq == 0 {
+            // Degenerate clock: report 0 forever; wait_done's poll-count
+            // bound still guarantees termination.
+            return 0;
+        }
+        unsafe { control_regs::cntvct_el0() }.saturating_mul(1_000_000) / freq
+    }
+}
+
+/// Write the PON reboot-reason field requested by the bootloader
+/// environment (REASON_BOOTLOADER / REASON_RECOVERY, else REASON_NONE)
+/// and verify it by reading it back. Called from kreset() only, after
+/// the SCM download-mode clear; the caller logs the result and
+/// continues with the PSCI reset either way, so a PON failure never
+/// blocks or alters the reset itself. Writing the field
+/// unconditionally (including REASON_NONE) keeps it deterministic
+/// after every feature-enabled reset, regardless of whether ABL clears
+/// the field after consuming it.
+#[cfg(all(not(test), feature = "qcom-pon-reboot-reason"))]
+pub fn apply_requested_reason() -> Result<u8, &'static str> {
+    if !PON_AVAILABLE.load(Ordering::Acquire) {
+        return Err("no enabled qcom,pm8998-pon device-tree node");
+    }
+    let field = parse_reason_field(crate::startup::init_env());
+    let mut bus = MmioBus {
+        core: ARB_CORE_VIRT.load(Ordering::Acquire),
+        chnls: ARB_CHNLS_VIRT.load(Ordering::Acquire),
+        obsrvr: ARB_OBSRVR_VIRT.load(Ordering::Acquire),
+        cnfg: ARB_CNFG_VIRT.load(Ordering::Acquire),
+    };
+    set_reason_with_bus(
+        &mut bus,
+        PON_SID.load(Ordering::Acquire) as u32,
+        PON_REG.load(Ordering::Acquire) as u32,
+        field,
+    )
+}
