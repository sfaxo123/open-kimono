diff --git a/src/arch/aarch64/device/irqchip/pdc.rs b/src/arch/aarch64/device/irqchip/pdc.rs
new file mode 100644
index 00000000..a7c32d46
--- /dev/null
+++ b/src/arch/aarch64/device/irqchip/pdc.rs
@@ -0,0 +1,186 @@
+// SPDX-License-Identifier: MIT
+//! SDM845 PDC pass-through interrupt domain.
+
+use alloc::vec::Vec;
+use core::ptr::{read_volatile, write_volatile};
+
+use super::{qcom_irq, InterruptController};
+use crate::{
+    dtb::{
+        irqchip::{InterruptHandler, IrqCell, IrqDesc},
+        translate_mmio_address, Fdt,
+    },
+    sync::CleanLockToken,
+};
+use syscall::{Error, Result, EINVAL};
+
+pub struct Pdc {
+    base: usize,
+    ranges: Vec<qcom_irq::PdcRange>,
+    parent_virq_base: usize,
+    probe_only: bool,
+}
+
+impl Pdc {
+    pub fn new() -> Self {
+        Self {
+            base: 0,
+            ranges: Vec::new(),
+            parent_virq_base: 0,
+            probe_only: false,
+        }
+    }
+
+    fn read(&self, offset: usize) -> u32 {
+        unsafe { read_volatile((self.base + offset) as *const u32) }
+    }
+
+    fn write(&self, offset: usize, value: u32) {
+        unsafe { write_volatile((self.base + offset) as *mut u32, value) }
+    }
+
+    fn pin(&self, irq: IrqCell) -> Result<(u32, u32, u32)> {
+        let IrqCell::L2(pin, flags) = irq else {
+            return Err(Error::new(EINVAL));
+        };
+        let spi = qcom_irq::pdc_spi(&self.ranges, pin).ok_or(Error::new(EINVAL))?;
+        let (_, gic_flags) = qcom_irq::pdc_type(flags).ok_or(Error::new(EINVAL))?;
+        Ok((pin, spi, gic_flags))
+    }
+}
+
+impl InterruptHandler for Pdc {
+    fn irq_handler(&mut self, _irq: u32, _token: &mut CleanLockToken) {}
+}
+
+impl InterruptController for Pdc {
+    fn irq_init(
+        &mut self,
+        fdt_opt: Option<&Fdt>,
+        _irq_desc: &mut [IrqDesc; 2048],
+        _ic_idx: usize,
+        _irq_idx: &mut usize,
+    ) -> Result<()> {
+        let fdt = fdt_opt.ok_or(Error::new(EINVAL))?;
+        let node = fdt
+            .all_compatible(&["qcom,sdm845-pdc"])
+            .next()
+            .ok_or(Error::new(EINVAL))?;
+        let reg = node
+            .reg()
+            .and_then(|r| r.iter::<usize, usize>().next())
+            .and_then(|r| r.ok())
+            .ok_or(Error::new(EINVAL))?;
+        if reg.len < 0x10000 {
+            return Err(Error::new(EINVAL));
+        }
+        let phys = translate_mmio_address(fdt, &node, &reg).ok_or(Error::new(EINVAL))?;
+        self.base = crate::PHYS_OFFSET + phys;
+        self.probe_only = node.raw_property("redox,irqchip-probe-only").is_some();
+        let raw = node
+            .raw_property("qcom,pdc-ranges")
+            .ok_or(Error::new(EINVAL))?;
+        self.ranges = qcom_irq::parse_pdc_ranges(raw.value)
+            .ok_or(Error::new(EINVAL))?
+            .collect();
+        if self.ranges.iter().any(|r| {
+            r.count == 0
+                || r.first_pin.checked_add(r.count).is_none_or(|end| end > 256)
+                || r.first_spi.checked_add(r.count).is_none()
+        }) {
+            return Err(Error::new(EINVAL));
+        }
+        let version = if self.probe_only {
+            0
+        } else {
+            self.read(0x1000)
+        };
+        // v3.2 moved the enable bit into IRQ_CFG. Do not write the older
+        // enable banks on an unverified revision.
+        if ((version >> 8) & 0xffff) >= 0x0302 {
+            return Err(Error::new(EINVAL));
+        }
+        info!(
+            "PDC probe: phys={:#x} version={:#x} ranges={}",
+            phys,
+            version,
+            self.ranges.len()
+        );
+        // Firmware state is unknown. Mask every DT-mapped pin before userspace
+        // can request a wake IRQ. SDM845 uses the bank enable layout.
+        for range in &self.ranges {
+            for pin in range.first_pin..range.first_pin + range.count {
+                let (bank, bit) = qcom_irq::pdc_bank_bit(pin).ok_or(Error::new(EINVAL))?;
+                let offset = 0x10 + bank * 4;
+                if !self.probe_only {
+                    self.write(offset, self.read(offset) & !bit);
+                }
+            }
+        }
+        if let Some(range) = self.ranges.first() {
+            info!(
+                "PDC route: pin={} GIC INTID={} virq={}",
+                range.first_pin,
+                range.first_spi + 32,
+                self.parent_virq_base + range.first_spi as usize + 32
+            );
+        }
+        Ok(())
+    }
+
+    fn irq_ack(&mut self) -> u32 {
+        0
+    }
+    fn irq_eoi(&mut self, _irq_num: u32) {}
+    fn irq_enable(&mut self, pin: u32) {
+        if self.probe_only {
+            return;
+        }
+        if qcom_irq::pdc_spi(&self.ranges, pin).is_none() {
+            return;
+        }
+        if let Some((bank, bit)) = qcom_irq::pdc_bank_bit(pin) {
+            let offset = 0x10 + bank * 4;
+            self.write(offset, self.read(offset) | bit);
+        }
+    }
+    fn irq_disable(&mut self, pin: u32) {
+        if self.probe_only {
+            return;
+        }
+        if let Some((bank, bit)) = qcom_irq::pdc_bank_bit(pin) {
+            let offset = 0x10 + bank * 4;
+            self.write(offset, self.read(offset) & !bit);
+        }
+    }
+    fn irq_configure(&mut self, irq_data: IrqCell) -> Result<()> {
+        let (pin, _, _) = self.pin(irq_data)?;
+        if self.probe_only {
+            return Ok(());
+        }
+        let IrqCell::L2(_, flags) = irq_data else {
+            unreachable!()
+        };
+        let (kind, _) = qcom_irq::pdc_type(flags).ok_or(Error::new(EINVAL))?;
+        let offset = 0x110 + pin as usize * 4;
+        self.write(offset, (self.read(offset) & !7) | kind);
+        Ok(())
+    }
+    fn irq_xlate(&self, irq_data: IrqCell) -> Result<usize> {
+        let (_, spi, _) = self.pin(irq_data)?;
+        self.parent_virq_base
+            .checked_add(spi as usize + 32)
+            .ok_or(Error::new(EINVAL))
+    }
+    fn irq_to_virq(&self, pin: u32) -> Option<usize> {
+        let spi = qcom_irq::pdc_spi(&self.ranges, pin)?;
+        self.parent_virq_base.checked_add(spi as usize + 32)
+    }
+    fn irq_parent_spec(&self, irq_data: IrqCell) -> Option<IrqCell> {
+        let (_, spi, flags) = self.pin(irq_data).ok()?;
+        Some(IrqCell::L3(0, spi, flags))
+    }
+    fn irq_set_parent_virq_base(&mut self, base: usize) {
