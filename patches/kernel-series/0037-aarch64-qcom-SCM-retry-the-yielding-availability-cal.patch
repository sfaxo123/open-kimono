From 010856f0b34c0e8f96946ea0c1090669d99ee501 Mon Sep 17 00:00:00 2001
From: claude-code <claude@macbook.local>
Date: Sat, 31 Oct 2026 22:28:23 +0000
Subject: [PATCH 37/37] aarch64: qcom SCM - retry the yielding availability
 call when interrupted

---
 src/arch/aarch64/device/qcom_scm.rs | 24 ++++++++++++++++--------
 1 file changed, 16 insertions(+), 8 deletions(-)

diff --git a/src/arch/aarch64/device/qcom_scm.rs b/src/arch/aarch64/device/qcom_scm.rs
index e1f601bb..7d2486a1 100644
--- a/src/arch/aarch64/device/qcom_scm.rs
+++ b/src/arch/aarch64/device/qcom_scm.rs
@@ -46,14 +46,22 @@ pub fn clear_download_mode() -> Result<(), &'static str> {
 
     // Match Linux qcom_scm_is_call_available(): standard SMC64 SIP call,
     // one value argument containing the owner-qualified BOOT command ID.
-    let available = unsafe {
-        smc64(
-            SMC64_STANDARD_SIP | SCM_INFO_IS_CALL_AVAILABLE,
-            1,
-            SCM_BOOT_SET_DOWNLOAD_MODE_ID,
-            0,
-        )
-    };
+    // Standard (yielding) calls may return QCOM_SCM_INTERRUPTED (1); Linux
+    // __scm_smc_do_quirk re-issues the call until it completes.
+    let mut available = (1, 0);
+    for _ in 0..16 {
+        available = unsafe {
+            smc64(
+                SMC64_STANDARD_SIP | SCM_INFO_IS_CALL_AVAILABLE,
+                1,
+                SCM_BOOT_SET_DOWNLOAD_MODE_ID,
+                0,
+            )
+        };
+        if available.0 != 1 {
+            break;
+        }
+    }
     if available.0 != 0 {
         return Err("SCM call-availability query failed");
     }
