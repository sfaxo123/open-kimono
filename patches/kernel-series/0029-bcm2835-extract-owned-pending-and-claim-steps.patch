+++ b/src/arch/aarch64/device/irqchip/irq_bcm2835.rs
@@ -60,7 +60,97 @@ pub struct Bcm2835ArmInterruptController {
     pub irq_range: (usize, usize),
 }
 
+// Owned values only; this does not resolve the outer controller/global borrow.
+struct PendingDiagnostic {
+    pending_num: u32,
+    sources: u32,
+}
+
+struct PendingStep {
+    hwirq: u32,
+    diagnostic: Option<PendingDiagnostic>,
+}
+
+impl PendingStep {
+    fn irq(hwirq: u32) -> Self {
+        Self {
+            hwirq,
+            diagnostic: None,
+        }
+    }
+
+    fn emit_diagnostic(&self) {
+        if let Some(diagnostic) = &self.diagnostic {
+            error!(
+                "unexpected irq pending in BASIC PENDING: 0x{}, sources = 0x{:08x}",
+                diagnostic.pending_num, diagnostic.sources
+            );
+        }
+    }
+}
+
+struct ClaimStep {
+    pending: PendingStep,
+    virq: Option<usize>,
+}
+
 impl Bcm2835ArmInterruptController {
+    fn pending_step(&mut self) -> PendingStep {
+        //TODO: support smp self.read(LOCAL_IRQ_PENDING + 4 * cpu)
+        let sources = unsafe { self.read(PENDING_0) };
+        let pending_num = ffs(sources) - 1;
+        let fast_irq = [
+            7 + 32,
+            9 + 32,
+            10 + 32,
+            18 + 32,
+            19 + 32,
+            21 + 64,
+            22 + 64,
+            23 + 64,
+            24 + 64,
+            25 + 64,
+            30 + 64,
+        ];
+
+        //fast irq
+        if pending_num >= 10 && pending_num <= 20 {
+            return PendingStep::irq(fast_irq[(pending_num - 10) as usize]);
+        }
+
+        let pending_num = ffs(sources & 0x3ff) - 1;
+        match pending_num {
+            num @ 0..=7 => return PendingStep::irq(num),
+            8 => {
+                let sources1 = unsafe { self.read(PENDING_1) };
+                let irq_0_31 = ffs(sources1) - 1;
+                return PendingStep::irq(irq_0_31 + 32);
+            }
+            9 => {
+                let sources2 = unsafe { self.read(PENDING_2) };
+                let irq_32_63 = ffs(sources2) - 1;
+                return PendingStep::irq(irq_32_63 + 64);
+            }
+            num => {
+                return PendingStep {
+                    hwirq: num,
+                    diagnostic: Some(PendingDiagnostic {
+                        pending_num: num,
+                        sources,
+                    }),
+                };
+            }
+        }
+    }
+
+    fn claim_step(&mut self) -> ClaimStep {
+        let pending = self.pending_step();
+        // A pending diagnostic only accompanies an unmappable hwirq. Mapping
+        // cannot panic ahead of its emission; valid IRQ arithmetic is unchanged.
+        let virq = self.irq_to_virq(pending.hwirq).filter(|virq| *virq < 1024);
+        ClaimStep { pending, virq }
+    }
+
     pub fn new() -> Self {
         Bcm2835ArmInterruptController {
             address: 0,
@@ -170,49 +260,9 @@ impl InterruptController for Bcm2835ArmInterruptController {
     }
 
     fn irq_ack(&mut self) -> u32 {
