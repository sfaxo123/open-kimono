diff --git a/src/dtb/testdata/simplefb-outside-chosen.dts b/src/dtb/testdata/simplefb-outside-chosen.dts
new file mode 100644
index 00000000..b3f3343b
--- /dev/null
+++ b/src/dtb/testdata/simplefb-outside-chosen.dts
@@ -0,0 +1,48 @@
+/dts-v1/;
+
+/*
+ * A simple-framebuffer outside /chosen that references the splash carve-out,
+ * as some vendor device trees place it. A disabled /chosen node is skipped.
+ * Build: dtc -I dts -O dtb -o simplefb-outside-chosen.dtb simplefb-outside-chosen.dts
+ */
+
+/ {
+	#address-cells = <2>;
+	#size-cells = <2>;
+
+	chosen {
+		#address-cells = <2>;
+		#size-cells = <2>;
+		ranges;
+
+		framebuffer@9d400000 {
+			compatible = "simple-framebuffer";
+			memory-region = <&cont_splash_mem>;
+			format = "a8r8g8b8";
+			stride = <(1080 * 4)>;
+			width = <1080>;
+			height = <2280>;
+			status = "disabled";
+		};
+	};
+
+	reserved-memory {
+		#address-cells = <2>;
+		#size-cells = <2>;
+		ranges;
+
+		cont_splash_mem: splash@9d400000 {
+			reg = <0 0x9d400000 0 0x02400000>;
+			no-map;
+		};
+	};
+
+	display-framebuffer {
+		compatible = "vendor,boot-framebuffer", "simple-framebuffer";
+		memory-region = <&cont_splash_mem>;
+		format = "a8r8g8b8";
+		stride = <(1080 * 4)>;
+		width = <1080>;
+		height = <1140>;
+	};
+};
