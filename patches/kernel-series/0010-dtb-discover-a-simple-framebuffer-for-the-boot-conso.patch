+/*
+ * simple-framebuffer edge cases. /chosen holds a disabled node before the
+ * usable QEMU ramfb record; /cases holds nodes that must be rejected.
+ * Build: dtc -I dts -O dtb -o simplefb-cases.dtb simplefb-cases.dts
+ */
+
+/ {
+	#address-cells = <2>;
+	#size-cells = <2>;
+
+	chosen {
+		#address-cells = <2>;
+		#size-cells = <2>;
+		ranges;
+
+		framebuffer@0 {
+			compatible = "simple-framebuffer";
+			reg = <0 0x5e000000 0 0x300000>;
+			format = "a8r8g8b8";
+			stride = <(1024 * 4)>;
+			width = <1024>;
+			height = <768>;
+			status = "disabled";
+		};
+
+		framebuffer@bc430000 {
+			compatible = "simple-framebuffer";
+			reg = <0 0xbc430000 0 0x00200000>;
+			format = "x8r8g8b8";
+			stride = <3200>;
+			width = <800>;
+			height = <600>;
+			status = "okay";
+		};
+	};
+
+	reserved-memory {
+		#address-cells = <2>;
+		#size-cells = <2>;
+		ranges;
+
+		small: splash@9d400000 {
+			reg = <0 0x9d400000 0 0x00100000>;
+			no-map;
+		};
+	};
+
+	cases {
+		#address-cells = <2>;
+		#size-cells = <2>;
+		ranges;
+
+		padded {
+			compatible = "simple-framebuffer";
+			reg = <0 0x9d400000 0 0x02400000>;
+			format = "a8r8g8b8";
+			stride = <(1088 * 4)>;
+			width = <1080>;
+			height = <2280>;
+		};
+
+		region-overrides-reg {
+			compatible = "simple-framebuffer";
+			reg = <0 0x5e000000 0 0x300000>;
+			memory-region = <&small>;
+			format = "a8r8g8b8";
+			stride = <(256 * 4)>;
+			width = <256>;
+			height = <256>;
+		};
+
+		r5g6b5 {
+			compatible = "simple-framebuffer";
+			reg = <0 0x9d400000 0 0x02400000>;
+			format = "r5g6b5";
+			stride = <(1080 * 2)>;
+			width = <1080>;
+			height = <2280>;
+		};
+
+		short-stride {
+			compatible = "simple-framebuffer";
+			reg = <0 0x9d400000 0 0x02400000>;
