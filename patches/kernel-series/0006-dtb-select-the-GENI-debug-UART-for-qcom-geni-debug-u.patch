+/// The mainline binding names a GCC-controlled clock with no fixed rate, so
+/// only an explicit `clock-frequency` lets us reprogram the divider.
+fn qcom_geni_clock(dtb: &Fdt<'_>, node: FdtNode<'_>) -> Option<(u32, u32)> {
+    let se_clock_hz = node
+        .raw_property("clock-frequency")?
+        .as_value::<u32>()
+        .ok()?;
+    let baud = stdout_baud(dtb)
+        .filter(|&value| value != 0)
+        .unwrap_or(115_200);
+    Some((se_clock_hz, baud))
+}
+
+fn qcom_geni_port<M: Mmio>(
+    dtb: &Fdt<'_>,
+    node: FdtNode<'_>,
+    mmio: M,
+    skip_init: bool,
+) -> Option<uart_qcom_geni::SerialPort<M>> {
+    let mut serial_port = uart_qcom_geni::SerialPort::new(mmio);
+    if !skip_init {
+        if let Err(err) = serial_port.init(qcom_geni_clock(dtb, node)) {
+            warn!("GENI UART init failed: {:?}", err);
+            return None;
+        }
+    }
+    Some(serial_port)
+}
