+#[cfg(test)]
+mod tests {
+    use super::{qcom_geni_clock, qcom_geni_port, stdout_baud};
+    use crate::{
+        devices::uart_qcom_geni::{model::GeniModel, reg, PROTOCOL_UART},
+        dtb::{diag_uart_node, diag_uart_range, tests::AlignedDtb},
+    };
+
+    static GENI_DTB: &AlignedDtb<1243> =
+        &AlignedDtb(*include_bytes!("testdata/qcom-geni-uart.dtb"));
+
+    #[test]
+    fn finds_sdm845_uart9_through_stdout_alias() {
+        let fdt = GENI_DTB.fdt();
+        let (phys, size, skip_init, cts, compatible) = diag_uart_range(&fdt).unwrap();
+        assert_eq!(phys.data(), 0xa8_4000);
+        assert_eq!(size, 0x4000);
+        assert!(!skip_init);
+        assert!(!cts);
+        assert!(compatible.compatible_with("qcom,geni-debug-uart"));
+        assert_eq!(stdout_baud(&fdt), Some(115_200));
+    }
+
+    #[test]
+    fn mainline_node_keeps_the_firmware_clock() {
+        let fdt = GENI_DTB.fdt();
+        assert_eq!(qcom_geni_clock(&fdt, diag_uart_node(&fdt).unwrap()), None);
+    }
+
+    #[test]
+    fn clock_frequency_property_selects_a_divider() {
+        let fdt = GENI_DTB.fdt();
+        let node = fdt
+            .find_node("/soc@0/geniqup@ac0000/serial@a88000")
+            .unwrap();
+        assert_eq!(qcom_geni_clock(&fdt, node), Some((7_372_800, 115_200)));
+
+        let port = qcom_geni_port(&fdt, node, GeniModel::new(PROTOCOL_UART), false).unwrap();
+        assert_eq!(port.mmio().reg(reg::M_CLK_CFG), 0x21);
+    }
+
+    #[test]
+    fn console_node_yields_a_working_port() {
+        let fdt = GENI_DTB.fdt();
+        let node = diag_uart_node(&fdt).unwrap();
+        let mut port = qcom_geni_port(&fdt, node, GeniModel::new(PROTOCOL_UART), false).unwrap();
+        port.write(b"Redox\n");
+        assert_eq!(port.mmio().tx(), b"Redox\r\n");
+    }
+
+    #[test]
+    fn non_uart_firmware_is_not_attached() {
+        let fdt = GENI_DTB.fdt();
+        let node = diag_uart_node(&fdt).unwrap();
+        assert!(qcom_geni_port(&fdt, node, GeniModel::new(3), false).is_none());
+    }
+
+    #[test]
+    fn skip_init_attaches_without_register_writes() {
+        let fdt = GENI_DTB.fdt();
+        let node = diag_uart_node(&fdt).unwrap();
+        let port = qcom_geni_port(&fdt, node, GeniModel::new(3), true).unwrap();
+        assert!(port.mmio().writes().is_empty());
+    }
+}
