diff --git a/src/dtb/testdata/qcom-geni-uart.dts b/src/dtb/testdata/qcom-geni-uart.dts
new file mode 100644
index 00000000..13b64e45
--- /dev/null
+++ b/src/dtb/testdata/qcom-geni-uart.dts
@@ -0,0 +1,67 @@
+/dts-v1/;
+
+/*
+ * SDM845 (OnePlus 6) debug console layout: uart9 under the QUP v3 wrapper
+ * with identity ranges, selected through an alias in stdout-path.
+ * Build: dtc -I dts -O dtb -o qcom-geni-uart.dtb qcom-geni-uart.dts
+ */
+
+/ {
+	#address-cells = <2>;
+	#size-cells = <2>;
+	interrupt-parent = <&intc>;
+
+	aliases {
+		serial0 = &uart9;
+	};
+
+	chosen {
+		stdout-path = "serial0:115200n8";
+	};
+
+	soc@0 {
+		compatible = "simple-bus";
+		#address-cells = <2>;
+		#size-cells = <2>;
+		ranges = <0 0 0 0 0x10 0>;
+
+		gcc: clock-controller@100000 {
+			compatible = "qcom,gcc-sdm845";
+			reg = <0 0x00100000 0 0x1f0000>;
+			#clock-cells = <1>;
+		};
+
+		geniqup@ac0000 {
+			compatible = "qcom,geni-se-qup";
+			reg = <0 0x00ac0000 0 0x6000>;
+			#address-cells = <2>;
+			#size-cells = <2>;
+			ranges;
+
+			uart9: serial@a84000 {
+				compatible = "qcom,geni-debug-uart";
+				reg = <0 0x00a84000 0 0x4000>;
+				clock-names = "se";
+				clocks = <&gcc 1>;
+				interrupts = <0 354 4>;
+			};
+
+			serial@a88000 {
+				compatible = "qcom,geni-debug-uart";
+				reg = <0 0x00a88000 0 0x4000>;
+				clock-names = "se";
+				clocks = <&gcc 2>;
+				clock-frequency = <7372800>;
+				interrupts = <0 355 4>;
+			};
+		};
+
+		intc: interrupt-controller@17a00000 {
+			compatible = "arm,gic-v3";
+			reg = <0 0x17a00000 0 0x10000>,
+			      <0 0x17a60000 0 0x100000>;
+			#interrupt-cells = <3>;
+			interrupt-controller;
+		};
+	};
+};
