+    /// The production DT-adapter validation: an explicit stride is checked by
+    /// the same helper `find_redistributor` uses, before any MMIO happens.
+    #[test]
+    fn production_property_decoder_preserves_absence_and_rejects_bad_bytes() {
+        assert_eq!(parse_stride_property(None), Ok(None));
+        assert_eq!(parse_stride_property(Some(&0x40000u64.to_be_bytes())), Ok(Some(0x40000)));
+        for n in [0u64, 1, 0x10000, 0x20008] {
+            assert_eq!(parse_stride_property(Some(&n.to_be_bytes())),
+                       Err(Gicv3Error::InvalidStride(n as usize)));
+        }
+        for bytes in [&[][..], &[0u8; 4][..], &[0u8; 9][..]] {
+            assert_eq!(parse_stride_property(Some(bytes)), Err(Gicv3Error::MalformedStrideProperty));
+        }
+    }
+
+    #[test]
+    fn validate_stride_rejects_zero_undersized_and_unaligned() {
+        // Explicit 0 is malformed, NOT "absent".
+        assert_eq!(validate_stride(Some(0)), Err(Gicv3Error::InvalidStride(0)));
+        // Below one RD_base + SGI_base frame pair.
+        for step in [1, GICR_SGI_BASE, 0x1_ffff] {
+            assert_eq!(validate_stride(Some(step)), Err(Gicv3Error::InvalidStride(step)));
+        }
+        // Big enough but not a multiple of the SGI frame boundary.
+        for step in [GICR_FRAMES_V3 + 8, 0x2_0001, 0x3_c000] {
+            assert_eq!(validate_stride(Some(step)), Err(Gicv3Error::InvalidStride(step)));
+        }
+    }
+
+    #[test]
+    fn validate_stride_accepts_absent_and_frame_aligned_steps() {
+        // Absent property stays supported: the walk derives the step from VLPIS.
+        assert_eq!(validate_stride(None), Ok(()));
+        // GICv3 (RD+SGI) and GICv4 (adds VLPI frames) strides, plus multiples.
+        for step in [GICR_FRAMES_V3, GICR_FRAMES_V4, 0x6_0000] {
+            assert_eq!(validate_stride(Some(step)), Ok(()));
+        }
+    }
+
+    /// An explicit zero must fail the walk too, with no MMIO at all — a stride
+    /// of 0 would make the frame walk step nowhere and re-read RD0 forever.
+    #[test]
+    fn explicit_zero_stride_stops_walk_before_first_mmio() {
+        let m = MockMmio::with_rds(&[(RD0, 1, true)]);
+        assert_eq!(
+            find_redistributor(&m, &[(RD0, 0xf6_0000)], Some(0), 1),
+            Err(Gicv3Error::InvalidStride(0))
+        );
+        assert_eq!(m.reads.get(), 0);
+    }
+
+    /// Absent stride still walks both QEMU-style layouts (VLPIS clear and set).
+    #[test]
+    fn absent_stride_defaults_from_vlpis() {
+        let rd1_v3 = RD0 + GICR_FRAMES_V3;
+        let m = MockMmio::with_rds(&[(RD0, 0, false), (rd1_v3, 1, true)]);
+        assert_eq!(find_redistributor(&m, &[(RD0, 0xf6_0000)], None, 1), Ok(rd1_v3));
+
+        let rd1_v4 = RD0 + GICR_FRAMES_V4;
+        let mut m = MockMmio::with_rds(&[(RD0, 0, false), (rd1_v4, 1, true)]);
+        m.set(RD0 + GICR_TYPER, m.get(RD0 + GICR_TYPER) | GICR_TYPER_VLPIS);
+        assert_eq!(find_redistributor(&m, &[(RD0, 0xf6_0000)], None, 1), Ok(rd1_v4));
+
+        // The same layout walked with the smaller explicit step lands on the
+        // intermediate frame, whose TYPER reads 0 — affinity 0, not 1 — so it
+        // is skipped and RD1 at +0x4_0000 is still found.
+        let mut m = MockMmio::with_rds(&[(RD0, 0, false), (rd1_v4, 1, true)]);
+        m.set(RD0 + GICR_TYPER, m.get(RD0 + GICR_TYPER) | GICR_TYPER_VLPIS);
+        assert_eq!(
+            find_redistributor(&m, &[(RD0, 0x8_0000)], Some(GICR_FRAMES_V3), 1),
+            Ok(rd1_v4)
+        );
+    }
