+/// Validate an EXPLICIT DT `redistributor-stride`. Absent is represented by
+/// `None` and stays supported (the walk then derives the step from
+/// GICR_TYPER.VLPIS); a present value must be at least one RD_base + SGI_base
+/// frame pair and a multiple of GICR_SGI_BASE. An explicit 0 is malformed, not
+/// "absent" — it would make the walk step nowhere. This is the only copy of the
+/// rule: `find_redistributor` calls it too, so DT validation cannot drift from
+/// the walk that consumes the stride.
+pub fn validate_stride(stride: Option<usize>) -> Result<(), Gicv3Error> {
+    match stride {
+        None => Ok(()),
+        Some(step) if step >= GICR_FRAMES_V3 && step % GICR_STRIDE_ALIGN == 0 => Ok(()),
+        Some(step) => Err(Gicv3Error::InvalidStride(step)),
+    }
+}
+
+/// DT binding uses exactly one big-endian u64; absence remains distinct from zero.
+pub fn parse_stride_property(raw: Option<&[u8]>) -> Result<Option<usize>, Gicv3Error> {
+    let stride = match raw {
+        None => None,
+        Some(bytes) => {
+            let bytes: [u8; 8] = bytes.try_into().map_err(|_| Gicv3Error::MalformedStrideProperty)?;
+            Some(usize::try_from(u64::from_be_bytes(bytes))
+                .map_err(|_| Gicv3Error::MalformedStrideProperty)?)
+        }
+    };
+    validate_stride(stride)?;
+    Ok(stride)
+}
