+    #[test]
+    fn affinity_packing_drops_u_mt_and_reserved_bits() {
+        // Aff3=0x12, U (bit30), MT (bit24), RES1 (bit31), Aff2=3 Aff1=2 Aff0=1.
+        let mpidr = (0x12u64 << 32) | (1 << 31) | (1 << 30) | (1 << 24) | 0x03_0201;
+        assert_eq!(mpidr_affinity(mpidr), 0x1203_0201);
+        assert_eq!(mpidr_affinity(0x8000_0000), 0);
+    }
+
+    #[test]
+    fn finds_second_rd_and_nonzero_aff3() {
+        let aff_a = mpidr_affinity(0x8000_0000);
+        let aff_b = mpidr_affinity((0x7u64 << 32) | 0x0001);
+        let rd1 = RD0 + 0x2_0000;
+        let m = MockMmio::with_rds(&[(RD0, aff_a, false), (rd1, aff_b, true)]);
+        let regions = [(RD0, 0xf6_0000)];
+        assert_eq!(find_redistributor(&m, &regions, None, aff_a), Ok(RD0));
+        assert_eq!(find_redistributor(&m, &regions, None, aff_b), Ok(rd1));
+        // Only Aff3 differs: low-byte/CPU0 matching would wrongly accept this.
+        assert_eq!(
+            find_redistributor(&m, &regions, None, 0x0000_0001),
+            Err(Gicv3Error::NoRedistributorForCpu(1))
+        );
+    }
+
+    #[test]
+    fn scan_honors_explicit_stride_and_second_region() {
+        let rd_b = 0x0a00_0000;
+        let m = MockMmio::with_rds(&[(RD0, 0, false), (RD0 + 0x4_0000, 5, true), (rd_b, 9, true)]);
+        let regions = [(RD0, 0x8_0000), (rd_b, 0x2_0000)];
+        assert_eq!(find_redistributor(&m, &regions, Some(0x4_0000), 5), Ok(RD0 + 0x4_0000));
+        assert_eq!(find_redistributor(&m, &regions, Some(0x4_0000), 9), Ok(rd_b));
+        assert_eq!(find_redistributor(&m, &regions, Some(0), 9), Err(Gicv3Error::BadRegion));
+    }
