+    #[test]
+    fn stuck_wake_and_rwp_are_bounded_errors() {
+        let mut m = MockMmio::with_rds(&[(RD0, 0, true)]);
+        m.stuck_asleep = true;
+        assert_eq!(wake(&mut m, RD0, 16), Err(Gicv3Error::WakeTimeout));
+        assert!(m.reads.get() <= 17);
+
+        let mut m = MockMmio::with_rds(&[(RD0, 0, true)]);
+        m.stuck_rwp = true;
+        assert_eq!(private_disable(&mut m, RD0, 30, 16), Err(Gicv3Error::RwpTimeout));
+        assert_eq!(init_private(&mut m, RD0, 0, 16), Err(Gicv3Error::RwpTimeout));
+    }
