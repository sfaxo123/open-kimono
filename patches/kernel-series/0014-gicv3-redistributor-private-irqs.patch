+    #[test]
+    fn ppi30_enable_disable_hits_current_cpu_sgi_frame() {
+        let rd1 = RD0 + 0x2_0000;
+        let mut m = MockMmio::with_rds(&[(RD0, 0, false), (rd1, 1, true)]);
+        let rd = find_redistributor(&m, &[(RD0, 0xf6_0000)], None, 1).unwrap();
+        private_enable(&mut m, rd, 30).unwrap();
+        private_disable(&mut m, rd, 30, 8).unwrap();
+        assert_eq!(
+            m.writes,
+            vec![(rd1 + GICR_ISENABLER0, 1 << 30), (rd1 + GICR_ICENABLER0, 1 << 30)]
+        );
+        assert!(m.writes.iter().all(|&(a, _)| a >= rd1 && a < rd1 + 0x2_0000));
+        assert_eq!(private_enable(&mut m, rd, 37), Err(Gicv3Error::InvalidIntid(37)));
+    }
