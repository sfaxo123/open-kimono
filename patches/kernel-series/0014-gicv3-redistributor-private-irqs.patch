+    #[test]
+    fn tuple0_is_distributor_tuple1_is_redistributor() {
+        let reg = [(GICD, 0x1_0000), (RD0, 0xf6_0000), (0x0900_0000, 0x1000)];
+        let (gicd, rds) = split_regions(&reg, 1).unwrap();
+        assert_eq!(gicd, (GICD, 0x1_0000));
+        assert_eq!(rds, &[(RD0, 0xf6_0000)]);
+        let (_, two) = split_regions(&reg, 2).unwrap();
+        assert_eq!(two[1].0, 0x0900_0000);
+    }
