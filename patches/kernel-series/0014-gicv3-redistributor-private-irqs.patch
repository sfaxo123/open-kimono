@@ -0,0 +1,447 @@
+//! Portable GICv3 redistributor helpers. Everything touching hardware goes
+//! through [`Mmio`] so the same code runs against a host mock in tests.
+
+pub const INTID_PRIVATE_END: u32 = 32;
+pub const INTID_SPECIAL_FIRST: u32 = 1020;
+
+pub const GICD_CTLR_DS: u32 = 1 << 6;
+
+pub const GICR_CTLR: usize = 0x0000;
+pub const GICR_CTLR_RWP: u32 = 1 << 3;
+pub const GICR_TYPER: usize = 0x0008;
+pub const GICR_TYPER_VLPIS: u64 = 1 << 1;
+pub const GICR_TYPER_LAST: u64 = 1 << 4;
+pub const GICR_WAKER: usize = 0x0014;
+pub const GICR_WAKER_PROCESSOR_SLEEP: u32 = 1 << 1;
+pub const GICR_WAKER_CHILDREN_ASLEEP: u32 = 1 << 2;
+
+pub const GICR_SGI_BASE: usize = 0x1_0000;
+pub const GICR_IGROUPR0: usize = GICR_SGI_BASE + 0x0080;
+pub const GICR_ISENABLER0: usize = GICR_SGI_BASE + 0x0100;
+pub const GICR_ICENABLER0: usize = GICR_SGI_BASE + 0x0180;
+pub const GICR_IPRIORITYR: usize = GICR_SGI_BASE + 0x0400;
+pub const GICR_ICFGR1: usize = GICR_SGI_BASE + 0x0C04;
+pub const GICR_IGRPMODR0: usize = GICR_SGI_BASE + 0x0D00;
+
+/// RD_base + SGI_base frames; GICv4 (VLPIS) adds VLPI + reserved frames.
+const GICR_FRAMES_V3: usize = 0x2_0000;
+const GICR_FRAMES_V4: usize = 0x4_0000;
+
+pub const DEFAULT_PRIORITY: u8 = 0xa0;
+
+#[derive(Clone, Copy, Debug, PartialEq, Eq)]
+pub enum Gicv3Error {
+    MissingDistributor,
+    MissingRedistributor,
+    BadRegion,
+    NoRedistributorForCpu(u32),
+    WakeTimeout,
+    RwpTimeout,
+    InvalidIntid(u32),
+    UnsupportedTrigger(u32),
+}
+
+pub trait Mmio {
+    fn read32(&self, addr: usize) -> u32;
+    fn write32(&mut self, addr: usize, value: u32);
+    fn read64(&self, addr: usize) -> u64;
+}
+
+#[derive(Clone, Copy, Debug, PartialEq, Eq)]
+pub enum Route {
+    /// SGI/PPI: banked per CPU, lives in the current CPU's redistributor.
+    Private(u32),
+    /// SPI: shared, lives in the distributor.
+    Shared(u32),
+}
+
+pub fn route(intid: u32, nirqs: u32) -> Result<Route, Gicv3Error> {
+    if intid >= INTID_SPECIAL_FIRST || intid >= nirqs {
+        Err(Gicv3Error::InvalidIntid(intid))
+    } else if intid < INTID_PRIVATE_END {
+        Ok(Route::Private(intid))
+    } else {
+        Ok(Route::Shared(intid))
+    }
+}
+
+/// `reg` = <GICD> then `#redistributor-regions` GICR tuples, in order.
+pub fn split_regions(
+    entries: &[(usize, usize)],
+    rd_regions: usize,
+) -> Result<((usize, usize), &[(usize, usize)]), Gicv3Error> {
+    let (&gicd, rest) = entries
+        .split_first()
+        .ok_or(Gicv3Error::MissingDistributor)?;
+    if rd_regions == 0 || rest.len() < rd_regions {
+        return Err(Gicv3Error::MissingRedistributor);
+    }
+    Ok((gicd, &rest[..rd_regions]))
+}
+
+/// GICR_TYPER[63:32] layout: Aff3:Aff2:Aff1:Aff0. U, MT and RES bits dropped.
+pub fn mpidr_affinity(mpidr: u64) -> u32 {
+    ((((mpidr >> 32) & 0xff) as u32) << 24) | (mpidr & 0x00ff_ffff) as u32
+}
+
+/// Walk each redistributor region (virtual base, length) frame by frame.
+pub fn find_redistributor<M: Mmio>(
+    mmio: &M,
+    regions: &[(usize, usize)],
+    stride: Option<usize>,
+    affinity: u32,
+) -> Result<usize, Gicv3Error> {
+    if stride.is_some_and(|step| step < GICR_FRAMES_V3 || step % GICR_SGI_BASE != 0) {
+        return Err(Gicv3Error::BadRegion);
+    }
+    for &(base, len) in regions {
+        if base % GICR_SGI_BASE != 0 {
+            return Err(Gicv3Error::BadRegion);
+        }
+        base.checked_add(len).ok_or(Gicv3Error::BadRegion)?;
+        let mut offset = 0usize;
+        loop {
+            let frame_end = offset
+                .checked_add(GICR_FRAMES_V3)
+                .ok_or(Gicv3Error::BadRegion)?;
+            if frame_end > len {
+                break;
+            }
+            let rd = base + offset;
+            let typer = mmio.read64(rd + GICR_TYPER);
+            if (typer >> 32) as u32 == affinity {
+                return Ok(rd);
+            }
+            if typer & GICR_TYPER_LAST != 0 {
+                break;
+            }
+            let step = stride.unwrap_or(if typer & GICR_TYPER_VLPIS != 0 {
+                GICR_FRAMES_V4
+            } else {
+                GICR_FRAMES_V3
+            });
+            offset = match offset.checked_add(step) {
+                Some(next) => next,
+                None => break,
+            };
+        }
+    }
+    Err(Gicv3Error::NoRedistributorForCpu(affinity))
+}
+
+pub fn wake<M: Mmio>(mmio: &mut M, rd: usize, max_polls: usize) -> Result<(), Gicv3Error> {
+    let waker = mmio.read32(rd + GICR_WAKER);
+    mmio.write32(rd + GICR_WAKER, waker & !GICR_WAKER_PROCESSOR_SLEEP);
+    for _ in 0..max_polls {
+        if mmio.read32(rd + GICR_WAKER) & GICR_WAKER_CHILDREN_ASLEEP == 0 {
+            return Ok(());
+        }
+        core::hint::spin_loop();
+    }
+    Err(Gicv3Error::WakeTimeout)
+}
+
+pub fn wait_rwp<M: Mmio>(mmio: &M, rd: usize, max_polls: usize) -> Result<(), Gicv3Error> {
+    for _ in 0..max_polls {
+        if mmio.read32(rd + GICR_CTLR) & GICR_CTLR_RWP == 0 {
+            return Ok(());
+        }
+        core::hint::spin_loop();
+    }
+    Err(Gicv3Error::RwpTimeout)
+}
+
+/// Bring the current CPU's SGIs/PPIs to a known disabled, Group 1 NS state.
+/// Group registers are only programmed when the GIC has a single security
+/// state (GICD_CTLR.DS); otherwise secure firmware owns them.
+pub fn init_private<M: Mmio>(
+    mmio: &mut M,
+    rd: usize,
+    gicd_ctlr: u32,
+    max_polls: usize,
+) -> Result<(), Gicv3Error> {
+    wake(mmio, rd, max_polls)?;
+    mmio.write32(rd + GICR_ICENABLER0, 0xffff_ffff);
+    wait_rwp(mmio, rd, max_polls)?;
+    if gicd_ctlr & GICD_CTLR_DS != 0 {
+        mmio.write32(rd + GICR_IGROUPR0, 0xffff_ffff);
+        mmio.write32(rd + GICR_IGRPMODR0, 0);
+    }
+    let prio = u32::from(DEFAULT_PRIORITY) * 0x0101_0101;
+    for word in 0..(INTID_PRIVATE_END as usize / 4) {
+        mmio.write32(rd + GICR_IPRIORITYR + word * 4, prio);
+    }
+    Ok(())
+}
+
+pub fn private_enable<M: Mmio>(mmio: &mut M, rd: usize, intid: u32) -> Result<(), Gicv3Error> {
+    if intid >= INTID_PRIVATE_END {
+        return Err(Gicv3Error::InvalidIntid(intid));
+    }
+    mmio.write32(rd + GICR_ISENABLER0, 1 << intid);
+    Ok(())
+}
+
+pub fn private_disable<M: Mmio>(
+    mmio: &mut M,
+    rd: usize,
+    intid: u32,
+    max_polls: usize,
+) -> Result<(), Gicv3Error> {
+    if intid >= INTID_PRIVATE_END {
+        return Err(Gicv3Error::InvalidIntid(intid));
+    }
+    mmio.write32(rd + GICR_ICENABLER0, 1 << intid);
+    wait_rwp(mmio, rd, max_polls)
+}
+
+/// PPI trigger mode (GICR_ICFGR1). SGI configuration is fixed by hardware.
+pub fn ppi_configure<M: Mmio>(
+    mmio: &mut M,
+    rd: usize,
+    intid: u32,
+    flags: u32,
+) -> Result<(), Gicv3Error> {
+    if !(16..INTID_PRIVATE_END).contains(&intid) {
+        return Err(Gicv3Error::InvalidIntid(intid));
+    }
+    let edge = match flags & 0xf {
+        1 => true,
+        4 => false,
+        other => return Err(Gicv3Error::UnsupportedTrigger(other)),
+    };
+    let shift = (intid - 16) * 2;
+    let mut value = mmio.read32(rd + GICR_ICFGR1);
+    value &= !(0b11 << shift);
+    if edge {
+        value |= 0b10 << shift;
+    }
+    mmio.write32(rd + GICR_ICFGR1, value);
+    Ok(())
+}
+
