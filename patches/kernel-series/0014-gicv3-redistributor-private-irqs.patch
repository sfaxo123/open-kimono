+    #[test]
+    fn route_splits_private_shared_and_invalid() {
+        assert_eq!(route(30, 288), Ok(Route::Private(30)));
+        assert_eq!(route(37, 288), Ok(Route::Shared(37)));
+        assert_eq!(route(668, 1020), Ok(Route::Shared(668)));
+        assert_eq!(route(288, 288), Err(Gicv3Error::InvalidIntid(288)));
+        for special in 1020..=1023 {
+            assert_eq!(route(special, 2048), Err(Gicv3Error::InvalidIntid(special)));
+        }
+    }
