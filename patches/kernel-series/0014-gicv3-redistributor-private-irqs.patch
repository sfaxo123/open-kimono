+    #[test]
+    fn ppi30_configure_sets_icfgr1_field() {
+        let mut m = MockMmio::with_rds(&[(RD0, 0, true)]);
+        m.set(RD0 + GICR_ICFGR1, 0xffff_ffff);
+        ppi_configure(&mut m, RD0, 30, 4).unwrap();
+        assert_eq!(m.get(RD0 + GICR_ICFGR1) as u32, 0xcfff_ffff);
+        ppi_configure(&mut m, RD0, 30, 1).unwrap();
+        assert_eq!(m.get(RD0 + GICR_ICFGR1) as u32, 0xefff_ffff);
+        assert_eq!(ppi_configure(&mut m, RD0, 3, 4), Err(Gicv3Error::InvalidIntid(3)));
+        assert_eq!(ppi_configure(&mut m, RD0, 30, 8), Err(Gicv3Error::UnsupportedTrigger(8)));
+    }
