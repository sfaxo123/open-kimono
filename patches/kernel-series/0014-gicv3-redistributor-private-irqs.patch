+    #[test]
+    fn malformed_stride_and_base_fail_before_mmio() {
+        let m = MockMmio::default();
+        for step in [0, 1, GICR_SGI_BASE, GICR_FRAMES_V3 + 8] {
+            assert_eq!(find_redistributor(&m, &[(RD0, 0xf6_0000)], Some(step), 1),
+                       Err(Gicv3Error::BadRegion));
+        }
+        assert_eq!(find_redistributor(&m, &[(RD0 + 1, 0x2_0000)], None, 1),
+                   Err(Gicv3Error::BadRegion));
+        assert_eq!(m.reads.get(), 0);
+    }
+
+    #[test]
+    fn scan_stays_inside_region_and_rejects_overflow() {
+        // No LAST bit anywhere: walking must stop at the region length.
+        let m = MockMmio::with_rds(&[(RD0, 0, false)]);
+        assert_eq!(
+            find_redistributor(&m, &[(RD0, 0x2_0000)], None, 1),
+            Err(Gicv3Error::NoRedistributorForCpu(1))
+        );
+        assert!(m.reads.get() <= 1);
+        // Region too small for a single RD+SGI frame pair is never read.
+        let m = MockMmio::with_rds(&[(RD0, 1, true)]);
+        assert_eq!(
+            find_redistributor(&m, &[(RD0, 0x1_0000)], None, 1),
+            Err(Gicv3Error::NoRedistributorForCpu(1))
+        );
+        assert_eq!(
+            find_redistributor(&m, &[(usize::MAX - 0x100, 0x2_0000)], None, 1),
+            Err(Gicv3Error::BadRegion)
+        );
+    }
