+            if addr & 0x1_ffff == GICR_WAKER {
+                let mut v = value;
+                if v & GICR_WAKER_PROCESSOR_SLEEP == 0 && !self.stuck_asleep {
+                    v &= !GICR_WAKER_CHILDREN_ASLEEP;
+                }
+                self.set(addr, u64::from(v));
+            } else {
+                self.set(addr, u64::from(value));
+            }
+        }
+        fn read64(&self, addr: usize) -> u64 {
+            self.get(addr)
+        }
+    }
