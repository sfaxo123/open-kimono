+/// `(base, size)` of the areas the bootloader reported free. On UEFI these
+/// include its own loader data, so they are not unused before `init`.
+#[cfg_attr(not(dtb), expect(dead_code))]
+pub(crate) fn bootloader_free_areas(args: &KernelArgs) -> impl Iterator<Item = (usize, usize)> {
+    bootloader_areas(args.areas_base as usize, args.areas_size as usize)
+        .iter()
+        .filter(|area| area.kind == BootloaderMemoryKind::Free)
+        .map(|area| (area.base as usize, area.size as usize))
+}
