+/// The aarch64 bootloader identity-maps the first 8 GiB at PHYS_OFFSET.
+#[cfg(dtb)]
+const BOOT_IDENTITY_MAP_END: usize = 8 << 30;
+
+/// Use a device tree `simple-framebuffer` for the boot console. It takes
+/// precedence over the bootloader's GOP framebuffer, as it does for vesad.
+#[cfg(dtb)]
+pub fn init_dtb(dt: &crate::dtb::Fdt, raw_data: &[u8], args: &crate::startup::KernelArgs) {
+    use crate::{
+        dtb::simplefb,
+        memory::{PhysicalAddress, RmmA, RmmArch},
+        startup::memory::{bootloader_free_areas, register_memory_region, BootloaderMemoryKind},
+    };
+
+    let fb = match simplefb::find(dt) {
+        None => return,
+        Some(Err(err)) => {
+            warn!("ignoring device tree simple-framebuffer: {err}");
+            return;
+        }
+        Some(Ok(fb)) => fb,
+    };
+    let reserved = simplefb::reserved_ranges::<64>(dt, raw_data);
+    if let Err(err) = simplefb::check_placement(
+        &fb,
+        BOOT_IDENTITY_MAP_END,
+        &args.boot_data_ranges(),
+        bootloader_free_areas(args),
+        &reserved,
+    ) {
+        warn!(
+            "ignoring device tree simple-framebuffer at {:X}: {err}",
+            fb.phys
+        );
+        return;
+    }
+
+    let virt = RmmA::phys_to_virt(PhysicalAddress::new(fb.phys)).data();
+    let record = (fb.phys, virt, fb.size());
+    let previous = core::mem::replace(&mut *FRAMEBUFFER.lock(), record);
+    // Keep the frames out of the allocator and the physmap, so memory::init
+    // maps exactly the visible buffer, write-combining, and nothing around it.
+    register_memory_region(fb.phys, fb.size(), BootloaderMemoryKind::Reserved);
+    install_display(fb.width, fb.height, fb.stride, virt);
+
+    if previous.0 != 0 && previous != record {
+        info!(
+            "bootloader framebuffer at {:X} differs; using the device tree's",
+            previous.0
+        );
+    }
+    info!(
+        "device tree simple-framebuffer {}x{} stride {} at {:X}",
+        fb.width, fb.height, fb.stride, fb.phys
+    );
+}
+
+/// Called once the kernel's own write-combining framebuffer mapping is live.
+#[allow(unused)]
+pub fn write_combining_mapped() {
+    if let Some(display) = DEBUG_DISPLAY.lock().as_mut() {
+        display.set_clean_cache(false);
+    }
 }
 
