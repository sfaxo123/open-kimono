+// SPDX-License-Identifier: MIT
+//! GICv3 SPI group assignment.
+//!
+//! Host test: `rustc --edition=2024 --test src/arch/aarch64/device/irqchip/gic_groups.rs -o /tmp/gic-groups && /tmp/gic-groups`
+
+/// `GICD_IGROUPR<n>`: one bit per INTID; 1 selects Group 1.
+pub const GICD_IGROUPR: u32 = 0x080;
+
+/// Distributor writes that place every SPI in Group 1.
+///
+/// With the GICv3 system-register CPU interface, Group 0 is always signalled
+/// as FIQ, and the kernel enables only Group 1 (`ICC_IGRPEN1_EL1`), so a
+/// Group 0 SPI is never taken. When secure firmware owns the GIC these
+/// registers are RAZ/WI to the kernel and firmware's assignment stays.
+/// SGIs and PPIs are grouped in the redistributor instead.
+pub fn spi_group1_writes(nirqs: u32) -> impl Iterator<Item = (u32, u32)> {
+    (32..nirqs)
+        .step_by(32)
+        .map(|irq| (GICD_IGROUPR + irq / 32 * 4, u32::MAX))
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    /// `-M oneplus6` reports 672 interrupt IDs; the touch attention wake
+    /// route ends at PDC pin 100 -> SPI 615 -> INTID 647.
+    #[test]
+    fn every_sdm845_spi_is_group1() {
+        let writes: Vec<_> = spi_group1_writes(672).collect();
+        assert_eq!(writes.len(), 20);
+        assert_eq!(writes.first(), Some(&(0x084, u32::MAX)));
+        assert_eq!(writes.last(), Some(&(0x0d0, u32::MAX)));
+        let intid = 647;
+        let (_, bits) = writes
+            .iter()
+            .find(|(offset, _)| *offset == GICD_IGROUPR + intid / 32 * 4)
+            .unwrap();
+        assert_ne!(bits & (1 << (intid % 32)), 0);
+    }
+
+    #[test]
+    fn private_interrupts_are_left_alone() {
+        assert_eq!(spi_group1_writes(32).count(), 0);
+        assert!(spi_group1_writes(1020).all(|(offset, _)| offset != GICD_IGROUPR));
+    }
+}
