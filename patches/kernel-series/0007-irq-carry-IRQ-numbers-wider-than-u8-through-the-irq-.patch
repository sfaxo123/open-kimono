+#[cfg(test)]
+mod tests {
+    use super::*;
+    use crate::percpu::PercpuBlock;
+
+    /// The scheme's handle lock consults the current CPU block.
+    fn token() -> CleanLockToken {
+        let cpu =
+            alloc::boxed::Box::leak(alloc::boxed::Box::new(PercpuBlock::init(LogicalCpuId::BSP)));
+        PercpuBlock::set_mock_current(cpu);
+        unsafe { CleanLockToken::new() }
+    }
+
+    #[test]
+    fn trigger_counts_a_virq_above_255() {
+        let mut token = token();
+        let before = COUNTS.lock()[386];
+        irq_trigger(386, &mut token);
+        assert_eq!(COUNTS.lock()[386], before + 1);
+    }
+
+    #[test]
+    fn trigger_ignores_a_virq_without_a_queue() {
+        let mut token = token();
+        irq_trigger(TOTAL_IRQ_COUNT, &mut token);
+        irq_trigger(u16::MAX, &mut token);
+    }
+
+    #[test]
+    fn scheme_numbers_cover_sdm845_spis() {
+        // GENI uart9 is SPI 354: virq 354 + 32 on a GIC whose range starts at 0.
+        assert_eq!(scheme_irq_number(386), Some(386));
+        assert_eq!(
+            scheme_irq_number(IRQ_QUEUE_LEN - 1),
+            Some(TOTAL_IRQ_COUNT - 1)
+        );
+        assert_eq!(scheme_irq_number(IRQ_QUEUE_LEN), None);
+        assert_eq!(scheme_irq_number(usize::MAX), None);
+    }
+
+    #[test]
+    fn irq_handle_path_round_trips_a_wide_number() {
+        let handle = Handle::Irq {
+            ack: AtomicUsize::new(0),
+            irq: 386,
+            reservation: None,
+        };
+        let path = handle.path().unwrap();
+        assert_eq!(path, "irq:386");
+        assert_eq!(u16::from_str(&path["irq:".len()..]), Ok(386));
+        assert_eq!(handle.as_irq_handle().map(|(_, irq)| irq), Some(386));
+    }
+
+    #[cfg(dtb)]
+    #[test]
+    fn every_irqchip_virq_has_a_queue() {
+        let descs = unsafe { (*core::ptr::addr_of!(IRQ_CHIP)).irq_desc.len() };
+        assert_eq!(IRQ_QUEUE_LEN, descs);
+    }
+
+    #[cfg(dtb)]
+    #[test]
+    fn unhandled_virq_above_255_reaches_its_queue() {
+        let mut token = token();
+        let before = COUNTS.lock()[387];
+        unsafe { (*core::ptr::addr_of_mut!(IRQ_CHIP)).trigger_virq(387, &mut token) };
+        assert_eq!(COUNTS.lock()[387], before + 1);
+    }
+
+    #[test]
+    fn phandle_path_keeps_phandles_above_255() {
+        let handle = Handle::Phandle(0x1234, Vec::new());
+        assert_eq!(handle.path().unwrap(), "irq:phandle-4660");
+    }
+}
