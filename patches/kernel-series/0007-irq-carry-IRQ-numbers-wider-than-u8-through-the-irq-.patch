diff --git a/src/arch/aarch64/device/generic_timer.rs b/src/arch/aarch64/device/generic_timer.rs
index 374ba068..9c8b0316 100644
--- a/src/arch/aarch64/device/generic_timer.rs
+++ b/src/arch/aarch64/device/generic_timer.rs
@@ -222,8 +222,8 @@ pub(crate) fn handle(hwirq: u32, raw_iar: u32, token: &mut CleanLockToken) -> bo
     if cpu_id == crate::cpu_set::LogicalCpuId::BSP {
         timeout::trigger(token);
 
-        if let Ok(irq) = u8::try_from(config.virq) {
-            irq_trigger(irq.into(), token);
+        if let Ok(irq) = u16::try_from(config.virq) {
+            irq_trigger(irq, token);
         }
     }
     context::switch::tick(token);
