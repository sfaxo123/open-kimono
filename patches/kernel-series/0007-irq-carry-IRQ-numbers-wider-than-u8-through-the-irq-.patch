+/// Number of virqs; the irq scheme keeps one event queue per virq.
+pub const IRQ_DESC_COUNT: usize = 2048;
+
 pub struct IrqChipCore {
     //TODO: support multi level interrupt constrollers
     pub irq_chip_list: IrqChipList,
-    pub irq_desc: [IrqDesc; 2048],
+    pub irq_desc: [IrqDesc; IRQ_DESC_COUNT],
 }
 
 impl IrqChipCore {
@@ -647,10 +650,10 @@ impl IrqChipCore {
             .position(|x| x.phandle == phandle)
     }
 
-    pub fn irq_iter_for(&self, ic_idx: u32) -> impl Iterator<Item = u8> + '_ {
+    pub fn irq_iter_for(&self, ic_idx: u32) -> impl Iterator<Item = u32> + '_ {
         self.irq_desc.iter().filter_map(move |x| {
             if x.basic.ic_idx == ic_idx as usize {
-                Some(x.basic.ic_irq as u8)
+                Some(x.basic.ic_irq)
             } else {
                 None
             }
@@ -678,7 +681,7 @@ const INIT_IRQ_DESC: IrqDesc = IrqDesc {
 };
 pub static mut IRQ_CHIP: IrqChipCore = IrqChipCore {
     irq_chip_list: IrqChipList { chips: Vec::new() },
-    irq_desc: [INIT_IRQ_DESC; 2048],
+    irq_desc: [INIT_IRQ_DESC; IRQ_DESC_COUNT],
 };
 
 pub fn init(fdt: &Fdt) {
@@ -729,3 +732,46 @@ pub fn available_irqs_iter(_cpu_id: LogicalCpuId) -> impl Iterator<Item = u8> +
     error!("available_irqs_iter has been called");
     0..0
 }
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+    use core::sync::atomic::{AtomicU32, Ordering};
+
+    static SEEN: AtomicU32 = AtomicU32::new(0);
+
+    struct Record;
+
+    impl InterruptHandler for Record {
+        fn irq_handler(&mut self, irq: u32, _token: &mut CleanLockToken) {
+            SEEN.store(irq, Ordering::SeqCst);
+        }
+    }
+
+    #[test]
+    fn registered_handler_sees_the_full_virq() {
+        let mut core = alloc::boxed::Box::new(IrqChipCore {
+            irq_chip_list: IrqChipList { chips: Vec::new() },
+            irq_desc: [INIT_IRQ_DESC; IRQ_DESC_COUNT],
+        });
+        core.irq_desc[386].handler = Some(Box::new(Record));
+        let mut token = unsafe { CleanLockToken::new() };
+
+        core.trigger_virq(386, &mut token);
+
+        assert_eq!(SEEN.load(Ordering::SeqCst), 386);
+    }
+
+    #[test]
+    fn irq_iter_for_keeps_hwirqs_above_255() {
+        let mut core = alloc::boxed::Box::new(IrqChipCore {
+            irq_chip_list: IrqChipList { chips: Vec::new() },
+            irq_desc: [INIT_IRQ_DESC; IRQ_DESC_COUNT],
+        });
+        for (i, desc) in core.irq_desc.iter_mut().enumerate() {
+            desc.basic.ic_idx = 1;
+            desc.basic.ic_irq = i as u32;
+        }
+        assert_eq!(core.irq_iter_for(1).nth(386), Some(386));
+    }
+}
