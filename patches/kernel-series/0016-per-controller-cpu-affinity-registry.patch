 //! Portable GICv3 redistributor helpers. Everything touching hardware goes
 //! through [`Mmio`] so the same code runs against a host mock in tests.
 
+extern crate alloc;
+
+use alloc::vec::Vec;
+
 pub const INTID_PRIVATE_END: u32 = 32;
