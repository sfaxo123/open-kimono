+/// Per-controller map from full packed affinity (see [`mpidr_affinity`]) to
+/// that CPU's virtual RD_base. Entries for other CPUs are never touched when
+/// one CPU (re)initializes.
+#[derive(Debug, Default)]
+pub struct RdRegistry {
+    entries: Vec<(u32, usize)>,
+}
+
+impl RdRegistry {
+    pub const fn new() -> Self {
+        RdRegistry { entries: Vec::new() }
+    }
+
+    pub fn lookup(&self, affinity: u32) -> Result<usize, Gicv3Error> {
+        self.entries
+            .iter()
+            .find(|&&(aff, _)| aff == affinity)
+            .map(|&(_, rd)| rd)
+            .ok_or(Gicv3Error::NoRedistributorForCpu(affinity))
+    }
+
+    pub fn insert(&mut self, affinity: u32, rd: usize) {
+        match self.entries.iter_mut().find(|(aff, _)| *aff == affinity) {
+            Some(slot) => slot.1 = rd,
+            None => self.entries.push((affinity, rd)),
+        }
+    }
+
+    pub fn remove(&mut self, affinity: u32) {
+        self.entries.retain(|&(aff, _)| aff != affinity);
+    }
+
+    pub fn clear(&mut self) {
+        self.entries.clear();
+    }
+}
+
+/// Find and initialize `affinity`'s redistributor, recording it only on
+/// success. A failed (re)init leaves `affinity` unmapped; other CPUs' entries
+/// are preserved either way.
+pub fn init_cpu_rd<M: Mmio>(
+    mmio: &mut M,
+    registry: &mut RdRegistry,
+    regions: &[(usize, usize)],
+    stride: Option<usize>,
+    affinity: u32,
+    gicd_ctlr_addr: usize,
+    max_polls: usize,
+) -> Result<usize, Gicv3Error> {
+    registry.remove(affinity);
+    let rd = find_redistributor(mmio, regions, stride, affinity)?;
+    let gicd_ctlr = mmio.read32(gicd_ctlr_addr);
+    init_private(mmio, rd, gicd_ctlr, max_polls)?;
+    registry.insert(affinity, rd);
+    Ok(rd)
+}
+
 pub fn private_enable<M: Mmio>(mmio: &mut M, rd: usize, intid: u32) -> Result<(), Gicv3Error> {
     if intid >= INTID_PRIVATE_END {
         return Err(Gicv3Error::InvalidIntid(intid));
@@ -550,4 +611,85 @@ mod tests {
