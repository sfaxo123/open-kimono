+    fn two_cpu_mock() -> MockMmio {
+        MockMmio::with_rds(&[(RD0, AFF_A, false), (RD1, AFF_B, true)])
+    }
+
+    #[test]
+    fn registry_keeps_cpu_a_after_cpu_b_initializes() {
+        let mut m = two_cpu_mock();
+        let mut reg = RdRegistry::new();
+        let regions = [(RD0, 0xf6_0000)];
+        assert_eq!(init_cpu_rd(&mut m, &mut reg, &regions, None, AFF_A, GICD, 8), Ok(RD0));
+        assert_eq!(init_cpu_rd(&mut m, &mut reg, &regions, None, AFF_B, GICD, 8), Ok(RD1));
+        assert_eq!(reg.lookup(AFF_A), Ok(RD0));
+        assert_eq!(reg.lookup(AFF_B), Ok(RD1));
+    }
+
+    #[test]
+    fn registry_reinit_of_b_preserves_a_even_on_failure() {
+        let mut m = two_cpu_mock();
+        let mut reg = RdRegistry::new();
+        let regions = [(RD0, 0xf6_0000)];
+        init_cpu_rd(&mut m, &mut reg, &regions, None, AFF_A, GICD, 8).unwrap();
+        init_cpu_rd(&mut m, &mut reg, &regions, None, AFF_B, GICD, 8).unwrap();
+        assert_eq!(init_cpu_rd(&mut m, &mut reg, &regions, None, AFF_B, GICD, 8), Ok(RD1));
+        assert_eq!(reg.lookup(AFF_A), Ok(RD0));
+        assert_eq!(reg.lookup(AFF_B), Ok(RD1));
+        // A failed re-init unmaps only B.
+        let only_a = [(RD0, GICR_FRAMES_V3)];
+        assert_eq!(
+            init_cpu_rd(&mut m, &mut reg, &only_a, None, AFF_B, GICD, 8),
+            Err(Gicv3Error::NoRedistributorForCpu(AFF_B))
+        );
+        assert_eq!(reg.lookup(AFF_A), Ok(RD0));
+        assert_eq!(reg.lookup(AFF_B), Err(Gicv3Error::NoRedistributorForCpu(AFF_B)));
+    }
+
+    #[test]
+    fn registry_missing_affinity_fails_without_mmio() {
+        let mut m = two_cpu_mock();
+        let mut reg = RdRegistry::new();
+        init_cpu_rd(&mut m, &mut reg, &[(RD0, 0xf6_0000)], None, AFF_A, GICD, 8).unwrap();
+        let (reads, writes) = (m.reads.get(), m.writes.len());
+        assert_eq!(reg.lookup(AFF_B), Err(Gicv3Error::NoRedistributorForCpu(AFF_B)));
+        assert_eq!(RdRegistry::new().lookup(AFF_A), Err(Gicv3Error::NoRedistributorForCpu(AFF_A)));
+        assert_eq!((m.reads.get(), m.writes.len()), (reads, writes));
+    }
+
+    #[test]
+    fn registry_distinguishes_affinities_differing_only_in_aff3() {
+        let lo = mpidr_affinity(0x0000_0001);
+        let hi = mpidr_affinity((0x7u64 << 32) | 0x0001);
+        assert_eq!(hi ^ lo, 0x0700_0000);
+        let mut m = MockMmio::with_rds(&[(RD0, lo, false), (RD1, hi, true)]);
+        let mut reg = RdRegistry::new();
+        let regions = [(RD0, 0xf6_0000)];
+        assert_eq!(init_cpu_rd(&mut m, &mut reg, &regions, None, hi, GICD, 8), Ok(RD1));
+        assert_eq!(reg.lookup(lo), Err(Gicv3Error::NoRedistributorForCpu(lo)));
+        assert_eq!(init_cpu_rd(&mut m, &mut reg, &regions, None, lo, GICD, 8), Ok(RD0));
+        assert_eq!(reg.lookup(hi), Ok(RD1));
+        assert_eq!(reg.lookup(lo), Ok(RD0));
+    }
+
+    #[test]
+    fn independent_controller_registries_do_not_clobber() {
+        let rd_c1 = 0x0a00_0000;
+        let mut m = MockMmio::with_rds(&[(RD0, AFF_A, true), (rd_c1, AFF_A, true)]);
+        let mut c0 = RdRegistry::new();
+        let mut c1 = RdRegistry::new();
+        init_cpu_rd(&mut m, &mut c0, &[(RD0, GICR_FRAMES_V3)], None, AFF_A, GICD, 8).unwrap();
+        init_cpu_rd(&mut m, &mut c1, &[(rd_c1, GICR_FRAMES_V4)], Some(GICR_FRAMES_V4), AFF_A, GICD, 8)
+            .unwrap();
+        assert_eq!(c0.lookup(AFF_A), Ok(RD0));
+        assert_eq!(c1.lookup(AFF_A), Ok(rd_c1));
+        c1.clear();
+        assert_eq!(c0.lookup(AFF_A), Ok(RD0));
+        assert_eq!(c1.lookup(AFF_A), Err(Gicv3Error::NoRedistributorForCpu(AFF_A)));
+    }
 }
