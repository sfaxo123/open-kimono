+//! Narrow Qualcomm SCM support for clearing the download-mode cookie.
+//!
+//! This is opt-in because the OnePlus 6 firmware call has not been verified on
+//! hardware. The normal reset path never invokes these SMC calls.
+
+use core::arch::asm;
+use core::sync::atomic::{AtomicBool, Ordering};
+
+use fdt::properties::Status;
+
+use crate::dtb::Fdt;
+
+const SCM_AVAILABLE: AtomicBool = AtomicBool::new(false);
+
+#[cfg(feature = "qcom-dload-mode-clear")]
+const SMC64_STANDARD_SIP: u64 = 0x4200_0000;
+#[cfg(feature = "qcom-dload-mode-clear")]
+const SMC64_FAST_SIP: u64 = 0xc200_0000;
+#[cfg(feature = "qcom-dload-mode-clear")]
+const SCM_INFO_IS_CALL_AVAILABLE: u64 = 0x0601;
+#[cfg(feature = "qcom-dload-mode-clear")]
+const SCM_BOOT_SET_DOWNLOAD_MODE: u64 = 0x0110;
+#[cfg(feature = "qcom-dload-mode-clear")]
+const SCM_BOOT_SET_DOWNLOAD_MODE_ID: u64 = 0x0200_0110;
+
+pub fn init(fdt: &Fdt<'_>) {
+    let present = fdt
+        .all_compatible(&["qcom,scm-sdm845", "qcom,scm"])
+        .any(|node| matches!(node.property::<Status>(), None | Some(Status::OKAY)));
+    SCM_AVAILABLE.store(present, Ordering::Release);
+    if present {
+        info!("Qualcomm SCM node found; download-mode clear remains opt-in");
+    }
+}
+
+/// Clears Qualcomm's download-mode cookie when the opt-in feature is enabled.
+/// The caller logs and handles errors before continuing with PSCI reset.
+#[cfg(feature = "qcom-dload-mode-clear")]
+pub fn clear_download_mode() -> Result<(), &'static str> {
+    if !SCM_AVAILABLE.load(Ordering::Acquire) {
+        return Err("no enabled qcom,scm device-tree node");
+    }
+
+    // Match Linux qcom_scm_is_call_available(): standard SMC64 SIP call,
+    // one value argument containing the owner-qualified BOOT command ID.
+    let available = unsafe {
+        smc64(
+            SMC64_STANDARD_SIP | SCM_INFO_IS_CALL_AVAILABLE,
+            1,
+            SCM_BOOT_SET_DOWNLOAD_MODE_ID,
+            0,
+        )
+    };
+    if available.0 != 0 {
+        return Err("SCM call-availability query failed");
+    }
+    if available.1 == 0 {
+        return Err("SCM BOOT_SET_DLOAD_MODE is unavailable");
+    }
+
+    // Match Linux __qcom_scm_set_dload_mode(false): fast SMC64 SIP call,
+    // QCOM_SCM_ARGS(2) with args { command, 0 }.
+    let result = unsafe {
+        smc64(
+            SMC64_FAST_SIP | SCM_BOOT_SET_DOWNLOAD_MODE,
+            2,
+            SCM_BOOT_SET_DOWNLOAD_MODE,
+            0,
+        )
+    };
+    if result.0 == 0 {
+        Ok(())
+    } else {
+        Err("SCM BOOT_SET_DLOAD_MODE(false) failed")
+    }
+}
+
+#[cfg(feature = "qcom-dload-mode-clear")]
+unsafe fn smc64(function_id: u64, arg_info: u64, arg0: u64, arg1: u64) -> (u64, u64) {
+    let mut result = function_id;
+    let mut returned_arg0 = arg0;
+    unsafe {
+        asm!(
+            "smc #0",
+            inout("x0") result,
+            inout("x1") arg_info => _,
+            inout("x2") returned_arg0,
+            inout("x3") arg1 => _,
+            options(nostack),
+        );
+    }
+    (result, returned_arg0)
+}
