+//! Host tests for `IrqSaveMutex` using a thread-local fake CPU status register.
+//! The fake models only the local mask bit; it proves nothing about hardware.
+
+extern crate std;
+
+use super::{IrqSaveMutex, MaskPolicy, Saved};
+use std::{cell::Cell, panic, vec::Vec};
+
+const IE: u64 = 1 << 1;
+const OTHER_BITS: u64 = 0xA5A5_0000_0000_F0F0 & !IE;
+
+std::thread_local! {
+    static STATUS: Cell<u64> = const { Cell::new(0) };
+    static PROBE: Cell<Option<*const spin::Mutex<u32>>> = const { Cell::new(None) };
+    static PROBE_LOCKED_AT_RESTORE: Cell<Option<bool>> = const { Cell::new(None) };
+    static LOG: core::cell::RefCell<Vec<&'static str>> = const { core::cell::RefCell::new(Vec::new()) };
+}
+
+struct FakeMask;
+
+unsafe impl MaskPolicy for FakeMask {
+    fn save_and_disable() -> Saved {
+        let old = STATUS.get();
+        STATUS.set(old & !IE);
+        LOG.with_borrow_mut(|l| l.push("save"));
+        Saved {
+            prior_enabled: old & IE != 0,
+        }
+    }
+
+    unsafe fn restore(saved: Saved) {
+        if let Some(m) = PROBE.get() {
+            // SAFETY: the probe pointer is set by a test to a mutex that outlives the call.
+            let locked = unsafe { &*m }.try_lock().is_none();
+            PROBE_LOCKED_AT_RESTORE.set(Some(locked));
+        }
+        let cur = STATUS.get();
+        STATUS.set(if saved.prior_enabled { cur | IE } else { cur & !IE });
+        LOG.with_borrow_mut(|l| l.push("restore"));
+    }
+}
+
+type M = IrqSaveMutex<u32, FakeMask>;
+
+macro_rules! with_fake {
+    ($lock:expr, $body:expr) => {{
+        // SAFETY: the fake CPU is thread-local, these synchronous closures do
+        // not transfer execution or re-enable the simulated IRQ bit.
+        unsafe { ($lock).with($body) }
+    }};
+}
+
+fn reset(status: u64) {
+    STATUS.set(status);
+    PROBE.set(None);
+    PROBE_LOCKED_AT_RESTORE.set(None);
+    LOG.with_borrow_mut(|l| l.clear());
+}
+
+#[test]
+fn initially_enabled_masks_inside_and_reenables_after() {
+    reset(OTHER_BITS | IE);
+    let m = M::new(1);
+    let seen = with_fake!(&m, |v| {
+        *v += 1;
+        STATUS.get()
+    });
+    assert_eq!(seen & IE, 0, "IRQ must be masked inside the closure");
+    assert_eq!(STATUS.get(), OTHER_BITS | IE);
+    assert_eq!(with_fake!(&m, |v| *v), 2);
+}
+
+#[test]
+fn initially_masked_stays_masked_after() {
+    reset(OTHER_BITS);
+    let m = M::new(0);
+    with_fake!(&m, |v| *v = 7);
+    assert_eq!(STATUS.get(), OTHER_BITS, "restore must not enable a masked CPU");
+}
+
+#[test]
+fn nested_different_mutexes_restore_saved_masked_bit() {
+    reset(OTHER_BITS | IE);
+    let a = M::new(0);
+    let b = M::new(0);
+    with_fake!(&a, |_| {
+        with_fake!(&b, |_| assert_eq!(STATUS.get() & IE, 0));
+        assert_eq!(STATUS.get(), OTHER_BITS, "inner restore must keep IRQ masked");
+    });
+    assert_eq!(STATUS.get(), OTHER_BITS | IE);
+}
+
+#[test]
+fn restore_happens_after_inner_unlock() {
+    reset(IE);
+    let m = M::new(0);
+    PROBE.set(Some(m.inner_for_test() as *const _));
+    with_fake!(&m, |v| *v = 3);
+    assert_eq!(
+        PROBE_LOCKED_AT_RESTORE.get(),
+        Some(false),
+        "inner mutex must already be released when restore runs"
+    );
+    assert_eq!(LOG.with_borrow(|l| l.clone()), ["save", "restore"]);
+}
+
+#[test]
+fn unwind_releases_lock_then_restores() {
+    reset(OTHER_BITS | IE);
+    let m = M::new(0);
+    PROBE.set(Some(m.inner_for_test() as *const _));
+    let r = panic::catch_unwind(panic::AssertUnwindSafe(|| {
+        with_fake!(&m, |_| panic!("closure panic"));
+    }));
+    assert!(r.is_err());
+    assert_eq!(PROBE_LOCKED_AT_RESTORE.get(), Some(false));
+    assert!(!m.inner_for_test().is_locked());
+    assert_eq!(STATUS.get(), OTHER_BITS | IE);
+}
+
+#[test]
+fn unrelated_status_bits_preserved_through_changes_inside_scope() {
+    reset(OTHER_BITS | IE);
+    let m = M::new(0);
+    with_fake!(&m, |_| STATUS.set(STATUS.get() | (1 << 40)));
+    assert_eq!(STATUS.get(), OTHER_BITS | IE | (1 << 40));
+}
