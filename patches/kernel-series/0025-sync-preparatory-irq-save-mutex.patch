+//! IRQ-save spin mutex: masks the local CPU IRQ line before acquiring an inner
+//! `spin::Mutex` and restores the saved IRQ-enable bit only after releasing it.
+//!
+//! This primitive does not by itself establish a lock graph, forbid CPU
+//! migration, or prove anything about other CPUs. Inside `with` the closure must
+//! not re-acquire the same lock, schedule, or re-enable interrupts.
+
+#![allow(dead_code)]
+
+use core::{
+    marker::PhantomData,
+    sync::atomic::{compiler_fence, Ordering},
+};
+
+/// Saved local-CPU IRQ state returned by [`MaskPolicy::save_and_disable`].
+#[derive(Clone, Copy, Debug, PartialEq, Eq)]
+pub(crate) struct Saved {
+    pub(crate) prior_enabled: bool,
+}
+
+/// Local-CPU IRQ mask operations.
+///
+/// # Safety
+///
+/// `save_and_disable` must record whether the local IRQ line was enabled, then
+/// mask it before returning. `restore` must set only
+/// that IRQ-enable bit back to `saved.prior_enabled` on the current CPU and
+/// leave every other status bit at its current value. Both must act as compiler
+/// barriers. Callers guarantee the thread does not migrate CPUs between a save
+/// and its matching restore.
+pub(crate) unsafe trait MaskPolicy {
+    fn save_and_disable() -> Saved;
+    /// # Safety
+    /// `saved` must come from the matching `save_and_disable` on this CPU.
+    unsafe fn restore(saved: Saved);
+}
+
+/// RAII token: masks on construction, restores the saved bit on drop.
+/// Never leaves this module and is neither `Send` nor `Sync`.
+struct IrqToken<P: MaskPolicy> {
+    saved: Saved,
+    _policy: PhantomData<fn() -> P>,
+    _not_send: PhantomData<*mut ()>,
+}
+
+impl<P: MaskPolicy> IrqToken<P> {
+    fn new() -> Self {
+        compiler_fence(Ordering::SeqCst);
+        let saved = P::save_and_disable();
+        compiler_fence(Ordering::SeqCst);
+        Self {
+            saved,
+            _policy: PhantomData,
+            _not_send: PhantomData,
+        }
+    }
+}
+
+impl<P: MaskPolicy> Drop for IrqToken<P> {
+    fn drop(&mut self) {
+        compiler_fence(Ordering::SeqCst);
+        // SAFETY: `saved` came from `P::save_and_disable` on this CPU in `new`,
+        // and the unsafe `with` caller guarantees no CPU migration through restore.
+        // !Send alone only prevents thread transfer; it does not pin a CPU.
+        unsafe { P::restore(self.saved) };
+        compiler_fence(Ordering::SeqCst);
+    }
+}
+
+/// Spin mutex that holds the local IRQ line masked while locked.
+///
+/// `Send`/`Sync` come only from the inner `spin::Mutex<T>`; the policy marker
+/// is `fn() -> P`, which is always `Send + Sync` and adds no bound.
+pub(crate) struct IrqSaveMutex<T, P: MaskPolicy> {
+    inner: spin::Mutex<T>,
+    _policy: PhantomData<fn() -> P>,
+}
+
+impl<T, P: MaskPolicy> IrqSaveMutex<T, P> {
+    pub(crate) const fn new(value: T) -> Self {
+        Self {
+            inner: spin::Mutex::new(value),
+            _policy: PhantomData,
+        }
+    }
+
+    /// Masks local IRQs, locks, runs `f`, unlocks, then restores the saved
+    /// IRQ bit. On unwind the inner guard is still dropped before the token.
+    ///
+    /// # Safety
+    /// The caller must ensure that acquisition, `f`, and cleanup (including
+    /// unwinding) cannot schedule, block, migrate CPUs, or re-enable local IRQs.
+    /// This guard does not pin a CPU. `f` must not recursively acquire this mutex.
+    pub(crate) unsafe fn with<R>(&self, f: impl for<'a> FnOnce(&'a mut T) -> R) -> R {
+        let token = IrqToken::<P>::new();
+        let result = {
+            let mut guard = self.inner.lock();
+            f(&mut *guard)
+        };
+        drop(token);
+        result
+    }
+
+    #[cfg(test)]
+    pub(crate) fn inner_for_test(&self) -> &spin::Mutex<T> {
+        &self.inner
+    }
+}
+
+/// Production policy for the architecture being compiled.
+#[cfg(any(target_arch = "aarch64", target_arch = "riscv64"))]
+pub(crate) struct ArchMask;
+
+#[cfg(target_arch = "aarch64")]
+unsafe impl MaskPolicy for ArchMask {
+    #[inline(always)]
+    fn save_and_disable() -> Saved {
+        let old: u64;
+        // SAFETY: reads DAIF and sets only the I bit; memory clobber kept.
+        unsafe {
+            core::arch::asm!(
+                "mrs {old}, DAIF",
+                "msr DAIFSet, #2",
+                old = out(reg) old,
+                options(nostack, preserves_flags),
+            );
+        }
+        Saved {
+            prior_enabled: (old & (1 << 7)) == 0,
+        }
+    }
+
+    #[inline(always)]
+    unsafe fn restore(saved: Saved) {
+        // SAFETY: touches only the I bit of DAIF; memory clobber kept.
+        unsafe {
+            if saved.prior_enabled {
+                core::arch::asm!("msr DAIFClr, #2", options(nostack, preserves_flags));
+            } else {
+                core::arch::asm!("msr DAIFSet, #2", options(nostack, preserves_flags));
+            }
+        }
+    }
+}
+
+#[cfg(target_arch = "riscv64")]
+unsafe impl MaskPolicy for ArchMask {
+    #[inline(always)]
+    fn save_and_disable() -> Saved {
+        let old: usize;
+        // SAFETY: atomically reads sstatus and clears only SIE; memory clobber kept.
+        unsafe {
+            core::arch::asm!(
+                "csrrci {old}, sstatus, 2",
+                old = out(reg) old,
+                options(nostack, preserves_flags),
+            );
+        }
+        Saved {
+            prior_enabled: (old & 2) != 0,
+        }
+    }
+
+    #[inline(always)]
+    unsafe fn restore(saved: Saved) {
+        // SAFETY: touches only sstatus.SIE; memory clobber kept.
+        unsafe {
+            if saved.prior_enabled {
+                core::arch::asm!("csrsi sstatus, 2", options(nostack, preserves_flags));
+            } else {
+                core::arch::asm!("csrci sstatus, 2", options(nostack, preserves_flags));
+            }
+        }
+    }
+}
+
