@@ -0,0 +1,81 @@
+//! Bounded, opt-in (`wy_sleep_diag`) diagnostics for the measured
+//! wyoming-probe guest hang. Off by default; when enabled this module only
+//! increments relaxed atomics and prints a bounded trace around the probe's
+//! nanosleep calls. It never changes scheduling, IRQ, or timer behavior,
+//! updates counters without locks or allocations. Serial snapshots must be
+//! called outside context locks.
+
+use core::sync::atomic::{AtomicU32, AtomicU64, Ordering};
+
+/// Total root IRQ dispatches acknowledged (after acknowledge_root).
+static IRQ_TOTAL: AtomicU64 = AtomicU64::new(0);
+/// Last raw hwirq number seen by root dispatch.
+static IRQ_LAST_HWIRQ: AtomicU32 = AtomicU32::new(0);
+/// Timer IRQs that matched the generic_timer config filter.
+static TIMER_IRQ_MATCHED: AtomicU64 = AtomicU64::new(0);
+/// Last timer control-register bits read before the handler masks ISTATUS.
+static TIMER_LAST_CTRL: AtomicU32 = AtomicU32::new(0);
+/// Number of scheduler scans (schedule() entries, before the Alarm block).
+static SCHED_SCANS: AtomicU64 = AtomicU64::new(0);
+/// Last schedule_time seen by schedule (ns, saturated to u64).
+static SCHED_LAST_TIME: AtomicU64 = AtomicU64::new(0);
+
+/// Bound on traced nanosleep requests for wyoming-probe contexts.
+const TRACE_LIMIT: u64 = 8;
+/// Number of trace requests already issued (pre-switch).
+static TRACE_COUNT: AtomicU64 = AtomicU64::new(0);
+
+#[inline]
+pub fn note_irq(hwirq: u32) {
+    IRQ_TOTAL.fetch_add(1, Ordering::Relaxed);
+    IRQ_LAST_HWIRQ.store(hwirq, Ordering::Relaxed);
+}
+
+#[inline]
+pub fn note_timer_irq(ctrl_bits: u32) {
+    TIMER_IRQ_MATCHED.fetch_add(1, Ordering::Relaxed);
+    TIMER_LAST_CTRL.store(ctrl_bits, Ordering::Relaxed);
+}
+
+#[inline]
+pub fn note_schedule(schedule_time: u128) {
+    SCHED_SCANS.fetch_add(1, Ordering::Relaxed);
+    SCHED_LAST_TIME.store(schedule_time.min(u64::MAX as u128) as u64, Ordering::Relaxed);
+}
+
+/// A sequence ID for the first `TRACE_LIMIT` matching requests. Callers must
+/// ensure this is only consulted for contexts whose name matches the probe.
+#[inline]
+pub fn trace_request() -> Option<u64> {
+    let prev = TRACE_COUNT.fetch_add(1, Ordering::Relaxed);
+    if prev < TRACE_LIMIT {
+        Some(prev)
+    } else {
+        // Do not consume budget past the bound.
+        TRACE_COUNT.fetch_sub(1, Ordering::Relaxed);
+        None
+    }
+}
+
+/// Snapshot of all counters, for bounded serial prints.
+#[inline]
+pub fn counters() -> (u64, u32, u64, u32, u64, u64) {
+    (
+        IRQ_TOTAL.load(Ordering::Relaxed),
+        IRQ_LAST_HWIRQ.load(Ordering::Relaxed),
+        TIMER_IRQ_MATCHED.load(Ordering::Relaxed),
+        TIMER_LAST_CTRL.load(Ordering::Relaxed),
+        SCHED_SCANS.load(Ordering::Relaxed),
+        SCHED_LAST_TIME.load(Ordering::Relaxed),
+    )
+}
+
+/// One-line snapshot with the stable WY_SLEEP prefix. Callers must not hold
+/// context locks when calling this.
+#[inline]
+pub fn print_counters(tag: &str) {
+    let (irq, hw, tirq, ctrl, scans, stime) = counters();
+    println!(
+        "WY_SLEEP {tag} irq={irq} last_hwirq={hw} tirq={tirq} tctrl={ctrl:#010x} scans={scans} sched_time={stime}"
+    );
+}
