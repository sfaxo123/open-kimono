@@ -36,6 +36,29 @@ pub fn nanosleep(
     let start = time::monotonic(token);
     let end = start + req.to_nanos();
 
+    #[cfg(feature = "wy_sleep_diag")]
+    let wy_trace = {
+        // Copy identity, then release both guards before any serial output.
+        let (matched, pid, debug_id) = {
+            let context_lock = context::current();
+            let guard = context_lock.read(token.token());
+            (guard.name.contains("wyoming-probe"), guard.pid, guard.debug_id)
+        };
+        let ticket = if matched {
+            crate::sleep_diag::trace_request().map(|id| (id, pid, debug_id))
+        } else {
+            None
+        };
+        if let Some((id, pid, debug_id)) = ticket {
+            println!(
+                "WY_SLEEP req id={} pid={} debug_id={} tv_sec={} tv_nsec={} start={} end={}",
+                id, pid, debug_id, req.tv_sec, req.tv_nsec, start, end
+            );
+            crate::sleep_diag::print_counters("req");
+        }
+        ticket
+    };
+
     {
         let context_lock = context::current();
         let context = context_lock.upgradeable_read(token.token());
