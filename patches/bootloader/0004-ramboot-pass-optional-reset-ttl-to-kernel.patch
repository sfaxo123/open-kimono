--- a/src/main.rs
+++ b/src/main.rs
@@ -630,6 +630,12 @@ fn main(os: &impl Os) -> (usize, u64, KernelArgs) {
 
         #[cfg(feature = "ramboot")]
         writeln!(w, "REDOX_RAMBOOT=1").unwrap();
+        #[cfg(feature = "ramboot")]
+        if let Some(ttl) = option_env!("REDOX_RAMBOOT_TTL") {
+            if !ttl.is_empty() && ttl.bytes().all(|byte| byte.is_ascii_digit()) {
+                writeln!(w, "REDOX_RAMBOOT_TTL={ttl}").unwrap();
+            }
+        }
