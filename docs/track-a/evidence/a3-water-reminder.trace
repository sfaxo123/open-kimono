rency\": \"serial\", \"timeout\": {\"idle_ms\": 500, \"total_ms\": 2000}, \"dialog\": {\"speech\": \"Time to drink some water.\", \"text\": \"Water reminder\", \"priority\": \"alert\"}, \"idempotency_key_template\": \"svc.demo.water_reminder:{{execution_id}}:remind\"}, \"act_mark_stopped\": {\"type\": \"state_mutate\", \"description\": \"Note in state that the reminder was stopped.\", \"effect_class\": \"reversible_staged\", \"read_only\": false, \"deduplicate_calls\": false, \"concurrency\": \"serial\", \"timeout\": {\"idle_ms\": 50, \"total_ms\": 100}, \"state_patch\": [{\"op\": \"replace\", \"path\": \"/status\", \"value\": \"stopped\"}]}}, \"deps\": {\"schemes\": [{\"scheme\": \"time:monotonic\", \"access\": \"event_subscribe\", \"lifecycle\": \"demand_per_action\"}, {\"scheme\": \"audio:wyoming/tts\", \"access\": \"write\", \"lifecycle\": \"demand_per_action\"}], \"wasm_components\": [], \"sub_services\": []}, \"capabilities\": [{\"cap_id\": \"cap_water_sched\", \"capability\": \"timer.monotonic.schedule\", \"scope\": {\"wake_from_suspend\": false}, \"lifetime\": \"until_deadline\", \"max_duration_sec\": 86400, \"revocable\": true, \"audit_reason\": \"Arm one monotonic interval timer per reminder.\"}, {\"cap_id\": \"cap_water_tts\", \"capability\": \"audio.playback.tts\", \"scope\": {\"channel\": \"notification\"}, \"lifetime\": \"per_invocation\", \"max_duration_sec\": 5, \"revocable\": true, \"audit_reason\": \"Deliver one reminder notice per 90-second interval.\"}], \"state_schema\": {\"namespace\": \"state:svc.demo.water_reminder\", \"durability\": \"ephemeral_session\", \"wal_limit_bytes\": 65536, \"retention_ttl_sec\": 86400, \"schema\": {\"type\": \"object\", \"required\": [\"status\", \"every_sec\", \"reminders_sent\"], \"properties\": {\"status\": {\"type\": \"string\", \"enum\": [\"armed\", \"stopped\"]}, \"every_sec\": {\"type\": \"integer\", \"minimum\": 90}, \"reminders_sent\": {\"type\": \"integer\", \"minimum\": 0}}}, \"initial_state\": {\"status\": \"armed\", \"every_sec\": 90, \"reminders_sent\": 0}, \"migrations\": []}, \"ui\": {\"mode\": \"none\"}, \"power_budget\": {\"cpu_cluster_preference\": \"silver_only\", \"max_cpu_cores\": 1, \"cpu_quota_pct\": 1, \"memory_limit_mb\": 2, \"wasm_fuel_per_invocation\": 1000, \"max_wakeups_per_minute\": 1, \"max_wakelock_sec\": 0, \"network_egress_bytes_max\": 0, \"allowed_hosts\": [], \"allowed_ip_name_lookups\": [], \"allowed_host_loopback_ports\": [], \"auto_stop_idle_ms\": 0, \"power_announcement\": \"Water Reminder: one notice every 90 seconds, silver cluster only, zero network bytes.\"}, \"tests\": [{\"name\": \"two_intervals_send_two_reminders\", \"description\": \"The interval fires once per 90 seconds and the counter tracks it.\", \"initial_env\": {\"monotonic_ms\": 0, \"wall_iso\": \"2026-11-02T12:00:00Z\", \"battery_pct\": 80.0, \"charging\": false, \"network_online\": false, \"location\": {\"lat\": 45.5152, \"lon\": -122.6784, \"tz\": \"America/Los_Angeles\"}}, \"events\": [{\"at_monotonic_ms\": 90000, \"event_type\": \"advance_clock\", \"payload\": {}}, {\"at_monotonic_ms\": 180000, \"event_type\": \"advance_clock\", \"payload\": {}}], \"assertions\": {\"final_state_subset\": {\"reminders_sent\": 2, \"status\": \"armed\", \"every_sec\": 90}, \"expected_bus_emissions\": [], \"expected_ui_surfaces\": [], \"budget_assertions\": {\"max_memory_mb_used\": 2.0, \"network_bytes_sent\": 0, \"active_schemes_after_completion\": []}}}, {\"name\": \"stop_marks_state_and_stops_firing\", \"description\": \"A stop signal runs the lifecycle_stop trigger and no reminder follows.\", \"initial_env\": {\"monotonic_ms\": 0, \"wall_iso\": \"2026-11-02T12:00:00Z\", \"battery_pct\": 80.0, \"charging\": false, \"network_online\": false, \"location\": {\"lat\": 45.5152, \"lon\": -122.6784, \"tz\": \"America/Los_Angeles\"}}, \"events\": [{\"at_monotonic_ms\": 90000, \"event_type\": \"advance_clock\", \"payload\": {}}, {\"at_monotonic_ms\": 100000, \"event_type\": \"stop_signal\", 