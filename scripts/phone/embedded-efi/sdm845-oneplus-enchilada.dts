	timer {
		compatible = "arm,armv8-timer";
		interrupts = <0x01 0x01 0x08 0x01 0x02 0x08 0x01 0x03 0x08 0x01 0x00 0x08>;
	};

	alert-slider {
		compatible = "gpio-keys";
		label = "Alert slider";
		pinctrl-0 = <0x10f>;
		pinctrl-names = "default";

		switch-top {
			label = "Silent";
			linux,input-type = <0x03>;
			linux,code = <0x22>;
			linux,input-value = <0x00>;
			gpios = <0x4a 0x7e 0x01>;
			linux,can-disable;
		};

		switch-middle {
			label = "Vibrate";
			linux,input-type = <0x03>;
			linux,code = <0x22>;
			linux,input-value = <0x01>;
			gpios = <0x4a 0x34 0x01>;
			linux,can-disable;
		};

		switch-bottom {
			label = "Ring";
			linux,input-type = <0x03>;
			linux,code = <0x22>;
			linux,input-value = <0x02>;
			gpios = <0x4a 0x18 0x01>;
			linux,can-disable;
		};
	};

	gpio-hall-sensor {
		compatible = "gpio-keys";
		label = "Hall effect sensor";
		pinctrl-0 = <0x110>;
		pinctrl-names = "default";

		event-hall-sensor {
			gpios = <0x4a 0x7c 0x01>;
			label = "Hall Effect Sensor";
			linux,input-type = <0x05>;
			linux,code = <0x00>;
			linux,can-disable;
			wakeup-source;
		};
	};

	gpio-keys {
		compatible = "gpio-keys";
		label = "Volume keys";
		autorepeat;
		pinctrl-names = "default";
		pinctrl-0 = <0x111 0x112>;

		key-vol-down {
			label = "Volume down";
			linux,code = <0x72>;
			gpios = <0xf3 0x05 0x01>;
			debounce-interval = <0x0f>;
		};

		key-vol-up {
			label = "Volume up";
			linux,code = <0x73>;
			gpios = <0xf3 0x06 0x01>;
			debounce-interval = <0x0f>;
		};
	};

	vph-pwr-regulator {
		compatible = "regulator-fixed";
		regulator-name = "vph_pwr";
		regulator-min-microvolt = <0x387520>;
		regulator-max-microvolt = <0x387520>;
		phandle = <0xf8>;
	};

	pm8998-smps4 {
		compatible = "regulator-fixed";
		regulator-name = "vreg_s4a_1p8";
		regulator-min-microvolt = <0x1b7740>;
		regulator-max-microvolt = <0x1b7740>;
		regulator-always-on;
		regulator-boot-on;
		vin-supply = <0xf8>;
		phandle = <0xbf>;
	};

	ts-1p8-regulator {
		compatible = "regulator-fixed";
		regulator-name = "ts_1p8_supply";
		regulator-min-microvolt = <0x1b7740>;
		regulator-max-microvolt = <0x1b7740>;
		gpio = <0x4a 0x58 0x00>;
		enable-active-high;
		phandle = <0x72>;
	};

	panel-vci-3v3-regulator {
		compatible = "regulator-fixed";
		regulator-name = "LCD_VCI_3V";
		regulator-min-microvolt = <0x325aa0>;
		regulator-max-microvolt = <0x325aa0>;
		gpio = <0x4a 0x1a 0x00>;
		enable-active-high;
		pinctrl-0 = <0x113>;
		pinctrl-names = "default";
		regulator-boot-on;
		phandle = <0xe5>;
	};

	panel-vddi-poc-regulator {
		compatible = "regulator-fixed";
		regulator-name = "VDDI_POC";
		regulator-min-microvolt = <0x1b7740>;
		regulator-max-microvolt = <0x1b7740>;
		gpio = <0x4a 0x19 0x00>;
		enable-active-high;
		pinctrl-0 = <0x114>;
		pinctrl-names = "default";
		regulator-boot-on;
		phandle = <0xe6>;
	};

	wcn3990-pmu {
		compatible = "qcom,wcn3990-pmu";
		pinctrl-0 = <0x115>;
		pinctrl-names = "default";
		vddio-supply = <0xbf>;
		vddxo-supply = <0x116>;
		vddrf-supply = <0x117>;
		vddch0-supply = <0x118>;
		vddch1-supply = <0x119>;
		swctrl-gpios = <0xf3 0x03 0x00>;

		regulators {

			ldo0 {
				regulator-name = "vreg_pmu_io";
				phandle = <0x59>;
			};

			ldo1 {
				regulator-name = "vreg_pmu_xo";
				phandle = <0x5a>;
			};

			ldo2 {
				regulator-name = "vreg_pmu_rf";
				phandle = <0x5b>;
			};

			ldo3 {
				regulator-name = "vreg_pmu_ch0";
				phandle = <0x5c>;
			};

			ldo4 {
				regulator-name = "vreg_pmu_ch1";
				phandle = <0x101>;
			};
		};
	};

	battery {
		compatible = "simple-battery";
		charge-full-design-microamp-hours = <0x325aa0>;
		voltage-min-design-microvolt = <0x33e140>;
		voltage-max-design-microvolt = <0x432380>;
		constant-charge-current-max-microamp = <0x1b7740>;
		phandle = <0x69>;
	};

