					hysteresis = <0x7d0>;
					type = "hot";
					phandle = <0x23d>;
				};
			};
		};

		modem-thermal {
			polling-delay-passive = <0xfa>;
			thermal-sensors = <0x10d 0x07>;

			trips {

				trip-point0 {
					temperature = <0x15f90>;
					hysteresis = <0x7d0>;
					type = "hot";
					phandle = <0x23e>;
				};
			};
		};

		pm8998-thermal {
			polling-delay-passive = <0xfa>;
			thermal-sensors = <0x10e>;

			trips {

				pm8998-alert0 {
					temperature = <0x19a28>;
					hysteresis = <0x7d0>;
					type = "passive";
					phandle = <0x23f>;
				};

				pm8998-crit {
					temperature = <0x1e848>;
					hysteresis = <0x7d0>;
					type = "critical";
					phandle = <0x240>;
				};
			};
		};
